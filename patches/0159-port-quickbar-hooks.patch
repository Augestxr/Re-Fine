+extern volatile long g_port_overlay_touchpad;
+/* Nonzero: no vibration is sent to the controllers. */
+extern volatile long g_port_rumble_off;
+/* The controller on port 0 ("" without one), for the port's menu. */
+extern char g_port_pad_name[128];
+/* Output gain, 0-1, applied by cellAudio to what it hands to WASAPI. */
+extern volatile float g_port_master_volume;
+
 #ifdef __cplusplus
 }
 #endif
