 }
 
+volatile float g_port_master_volume = 1.0f;   /* Re:Fine 0159 (port_overlay.h) */
+
 static void audio_device_write(AudioDevice* d, const float* stereo_samples, u32 num_samples)
 {
     BYTE* buf = NULL;
     HRESULT hr = d->render->lpVtbl->GetBuffer(d->render, num_samples, &buf);
     if (SUCCEEDED(hr) && buf) {
-        memcpy(buf, stereo_samples, num_samples * 2 * sizeof(float));
+        const float gain = g_port_master_volume;
+        if (gain >= 0.9999f) {
+            memcpy(buf, stereo_samples, num_samples * 2 * sizeof(float));
+        } else {   /* Re:Fine 0159: the menu's Master volume, on the host side only */
+            float* o = (float*)buf;
+            for (u32 i = 0; i < num_samples * 2; i++) o[i] = stereo_samples[i] * gain;
+        }
         d->render->lpVtbl->ReleaseBuffer(d->render, num_samples,
                                          audio_muted() ? AUDCLNT_BUFFERFLAGS_SILENT : 0);
     }
