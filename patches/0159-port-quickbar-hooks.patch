diff --git a/libs/video/port_overlay.h b/libs/video/port_overlay.h
index a791ebb4..b34c222b 100644
--- a/libs/video/port_overlay.h
+++ b/libs/video/port_overlay.h
@@ -33,6 +33,21 @@ extern int (*g_port_overlay_wndproc)(void* hwnd, unsigned msg, uint64_t wp, int6
 extern volatile long g_port_overlay_gate;
 extern int (*g_port_overlay_pad)(unsigned port, uint16_t mask, uint8_t lx, uint8_t ly);
 
+/* Re:Fine 0159. Once, on the thread that makes the swap chain, right after: the device. */
+extern void (*g_port_overlay_device_ready)(void* device, uint32_t rtv_format, uint32_t frame_count);
+/* Re:Fine 0159. Guest thread, every cellPadGetData, before the gate: the pad as read. */
+extern void (*g_port_overlay_watch)(unsigned port, uint16_t mask);
+/* Buttons (mask as above) pressed for the title on port 0 while set, through the gate. */
+extern volatile long g_port_overlay_inject;
