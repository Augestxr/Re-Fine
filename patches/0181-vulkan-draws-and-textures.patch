+/* A device-local image with one view, left in GENERAL by the caller's first barrier. */
+static int vk_image(VkSurf* s, u32 pw, u32 ph, VkFormat f, int depth)
+{
+    VkImageCreateInfo ii = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    ii.imageType = VK_IMAGE_TYPE_2D;
+    ii.format = f;
+    ii.extent.width = pw; ii.extent.height = ph; ii.extent.depth = 1;
+    ii.mipLevels = 1; ii.arrayLayers = 1;
+    ii.samples = VK_SAMPLE_COUNT_1_BIT;
+    ii.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ii.usage = depth ? (VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT)
+                     : (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                        VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
+    ii.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ii.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkResult r = vkCreateImage_(s_vk.dev, &ii, NULL, &s->img);
+    if (r != VK_SUCCESS) return vk_fail("vkCreateImage", r);
+    VkMemoryRequirements req;
+    vkGetImageMemoryRequirements_(s_vk.dev, s->img, &req);
+    VkMemoryAllocateInfo ma = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    ma.allocationSize = req.size;
+    ma.memoryTypeIndex = vk_mem_type(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (ma.memoryTypeIndex == UINT32_MAX) return vk_fail("no device-local memory", VK_ERROR_OUT_OF_DEVICE_MEMORY);
+    if ((r = vkAllocateMemory_(s_vk.dev, &ma, NULL, &s->mem)) != VK_SUCCESS) return vk_fail("vkAllocateMemory (image)", r);
+    vkBindImageMemory_(s_vk.dev, s->img, s->mem, 0);
+    VkImageViewCreateInfo vi = { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    vi.image = s->img;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = f;
+    vi.subresourceRange.aspectMask = depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT) : VK_IMAGE_ASPECT_COLOR_BIT;
+    vi.subresourceRange.levelCount = 1;
+    vi.subresourceRange.layerCount = 1;
+    if ((r = vkCreateImageView_(s_vk.dev, &vi, NULL, &s->view)) != VK_SUCCESS) return vk_fail("vkCreateImageView", r);
+    s->pw = pw; s->ph = ph; s->vf = f; s->depth = depth; s->cleared = 0;
