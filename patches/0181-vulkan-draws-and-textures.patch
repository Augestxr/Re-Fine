+static u64 vk_hash_bytes(const u8* p, u32 n)
+{
+    u64 a = 0x9E3779B97F4A7C15ull, b = 0xC2B2AE3D27D4EB4Full;
+    u32 i = 0;
+    for (; i + 16 <= n; i += 16) { u64 x, y; memcpy(&x, p + i, 8); memcpy(&y, p + i + 8, 8);
+        a = (a ^ x) * 0x100000001B3ull; b = (b ^ y) * 0x100000001B3ull; a ^= a >> 29; b ^= b >> 31; }
+    for (; i < n; i++) a = (a ^ p[i]) * 0x100000001B3ull;
+    return a ^ (b * 0xFF51AFD7ED558CCDull) ^ n;
