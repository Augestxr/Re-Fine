+/* Re:Fine 0172: one short vibration asked by the port (port_overlay.h), sent by the SDL thread to port 0.
+ * Packed in one 64-bit word with a sequence number, so a pulse is never read half written. */
+static volatile long long s_pulse;   /* seq << 48 | ms << 32 | hi << 16 | lo */
+void pad_pulse(unsigned short lo, unsigned short hi, int ms)
+{
+    if (ms <= 0 || (!lo && !hi)) return;
+    if (ms > 2000) ms = 2000;
+    for (;;) {
+        long long old = s_pulse;
+        const long long seq = ((old >> 48) + 1) & 0xFFFF;
+        const long long v = seq << 48 | (long long)ms << 32 | (long long)hi << 16 | lo;
+        if (__atomic_compare_exchange_n(&s_pulse, &old, v, 0, __ATOMIC_RELEASE, __ATOMIC_RELAXED)) return;
+    }
+}
+
