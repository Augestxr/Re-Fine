+/* Re:Fine 0172: the port's menu picks the output live (port_overlay.h). Until it does, REFINE_AUDIO_DEVICE. */
+static SRWLOCK s_want_lock = SRWLOCK_INIT;
+static char s_want[256];
+static int s_want_set;
+void port_audio_set_device(const char* want)
+{
+    AcquireSRWLockExclusive(&s_want_lock);
+    snprintf(s_want, sizeof s_want, "%s", want ? want : "auto");
+    s_want_set = 1;
+    ReleaseSRWLockExclusive(&s_want_lock);
+    fprintf(stderr, "[audio-dev] output asked: '%s'%c", s_want, 10);
+    audio_dev_poke(AUDIO_WHY_STATE);
+}
+int port_audio_outputs(char* names, int stride, int max)
+{
+    const HRESULT co = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    IMMDeviceEnumerator* en = NULL; IMMDeviceCollection* all = NULL; UINT n = 0;
+    if (SUCCEEDED(CoCreateInstance(&CLSID_MMDeviceEnumerator, NULL, CLSCTX_ALL, &IID_IMMDeviceEnumerator, (void**)&en))) {
+        if (SUCCEEDED(en->lpVtbl->EnumAudioEndpoints(en, eRender, DEVICE_STATE_ACTIVE, &all))) {
+            all->lpVtbl->GetCount(all, &n);
+            for (UINT i = 0; i < n && (int)i < max; i++) {
+                IMMDevice* d = NULL;
+                names[i * stride] = 0;
+                if (FAILED(all->lpVtbl->Item(all, i, &d))) continue;
+                char name[96];
+                audio_device_name(d, name, sizeof name);
+                snprintf(names + i * stride, (size_t)stride, "%s", name);
+                d->lpVtbl->Release(d);
+            }
+            all->lpVtbl->Release(all);
+        }
+        en->lpVtbl->Release(en);
+    }
+    if (SUCCEEDED(co)) CoUninitialize();
+    return (int)n;
+}
