+/* sys_lwcond_wait/signal/signal_all/signal_to with real lv2 semantics
+ * (f2nd-recomp patches/0004). The previous body was a poll -- release the lwmutex,
+ * Sleep(1), reacquire, return CELL_OK -- with no-op signals, which made every wait
+ * a spurious wakeup after ~1 ms. That only works for a guest that re-checks a
+ * predicate in a loop. BLES02029's PvOsageManager workers (0x416C54) do not: they
+ * wait once with no predicate and treat the wakeup as "work is ready"; under the
+ * poll all four woke with no work, indexed an empty vector and aborted. In RPCS3
+ * the same four threads block in _sys_lwcond_queue_wait(timeout=0) until shutdown.
+ *
+ * Semantics follow RPCS3's sys_lwcond_ module: wait requires the caller to own the
+ * paired lwmutex (else CELL_EPERM), saves its recursion count, releases it, blocks
+ * until signalled or until the timeout (usec, 0 = infinite), reacquires it and
+ * restores the count; a timeout still reacquires and returns CELL_ETIMEDOUT.
+ * signal/signal_all with nobody waiting return CELL_OK; signal_to a thread that is
+ * not waiting returns CELL_EPERM. Waiters wake in FIFO order (lv2 orders by the
+ * lwmutex protocol; FIFO is the SYS_SYNC_FIFO case). A waiter registers while it
+ * still holds the lwmutex, so a signaller that holds it cannot lose the wakeup. */
+struct LwcondWaiter {
+    uint32_t tid;
+    bool     signalled;
+    std::condition_variable cv;
+};
+static std::mutex s_lwc_lock;
+/* PS3_LWCOND_TRACE=1: log every wait (enter/leave) and signal with thread, lwcond
+ * and caller, to find a waiter nobody signals. */
+static int lwc_trace(void)
+{
+    static int s = -1;
+    if (s < 0) { const char* e = getenv("PS3_LWCOND_TRACE"); s = (e && *e && *e != '0') ? 1 : 0; }
+    return s;
+}
+static std::unordered_map<uint32_t, std::deque<LwcondWaiter*>> s_lwc_waiters;   /* key: lwcond EA */
+
+static void sys_lwcond_destroy(ppu_context* ctx)
+{
+    uint32_t lwcond = (uint32_t)ctx->gpr[3];
+    std::lock_guard<std::mutex> g(s_lwc_lock);
+    auto it = s_lwc_waiters.find(lwcond);
+    if (it != s_lwc_waiters.end() && !it->second.empty()) {
+        ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x8001000Au;   /* CELL_EBUSY */
+        return;
+    }
+    if (it != s_lwc_waiters.end()) s_lwc_waiters.erase(it);
+    ctx->gpr[3] = 0;
+}
+
+/* Wake one waiter (tid == 0: the first in line; otherwise that thread) or all.
+ * Returns how many were woken. Caller holds s_lwc_lock. */
+static int lwcond_wake_locked(uint32_t lwcond, uint32_t tid, bool all)
+{
+    auto it = s_lwc_waiters.find(lwcond);
+    if (it == s_lwc_waiters.end()) return 0;
+    auto& q = it->second;
+    int n = 0;
+    for (auto w = q.begin(); w != q.end();) {
+        if (all || !tid || (*w)->tid == tid) {
+            (*w)->signalled = true;
+            (*w)->cv.notify_one();
+            w = q.erase(w);
+            n++;
+            if (!all) break;
+        } else {
+            ++w;
+        }
+    }
+    return n;
+}
+
+static void sys_lwcond_signal(ppu_context* ctx)
+{
+    std::lock_guard<std::mutex> g(s_lwc_lock);
+    int n = lwcond_wake_locked((uint32_t)ctx->gpr[3], 0, false);
+    if (lwc_trace()) fprintf(stderr, "[LWC] signal     tid=%u lwcond=0x%08X woke=%d lr=0x%08X\n",
+                             LWM_SELF(ctx), (uint32_t)ctx->gpr[3], n, (uint32_t)ctx->lr);
+    ctx->gpr[3] = 0;
+}
+static void sys_lwcond_signal_all(ppu_context* ctx)
+{
+    std::lock_guard<std::mutex> g(s_lwc_lock);
+    int n = lwcond_wake_locked((uint32_t)ctx->gpr[3], 0, true);
+    if (lwc_trace()) fprintf(stderr, "[LWC] signal_all tid=%u lwcond=0x%08X woke=%d lr=0x%08X\n",
+                             LWM_SELF(ctx), (uint32_t)ctx->gpr[3], n, (uint32_t)ctx->lr);
+    ctx->gpr[3] = 0;
+}
+static void sys_lwcond_signal_to(ppu_context* ctx)
+{
+    uint32_t tid = (uint32_t)ctx->gpr[4];
+    std::lock_guard<std::mutex> g(s_lwc_lock);
+    int n = (tid == 0xFFFFFFFFu) ? lwcond_wake_locked((uint32_t)ctx->gpr[3], 0, false)
+                                 : lwcond_wake_locked((uint32_t)ctx->gpr[3], tid, false);
+    ctx->gpr[3] = (n || tid == 0xFFFFFFFFu) ? 0 : (uint64_t)(int64_t)(int32_t)0x80010009u;   /* CELL_EPERM */
+}
