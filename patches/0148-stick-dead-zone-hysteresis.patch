+/* A stick leaves the centre past stick_deadzone + stick_hysteresis and comes back under
+ * stick_deadzone; inside, it reads as centred. On release a stick swings past the
+ * centre (0.39 at worst for 25 ms on an Xbox Series pad, docs/STATUS.md 5d.3), and F
+ * would take that as another flick. A pad that reports slowly can jump to that side
+ * without a sample near the centre, so turning back past it counts as coming back.
+ * Outside, the value goes through as it is, so a soft flick reaches F as strong as it
+ * was. The radius is taken 500 times a second, finer than F's 30 reads a second. */
+static float s_stick_dz = -1.0f, s_stick_hy;
+typedef struct { int out, x, y; } PadStick;
+
+static void pad_sdl3_stick(PadStick* st, int x, int y, u8* ox, u8* oy)
+{
+    const float r = SDL_sqrtf((float)x * x + (float)y * y) / 32767.0f;
+    if (st->out && (r < s_stick_dz || (long long)x * st->x + (long long)y * st->y < 0)) st->out = 0;
+    else if (!st->out && r >= s_stick_dz + s_stick_hy) { st->out = 1; st->x = x; st->y = y; }
+    *ox = st->out ? pad_sdl3_axis(x) : 128;
+    *oy = st->out ? pad_sdl3_axis(y) : 128;
+}
