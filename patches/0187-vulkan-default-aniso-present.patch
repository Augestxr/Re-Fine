+    "    O o;\n"
+    "    o.uv = float2((id << 1) & 2, id & 2);\n"
+    "    o.p = float4(o.uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+    "    return o;\n"
+    "}\n";
+static const char s_blit_ps[] =
+    "Texture2D<float4> t : register(t0);\n"
+    "SamplerState s : register(s0);\n"
+    "cbuffer K : register(b0) { float2 px; float sharp; float area; };\n"
+    "float3 S(float2 uv) {\n"
+    "    if (area <= 1.0) return t.SampleLevel(s, uv, 0).rgb;\n"
+    "    int n = (int)min(ceil(area), 4.0);\n"
+    "    float3 a = 0;\n"
+    "    for (int j = 0; j < n; j++) for (int i = 0; i < n; i++)\n"
+    "        a += t.SampleLevel(s, uv + (float2(i, j) + 0.5) / n * px - 0.5 * px, 0).rgb;\n"
+    "    return a / (n * n);\n"
+    "}\n"
+    "float4 main(float4 p : SV_Position, float2 uv : TEXCOORD0) : SV_Target {\n"
+    "    float3 e = S(uv);\n"
+    "    if (sharp <= 0.0) return float4(e, 1.0);\n"
+    "    /* Contrast-adaptive sharpen after AMD FidelityFX CAS (MIT), own implementation. */\n"
+    "    float3 b = S(uv + float2(0, -px.y)), d = S(uv + float2(-px.x, 0));\n"
+    "    float3 f = S(uv + float2(px.x, 0)),  h = S(uv + float2(0, px.y));\n"
+    "    float3 mn = min(min(min(d, e), min(f, b)), h), mx = max(max(max(d, e), max(f, b)), h);\n"
+    "    float3 amp = sqrt(saturate(min(mn, 1.0 - mx) / max(mx, 1e-4)));\n"
+    "    float3 w = amp * (-1.0 / lerp(8.0, 5.0, sharp));\n"
+    "    return float4(saturate((w * (b + d + f + h) + e) / (1.0 + 4.0 * w)), 1.0);\n"
+    "}\n";
+
+static int vk_present_shader(VkCommandBuffer c, uint32_t f, uint32_t ii)
+{
+    float sh = g_port_sharpen; if (sh < 0.0f) sh = 0.0f; if (sh > 1.0f) sh = 1.0f;
+    const float area = (g_port_area && s_vk.display.pw > s_vk.extent.width) ? (float)s_vk.display.pw / (float)s_vk.extent.width : 0.0f;
+    if (sh <= 0.0f && area <= 1.0f) return 0;
+    if (!s_vk.view[ii] || !s_vk.display.view || !vk_ui_init()) return 0;
+    static int failed;
+    if (!s_ui.blit && !failed) {
+        int bad = 0;
+        const VkShaderModule vs = vk_module(s_blit_vs, 0, "present vertex", 4, &bad);
+        const VkShaderModule ps = vk_module(s_blit_ps, 1, "present fragment", 5, &bad);
+        s_ui.blit = vs && ps ? vk_ui_pipeline(vs, ps, 1) : VK_NULL_HANDLE;
+        if (!s_ui.blit) { failed = 1; fprintf(stderr, "[vk] the present shader FAILED: sharpening and area resampling are off%c", 10); }
+    }
+    if (!s_ui.blit) return 0;
+    vk_ui_ring(f);
+    const u64 a_cb = (s_ui.used + 255u) & ~255ull;
+    if (a_cb + 256u > VK_UI_RING) return 0;
+    const float k[4] = { 1.0f / (float)s_vk.display.pw, 1.0f / (float)s_vk.display.ph, sh, area };
+    memcpy(s_ui.map[f] + a_cb, k, sizeof k);
+    s_ui.used = a_cb + 256u;
+    VkDescriptorSetAllocateInfo ai = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+    ai.descriptorPool = s_vk.dpool[f]; ai.descriptorSetCount = 1; ai.pSetLayouts = &s_vk.set_layout_u;
+    VkDescriptorSet set;
+    if (vkAllocateDescriptorSets_(s_vk.dev, &ai, &set) != VK_SUCCESS) return 0;
+    VkDescriptorBufferInfo ub = { s_ui.buf[f], a_cb, 16 };
+    VkDescriptorImageInfo im = { VK_NULL_HANDLE, s_vk.display.view, VK_IMAGE_LAYOUT_GENERAL };
+    VkDescriptorImageInfo sm = { s_vk.samp_linear, VK_NULL_HANDLE, VK_IMAGE_LAYOUT_UNDEFINED };
+    VkWriteDescriptorSet w[3];
+    memset(w, 0, sizeof w);
+    for (int i = 0; i < 3; i++) { w[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; w[i].dstSet = set; w[i].descriptorCount = 1; }
+    w[0].dstBinding = 0;  w[0].descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER; w[0].pBufferInfo = &ub;
+    w[1].dstBinding = 16; w[1].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;  w[1].pImageInfo = &im;
+    w[2].dstBinding = 32; w[2].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLER;        w[2].pImageInfo = &sm;
+    vkUpdateDescriptorSets_(s_vk.dev, 3, w, 0, NULL);
+    vk_barrier_img(c, s_vk.img[ii], VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                   0, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT);
+    VkRenderingAttachmentInfo ca = { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO };
+    ca.imageView = s_vk.view[ii];
+    ca.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    ca.loadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE; ca.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    VkRenderingInfo ri = { VK_STRUCTURE_TYPE_RENDERING_INFO };
+    ri.renderArea.extent = s_vk.extent;
+    ri.layerCount = 1; ri.colorAttachmentCount = 1; ri.pColorAttachments = &ca;
+    vkCmdBeginRendering_(c, &ri);
+    vkCmdBindPipeline_(c, VK_PIPELINE_BIND_POINT_GRAPHICS, s_ui.blit);
+    const VkViewport vp = { 0.0f, (float)s_vk.extent.height, (float)s_vk.extent.width, -(float)s_vk.extent.height, 0.0f, 1.0f };
+    const VkRect2D sc = { { 0, 0 }, s_vk.extent };
+    vkCmdSetViewport_(c, 0, 1, &vp);
+    vkCmdSetScissor_(c, 0, 1, &sc);
+    vkCmdBindDescriptorSets_(c, VK_PIPELINE_BIND_POINT_GRAPHICS, s_vk.pipe_layout_u, 0, 1, &set, 0, NULL);
+    vkCmdDraw_(c, 3, 1, 0, 0);
+    vkCmdEndRendering_(c);
+    return 1;
+}
