diff --git a/libs/video/rsx_vk_spirv.cpp b/libs/video/rsx_vk_spirv.cpp
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_vk_spirv.cpp
@@ -0,0 +1,83 @@
+/*
+ * Re:Fine N1 V2a (docs/plan_nativo.md): HLSL -> SPIR-V in process, for the Vulkan backend (rsx_vk_win.c).
+ *
+ * The decompilers write the same HLSL for every backend; D3D12 compiles it with D3DCompile (FXC, shader model 5),
+ * Vulkan with DXC to SPIR-V. dxcompiler.dll (tools/fetch_vulkan.ps1, copied next to the exe) is loaded at run time:
+ * without it the Vulkan backend reports it and draws nothing, nothing else fails.
+ *
+ * The options, from compiling every program of a run of F (36, 10 vertex and 26 fragment, SHADER_DUMP):
+ *   -HV 2018                 the decompilers' vector ?: (FXC's per-component select); HLSL 2021 rejects all 36
+ *   -fvk-use-dx-layout       cbuffers laid out as D3D12 packs them, so the constant blocks are the same bytes
+ *   -fvk-b/t/s-shift         b0/b1 -> bindings 0/1, t0..t15 -> 16..31, s0..s15 -> 32..47 (one descriptor set)
+ * The binding numbers are this file's contract with rsx_vk_win.c (RSX_VK_BIND_*).
+ */
+#if defined(_WIN32) && defined(REFINE_VULKAN)
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <unknwn.h>   /* IUnknown: WIN32_LEAN_AND_MEAN leaves the COM headers out */
+#include "dxcapi.h"
+
+static DxcCreateInstanceProc s_create;
+static IDxcCompiler3* s_compiler;
+static IDxcUtils* s_utils;
+static int s_state;   /* 0 not tried, 1 ready, -1 unavailable */
+
+static int spirv_init(void)
+{
+    if (s_state) return s_state;
+    s_state = -1;
+    HMODULE m = LoadLibraryA("dxcompiler.dll");
+    if (!m) { fprintf(stderr, "[vk] dxcompiler.dll not found next to the exe: no SPIR-V (tools/fetch_vulkan.ps1)\n"); return -1; }
+    s_create = (DxcCreateInstanceProc)(void*)GetProcAddress(m, "DxcCreateInstance");
+    if (!s_create || FAILED(s_create(CLSID_DxcCompiler, __uuidof(IDxcCompiler3), (void**)&s_compiler)) ||
+        FAILED(s_create(CLSID_DxcUtils, __uuidof(IDxcUtils), (void**)&s_utils))) {
+        fprintf(stderr, "[vk] dxcompiler.dll did not start: no SPIR-V\n");
+        return -1;
+    }
+    s_state = 1;
+    return 1;
+}
+
+/* stage 0 vertex, 1 fragment. 0 and the SPIR-V in *out (malloc'd), or -1 and the compiler's first lines in err. */
+extern "C" int rsx_vk_spirv(const char* hlsl, size_t len, int stage, void** out, size_t* out_len, char* err, size_t err_cap)
+{
+    *out = NULL; *out_len = 0;
+    if (err_cap) err[0] = 0;
+    if (spirv_init() < 0) { if (err_cap) snprintf(err, err_cap, "no dxcompiler.dll"); return -1; }
+    const wchar_t* args[] = {
+        L"-E", L"main", L"-T", stage ? L"ps_6_0" : L"vs_6_0", L"-HV", L"2018",
+        L"-spirv", L"-fspv-target-env=vulkan1.2", L"-fvk-use-dx-layout",
+        L"-fvk-b-shift", L"0", L"0", L"-fvk-t-shift", L"16", L"0", L"-fvk-s-shift", L"32", L"0",
+        L"-O3",
+    };
+    DxcBuffer src = { hlsl, len, DXC_CP_UTF8 };
+    IDxcResult* res = NULL;
+    HRESULT hr = s_compiler->Compile(&src, args, (UINT32)(sizeof args / sizeof args[0]), NULL, __uuidof(IDxcResult), (void**)&res);
+    if (FAILED(hr) || !res) { if (err_cap) snprintf(err, err_cap, "Compile hr 0x%08lX", (unsigned long)hr); return -1; }
+    HRESULT status = E_FAIL;
+    res->GetStatus(&status);
+    int rc = -1;
+    if (SUCCEEDED(status)) {
+        IDxcBlob* code = NULL;
+        if (SUCCEEDED(res->GetOutput(DXC_OUT_OBJECT, __uuidof(IDxcBlob), (void**)&code, NULL)) && code) {
+            const size_t n = code->GetBufferSize();
+            void* p = malloc(n ? n : 1);
+            if (p) { memcpy(p, code->GetBufferPointer(), n); *out = p; *out_len = n; rc = 0; }
+            code->Release();
+        }
+    } else if (err_cap) {
+        IDxcBlobUtf8* e = NULL;
+        if (SUCCEEDED(res->GetOutput(DXC_OUT_ERRORS, __uuidof(IDxcBlobUtf8), (void**)&e, NULL)) && e && e->GetStringLength()) {
+            snprintf(err, err_cap, "%.*s", (int)e->GetStringLength(), e->GetStringPointer());
+            e->Release();
+        } else snprintf(err, err_cap, "failed, no message");
+    }
+    res->Release();
+    return rc;
+}
+
+#endif /* _WIN32 && REFINE_VULKAN */
