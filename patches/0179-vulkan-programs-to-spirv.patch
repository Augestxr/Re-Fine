+int rsx_vk_spirv(const char* hlsl, size_t len, int stage, void** out, size_t* out_len, char* err, size_t err_cap);
+extern uint8_t* vm_base;
+extern u32 cellGcmResolveLocated(int local, u32 offset);
+
+#define VK_PROG_MAX 4096
+typedef struct { u64 key; int stage, ok; void* spv; size_t n; } VkProg;
+static VkProg s_prog[VK_PROG_MAX];
+static u32 s_nprog;
+static const rsx_state* s_st;                  /* the state the last setter was handed */
+static u32 s_cube_mask;                        /* units bound to a cube texture (SET_TEXTURE_FORMAT bit 2) */
+static struct { u32 vs_ok, vs_bad, fs_ok, fs_bad, full; double ms; } s_sh;
+
+static u64 vk_fnv(const void* p, size_t n, u64 h)
+{
+    const u8* b = (const u8*)p;
+    for (size_t i = 0; i < n; i++) { h ^= b[i]; h *= 0x100000001B3ull; }
+    return h;
+}
+
+static VkProg* vk_prog_find(u64 key, int stage)
+{
+    for (u32 i = 0; i < s_nprog; i++) if (s_prog[i].key == key && s_prog[i].stage == stage) return &s_prog[i];
+    return NULL;
+}
+
+static double vk_now_ms(void)
+{
+    LARGE_INTEGER c, f; QueryPerformanceCounter(&c); QueryPerformanceFrequency(&f);
+    return (double)c.QuadPart * 1000.0 / (double)f.QuadPart;
+}
+
+/* hlsl to SPIR-V into a new entry; a failure is kept too, so it is tried once. */
+static VkProg* vk_prog_add(u64 key, int stage, const char* hlsl)
+{
+    if (s_nprog >= VK_PROG_MAX) { s_sh.full++; return NULL; }
+    VkProg* p = &s_prog[s_nprog++];
+    p->key = key; p->stage = stage;
+    char err[1024];
+    const double t0 = vk_now_ms();
+    p->ok = rsx_vk_spirv(hlsl, strlen(hlsl), stage, &p->spv, &p->n, err, sizeof err) == 0;
+    s_sh.ms += vk_now_ms() - t0;
+    if (p->ok) { if (stage) s_sh.fs_ok++; else s_sh.vs_ok++; return p; }
+    if (stage) s_sh.fs_bad++; else s_sh.vs_bad++;
+    {   static int told;
+        if (told++ < 8) {
+            char* nl = strchr(err, 10); if (nl) *nl = 0;
+            fprintf(stderr, "[vk] %s program %016llX: no SPIR-V: %s%c", stage ? "fragment" : "vertex", (unsigned long long)key, err, 10);
+        }
+        const char* dir = getenv("REFINE_VK_SHADER_DUMP");   /* the HLSL that failed, to look at it */
+        if (dir) {
+            char path[512]; snprintf(path, sizeof path, "%s/%s_%016llX.hlsl", dir, stage ? "fs" : "vs", (unsigned long long)key);
+            FILE* f = fopen(path, "wb"); if (f) { fwrite(hlsl, 1, strlen(hlsl), f); fclose(f); }
+        }
+    }
+    return p;
+}
+
+/* The draw's vertex program, as vp_get_vs (D3D12) reads it: from SET_TRANSFORM_PROGRAM_START, to its end bit. */
+static void vk_draw_vs(const rsx_state* st)
+{
+    if (!st || st->vp_ucode_bytes < 16) return;
+    u32 vstart = st->transform_program_start * 16u;
+    if (vstart >= st->vp_ucode_bytes) vstart = 0;
+    const u8* uc = st->vp_ucode + vstart;
+    u32 len = st->vp_ucode_bytes - vstart;
+    const u32 instrs = rsx_vp_program_size_instrs(uc, len);
+    if (instrs) len = instrs * 16u;
+    const u64 key = vk_fnv(uc, len, 0xCBF29CE484222325ull);
+    if (vk_prog_find(key, 0)) return;
+    static char hlsl[262144];
+    if (rsx_vp_decompile(uc, len, hlsl, sizeof hlsl) <= 0) { vk_prog_add(key, 0, "/* decompile failed */"); return; }
+    vk_prog_add(key, 0, hlsl);
+}
+
+/* The draw's fragment program, as vp_get_fp_pso (D3D12) builds it: the buffered form (constants in b1), the
+ * SET_SHADER_CONTROL export bits, the cube units, the alpha test. */
+static void vk_draw_fs(const rsx_state* st)
+{
+    if (!st || !st->shader_program || !vm_base) return;
+    const u32 fa = st->shader_program;
+    const u32 off = cellGcmResolveLocated((fa & 3u) == 1, fa & ~3u);
+    if (off == 0xFFFFFFFFu) return;
+    const u32 ctrl = st->shader_control & (CELL_GCM_SHADER_CONTROL_32_BITS_EXPORTS | CELL_GCM_SHADER_CONTROL_DEPTH_EXPORT);
+    const u32 f = 0x200u | (st->alpha_func & 0xFFu);
+    const u32 afunc = st->alpha_test_enable && f != 0x207u ? f : 0;
+    const u32 code = rsx_fp_code_hash(vm_base + off, 4096);
+    u64 key = 0xCBF29CE484222325ull;
+    key = vk_fnv(&code, 4, key); key = vk_fnv(&ctrl, 4, key); key = vk_fnv(&s_cube_mask, 4, key); key = vk_fnv(&afunc, 4, key);
+    if (vk_prog_find(key, 1)) return;
+    static char hlsl[RSX_FP_HLSL_BUFFER_SIZE];
+    u32 nk = 0;
+    int n = rsx_fp_decompile_buffered_ex(vm_base + off, 4096, ctrl, s_cube_mask, hlsl, sizeof hlsl, &nk);
+    if (n > 0 && afunc && rsx_fp_apply_alpha_test_buffered(hlsl, sizeof hlsl, afunc) < 0) n = -3;
+    if (n <= 0) { vk_prog_add(key, 1, "/* decompile failed */ float4 main() : SV_Target { return x; }"); return; }
+    vk_prog_add(key, 1, hlsl);
+}
+
