diff --git a/libs/video/port_overlay.h b/libs/video/port_overlay.h
new file mode 100644
index 00000000..a791ebb4
--- /dev/null
+++ b/libs/video/port_overlay.h
@@ -0,0 +1,40 @@
+/* Re:Fine 0158: hooks for a port's own overlay (its settings menu), drawn on the swap chain
+ * after the scaled present, at the window's size. The runtime only calls them; the port
+ * sets them. While g_port_overlay_active is 0 the draw hook is not called at all, so a
+ * closed overlay costs one load per presented frame. */
+#ifndef PORT_OVERLAY_H
+#define PORT_OVERLAY_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    void*    device;        /* ID3D12Device* */
+    void*    cmd_list;      /* ID3D12GraphicsCommandList*, recording, swap buffer bound as RT */
+    uint64_t rtv;           /* D3D12_CPU_DESCRIPTOR_HANDLE.ptr of that swap buffer */
+    uint32_t width, height; /* the swap chain: the window's client area */
+    uint32_t frame_index;   /* 0..frame_count-1; per-frame resources of this index are free */
+    uint32_t frame_count;
+    uint32_t rtv_format;    /* DXGI_FORMAT of the swap buffer */
+} port_overlay_frame;
+
+/* Render thread (frame_clock), inside present_blit, only while g_port_overlay_active. */
+extern volatile long g_port_overlay_active;
+extern void (*g_port_overlay_draw)(const port_overlay_frame* f);
+
+/* Window thread: every message before the backend's own handling. Nonzero: consumed. */
+extern int (*g_port_overlay_wndproc)(void* hwnd, unsigned msg, uint64_t wp, int64_t lp);
+
+/* Guest thread, in cellPadGetData after every source has had its say. While the gate is
+ * set and the hook returns nonzero, the title reads a released pad. */
+extern volatile long g_port_overlay_gate;
+extern int (*g_port_overlay_pad)(unsigned port, uint16_t mask, uint8_t lx, uint8_t ly);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
