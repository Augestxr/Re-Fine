     { const LONG wh = InterlockedExchange(&s_d3d.want_wh, 0);
       if (wh) rsx_vk_exec_resize((u32)wh >> 16, (u32)wh & 0xFFFFu); }
     rsx_vk_frame f;
@@ -6687,6 +6714,7 @@ static void render_frame(void)
      * costs little. */
     wait_for_gpu();
     ix_apply();              /* Re:Fine 0175: before anything reads this batch's vertices */
