+static double s_fp_tick;
+static int s_fp_last = -1;
+
+static void fp_init(void)
+{
+    if (s_fp_heap) return;
+    D3D12_QUERY_HEAP_DESC qd = {0};
+    qd.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP; qd.Count = 2 * FRAME_COUNT;
+    s_d3d.device->lpVtbl->CreateQueryHeap(s_d3d.device, &qd, &IID_ID3D12QueryHeap, (void**)&s_fp_heap);
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; rd.Width = 16 * FRAME_COUNT;
+    rd.Height = 1; rd.DepthOrArraySize = 1; rd.MipLevels = 1; rd.SampleDesc.Count = 1;
+    rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+        D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&s_fp_rb);
+    UINT64 hz = 1;
+    s_d3d.cmd_queue->lpVtbl->GetTimestampFrequency(s_d3d.cmd_queue, &hz);
+    s_fp_tick = 1.0 / (double)hz;
+}
+
+static void fp_read_gpu(void)
+{
+    if (s_fp_last < 0) return;
+    D3D12_RANGE r = {(SIZE_T)s_fp_last * 16, (SIZE_T)s_fp_last * 16 + 16};
+    UINT64* p = NULL;
+    if (SUCCEEDED(s_fp_rb->lpVtbl->Map(s_fp_rb, 0, &r, (void**)&p)) && p) {
+        g_frame_prof.gpu += (double)(p[s_fp_last * 2 + 1] - p[s_fp_last * 2]) * s_fp_tick;
+        D3D12_RANGE none = {0, 0};
+        s_fp_rb->lpVtbl->Unmap(s_fp_rb, 0, &none);
+    }
+    s_fp_last = -1;
+}
