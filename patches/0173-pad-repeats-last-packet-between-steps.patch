 void port_audio_set_device(const char* want);
 int port_audio_outputs(char* names, int stride, int max);
+/* Re:Fine 0173. Nonzero for a frame the game's logic does not step (the menus over 30 fps, src/main.cpp):
+ * cellPadGetData hands the game its last packet again, so a press is first seen on a step. */
+extern volatile long g_port_pad_hold;
 
 #ifdef __cplusplus
 }
