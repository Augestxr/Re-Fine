Re:Fine 0103: sys_spu_thread_bind_queue / unbind_queue reales y servicio de los stops
0x110 / 0x111 (receive_event / tryreceive_event) para hilos SPU de grupo lv2.

Origen: JonathanDC64/ps3recomp, commit d9e5559fffe85934ebf8c11d399a49d450e9cdac
("SPURS/SPU: JOBLIST execution, taskset generation race, resumable SPU stop syscalls"),
MIT, Copyright (c) 2026 Ned Heller / sp00nznet; autor del commit Jonathan Del Corpo.
Atribucion en THIRD_PARTY_NOTICES.md.

Solo la parte de SPU que necesita F (el mezclador _synth2):
  - lv2_register.c: tabla spuq por hilo, sys_spu_thread_bind_queue/unbind_queue,
    spu_thread_bound_queue(), registro en lugar de sys_spu_thread_stub, y la
    traza opcional SPU_EVT_TRACE.
  - sys_event.c: sys_event_queue_receive_host() (sin el contador de waiters, que
    esta cola no tiene).
  - spu_channels.c: spu_service_thread_syscall() llamado al principio de spu_stop().
Fuera: todo lo de SPURS (cellSpurs.c, spu_workload.c, group_disconnect_event_all_threads),
diagnosticos de spu_dma.h y de spu_halt, SPU_INTERP_IMG, y los cambios del lifter SPU
(a6d76c8 ya los tiene: upstream 96c878a4, LV2_RESUMING_STOPS).
ae138756 (eventos por el puerto del hilo) no se trae: a6d76c8 ya lo hace
(upstream 0e261947, spu_port_queue_locked).

Regenerated by Re:Fine on ps3recomp v0.18.0 (4e8f3ca). The a6d76c8 version also carried
CR-only line changes (52 lines of spu_channels.c and one of sys_event.c that upstream
stored with CRLF); they are left out, the code change is the same.

diff --git a/runtime/spu/spu_channels.c b/runtime/spu/spu_channels.c
index 5fc50208db5032142701bf39895fffe2cc2a16cf..f59ea651d5cba56c2db0e9fbe83768f7dcab3d79 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -221,8 +221,67 @@ void spu_dbg_e60(spu_context* ctx)
  * host SPU thread (longjmp to spu_run_with_halt) so the job stops AT the stop,
  * with ctx->status + the outbound mailbox value available for the dispatcher to
  * service. Env YDKJ_STOP_NOHALT restores the old (looping) behavior for A/B. */
+/* lv2 SPU-thread syscalls made with `stop` (RPCS3 spu_thread::stop_and_signal).
+ * The lifter continues past these (spu_lifter.py LV2_RESUMING_STOPS) when the
+ * stop returns with the SPU running again.
+ *   0x100 group_yield: nothing to do here.
+ *   0x110 receive_event / 0x111 tryreceive_event: the SPU queue number is in
+ *   the out-mailbox; receive from the queue sys_spu_thread_bind_queue bound
+ *   under it and reply in the in-mailbox -- {CELL_OK, data1, data2, data3}, or
+ *   a single error word. Returns 1 when the stop was serviced.
+ * Adapted from JonathanDC64/ps3recomp d9e5559f (MIT; THIRD_PARTY_NOTICES.md).
+ * The blocking receive waits on the queue's condition variable (100 ms per
+ * round so the SPU's state is re-checked), never spinning. */
+#include "../syscalls/sys_event.h"
+static int spu_service_thread_syscall(spu_context* ctx)
+{
+    extern uint32_t spu_thread_bound_queue(uint32_t, uint32_t);
+    extern int sys_event_queue_receive_host(uint32_t, sys_event_t*, unsigned);
+    const uint32_t code = ctx->stop_code;
+    if (code == 0x100) return 1;
+    if (code != 0x110 && code != 0x111) return 0;
+    if (!ctx->ch_out_mbox.count) return 0;          /* not the lv2 protocol */
+    uint32_t spuq = spu_channel_read(&ctx->ch_out_mbox);
+    uint32_t q = spu_thread_bound_queue(ctx->spu_id, spuq);
+    ctx->rcv_evt_i = 0;
+    if (ctx->rcv_evt_n || ctx->ch_in_mbox.count) {
+        ctx->rcv_evt[0] = 0x8001000A;               /* CELL_EBUSY: in-mailbox not empty */
+        ctx->rcv_evt_n = 1;
+        return 1;
+    }
+    if (!q) {
+        ctx->rcv_evt[0] = 0x80010002;               /* CELL_EINVAL: nothing bound */
+        ctx->rcv_evt_n = 1;
+        return 1;
+    }
+    sys_event_t ev;
+    int r;
+    if (code == 0x111) r = sys_event_queue_receive_host(q, &ev, 0);
+    else while ((r = sys_event_queue_receive_host(q, &ev, 100)) == 0) {}
+    if (r == 1) {
+        ctx->rcv_evt[0] = 0;
+        ctx->rcv_evt[1] = (uint32_t)ev.data1;
+        ctx->rcv_evt[2] = (uint32_t)ev.data2;
+        ctx->rcv_evt[3] = (uint32_t)ev.data3;
+        ctx->rcv_evt_n = 4;
+    } else {
+        ctx->rcv_evt[0] = r == 0 ? 0x8001000A        /* CELL_EBUSY: try, empty */
+                                 : 0x80010013;       /* CELL_ECANCELED: queue gone */
+        ctx->rcv_evt_n = 1;
+    }
+    { static int _n = 0; if (_n++ < 8)
+        fprintf(stderr, "[SPU] tid=0x%X %sreceive_event spuq=0x%X q=%u -> 0x%08X "
+                "(%08X %08X %08X)\n", ctx->spu_id, code == 0x111 ? "try" : "",
+                spuq, q, ctx->rcv_evt[0], ctx->rcv_evt[1], ctx->rcv_evt[2], ctx->rcv_evt[3]); }
+    return 1;
+}
+
