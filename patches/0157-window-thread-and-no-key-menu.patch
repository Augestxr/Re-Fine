      * swap chain follows the window (win_w x win_h, WM_SIZE asks in want_w x want_h). */
     u32  rw, rh;
     float rs;
     u32  win_w, win_h, want_w, want_h;
+    /* Re:Fine 0157: WM_SIZE runs on the window's thread; the size asked for goes to
