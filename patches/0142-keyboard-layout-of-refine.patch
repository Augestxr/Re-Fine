+ * PAD_NO_KEYBOARD=1 to disable it entirely.
  *
- * The only backend here is XInput, so on a machine with no controller plugged
- * in a title gets a pad that is reported present and never presses anything --
- * it can be watched but not played. That is what The Simpsons Arcade Game hit:
- * it reached its attract loop and no input existed to start a game.
+ * The layout is Re:Fine's (docs/inputs.md). F takes the d-pad and the face buttons
+ * as the same notes, and a double note as one of each, hence the two hands. A
+ * star is a flick of either stick in any direction (F's own Tutorial).
  *
- * Only fills in for port 0, only when XInput found nothing there, so a real
- * controller always wins and nothing changes for a port that has one. Keys are
- * read only while a window of THIS process is in the foreground, so typing in
- * another application does not drive the game. Set PAD_NO_KEYBOARD=1 to
- * disable it entirely.
- *
- * Arrows = d-pad, Z/X/A/S = cross/circle/square/triangle, Q/W = L1/R1,
- * 1/2 = L2/R2, Enter = START, Tab = SELECT. The left stick mirrors the d-pad
- * so a title that reads the stick instead is playable too. */
+ * PAD_KEYS="<sec>:<keys>:<ms>,..." and PAD_KEYCYCLE="<from>,<to>,<ms>,<keys>" act
+ * as those keys for automatic runs, window in the foreground or not. Keys are
+ * the letters of the table, in lower case for the arrows (u d l r), Enter (n),
+ * Backspace (b), Space (s) and Esc (e), '.' for none; PAD_KEYCYCLE moves to the next one
+ * every <ms> from second <from> to <to>. Off unless set, like PAD_SCRIPT. */
 #ifdef _WIN32
 static int pad_host_window_focused(void)
 {
@@ -279,51 +278,126 @@ static int pad_host_window_focused(void)
     return pid == GetCurrentProcessId();
 }
 
+#define PAD_KEY_EVENTS 512
+static struct { double from, to; char keys[12]; } s_key_ev[PAD_KEY_EVENTS];
+static int    s_key_ev_n;
+static double s_cycle_from, s_cycle_to, s_cycle_ms;
+static char   s_cycle_keys[16];
+static int    s_key_script = -1;
+static unsigned long long s_key_t0;
+
+static void pad_keys_parse(void)
+{
+    s_key_script = 0;
+    const char* e = getenv("PAD_KEYS");
+    if (e && *e) {
+        s_key_script = 1;
+        while (*e && s_key_ev_n < PAD_KEY_EVENTS) {
+            double t = 0, ms = 0; char k[12] = "";
+            int used = 0;
+            if (sscanf(e, "%lf:%11[^:]:%lf%n", &t, k, &ms, &used) != 3) break;
+            s_key_ev[s_key_ev_n].from = t;
+            s_key_ev[s_key_ev_n].to = t + ms / 1000.0;
+            memcpy(s_key_ev[s_key_ev_n].keys, k, sizeof k);
+            s_key_ev_n++;
+            e += used;
+            while (*e == ',' || *e == ' ') e++;
+        }
+        printf("[cellPad] PAD_KEYS: %d event(s)\n", s_key_ev_n);
+    }
+    e = getenv("PAD_KEYCYCLE");
+    if (e && sscanf(e, "%lf,%lf,%lf,%15s", &s_cycle_from, &s_cycle_to, &s_cycle_ms, s_cycle_keys) == 4)
+        s_key_script = 1;
+    s_key_t0 = GetTickCount64();
+}
+
+/* The letter a scripted run holds this instant. */
+static int pad_key_scripted(char c)
+{
+    const double now = (double)(GetTickCount64() - s_key_t0) / 1000.0;
+    for (int i = 0; i < s_key_ev_n; i++)
+        if (now >= s_key_ev[i].from && now < s_key_ev[i].to && strchr(s_key_ev[i].keys, c))
+            return 1;
+    if (s_cycle_ms > 0 && now >= s_cycle_from && now < s_cycle_to) {
+        const size_t n = strlen(s_cycle_keys);
+        const size_t k = (size_t)((now - s_cycle_from) * 1000.0 / s_cycle_ms) % n;
+        if (s_cycle_keys[k] == c) return 1;
+    }
+    return 0;
+}
+
+/* The last of the two pressed wins while both are down. */
+static u8 pad_key_axis(int neg, int pos, int* was_neg, int* was_pos, int* last)
+{
+    if (neg && !*was_neg) *last = -1;
+    if (pos && !*was_pos) *last = 1;
+    *was_neg = neg; *was_pos = pos;
+    const int v = (neg && pos) ? *last : neg ? -1 : pos ? 1 : 0;
+    return (u8)(v < 0 ? 0 : v > 0 ? 255 : 128);
+}
