-        { '1',       CELL_PAD_CTRL_L2 },      { '2',      CELL_PAD_CTRL_R2 },
-        { VK_RETURN, CELL_PAD_CTRL_START },   { VK_TAB,   CELL_PAD_CTRL_SELECT },
+    static const struct { int vk; u16 btn; char letter; } map[] = {
+        { 'W',       CELL_PAD_CTRL_TRIANGLE, 'W' }, { 'A',      CELL_PAD_CTRL_SQUARE, 'A' },
+        { 'S',       CELL_PAD_CTRL_CROSS,    'S' }, { 'D',      CELL_PAD_CTRL_CIRCLE, 'D' },
+        { 'I',       CELL_PAD_CTRL_UP,       'I' }, { 'J',      CELL_PAD_CTRL_LEFT,   'J' },
+        { 'K',       CELL_PAD_CTRL_DOWN,     'K' }, { 'L',      CELL_PAD_CTRL_RIGHT,  'L' },
+        { VK_UP,     CELL_PAD_CTRL_UP,       'u' }, { VK_DOWN,  CELL_PAD_CTRL_DOWN,   'd' },
+        { VK_LEFT,   CELL_PAD_CTRL_LEFT,     'l' }, { VK_RIGHT, CELL_PAD_CTRL_RIGHT,  'r' },
+        { VK_RETURN, CELL_PAD_CTRL_CROSS,    'n' }, { VK_BACK,  CELL_PAD_CTRL_CIRCLE, 'b' },
+        { VK_SPACE,  CELL_PAD_CTRL_START,    's' }, { VK_ESCAPE, CELL_PAD_CTRL_START, 'e' },
+        { VK_TAB,    CELL_PAD_CTRL_SELECT,   0 },
+        { '1',       CELL_PAD_CTRL_L1,       0 },   { '2',      CELL_PAD_CTRL_R1,     0 },
+        { '3',       CELL_PAD_CTRL_L2,       0 },   { '4',      CELL_PAD_CTRL_R2,     0 },
     };
+#define PAD_KEY(vk, c) ((focused && (GetAsyncKeyState(vk) & 0x8000)) || \
