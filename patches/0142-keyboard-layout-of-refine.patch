     { static int said = 0;
-      if (!said && btns) { said = 1;
-          printf("[cellPad] keyboard fallback active on port 0 (no XInput device)\n");
+      if (!said && (btns || lx != 128 || rx != 128)) { said = 1;
+          printf("[cellPad] keyboard active on port 0\n");
           fflush(stdout); } }
+
+    const int near_centre = !has_pad || (hs->analog_lx > 100 && hs->analog_lx < 156 &&
+                                         hs->analog_ly > 100 && hs->analog_ly < 156);
+    const int near_centre_r = !has_pad || (hs->analog_rx > 100 && hs->analog_rx < 156 &&
+                                           hs->analog_ry > 100 && hs->analog_ry < 156);
+    hs->buttons = (u16)((has_pad ? hs->buttons : 0) | btns);
+    hs->connected = 1;
+    if (near_centre) { hs->analog_lx = lx; if (!has_pad) hs->analog_ly = 128; }
+    if (near_centre_r) { hs->analog_rx = rx; if (!has_pad) hs->analog_ry = 128; }
+    if (btns & CELL_PAD_CTRL_L2) hs->trigger_l2 = 255; else if (!has_pad) hs->trigger_l2 = 0;
