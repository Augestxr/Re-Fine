diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -937,6 +937,28 @@ extern "C" void ppu_resv_register(ppu_context* c)
  * while calling out every pass. Reading a pinned lr as "no calls since
  * entry" narrowed a search to the wrong loop once already. lr names the
  * last DIRECT call site and nothing more. */
+/* Re:Fine 5d.2, AUDIO_STALL: see src/main.cpp. */
+#define SC_RING 1024
+static struct { long long q0, q1; unsigned num, tid, a3, ret; } s_sc_ring[SC_RING];
+static volatile long s_sc_ring_n;
+static void sc_ring_add(long long q0, long long q1, unsigned num, unsigned tid, unsigned a3, unsigned ret)
+{
+    const long i = _InterlockedIncrement(&s_sc_ring_n) - 1;
+    auto& e = s_sc_ring[i % SC_RING];
+    e.q0 = q0; e.q1 = q1; e.num = num; e.tid = tid; e.a3 = a3; e.ret = ret;
+}
+extern "C" void ppu_sc_ring_dump(long long now, double ms_per_tick)
+{
+    const long n = s_sc_ring_n;
+    for (long i = n > SC_RING ? n - SC_RING : 0; i < n; i++) {
+        auto& e = s_sc_ring[i % SC_RING];
+        const double ago = (now - e.q1) * ms_per_tick;
+        if (ago > 80.0) continue;
+        fprintf(stderr, "[AUDIO_STALL] sc %7.2f tid=%u num=%u a3=0x%X took %.2f ms ret=0x%X\n",
+                ago, e.tid, e.num, e.a3, (e.q1 - e.q0) * ms_per_tick, e.ret);
+    }
+}
+
 extern "C" void ppu_report_guest_lrs(void)
 {
     long n = g_resv_ctx_n; if (n > PPU_RESV_MAX) n = PPU_RESV_MAX;
@@ -3490,7 +3512,16 @@ extern "C" void lv2_syscall(ppu_context* ctx)
              * first argument column -- and the first argument is the object id for
              * most of lv2, which is exactly what a trace is being read for. */
             uint64_t _pre3 = ctx->gpr[3];
-            if (lv2_try_syscall(ctx)) {
+            /* Re:Fine 5d.2, AUDIO_STALL: the mixer threads' syscalls, with their times. */
+            static int s_ring_on = -1; if (s_ring_on < 0) s_ring_on = getenv("AUDIO_STALL") ? 1 : 0;
+            const int _ring = s_ring_on && ctx->thread_id >= 3 && ctx->thread_id <= 5;
+            LARGE_INTEGER _q0, _q1;
+            if (_ring) QueryPerformanceCounter(&_q0);
+            const int _done = lv2_try_syscall(ctx);
+            if (_ring) { QueryPerformanceCounter(&_q1);
+                         sc_ring_add(_q0.QuadPart, _q1.QuadPart, (unsigned)num, (unsigned)ctx->thread_id,
+                                     (unsigned)_pre3, (unsigned)ctx->gpr[3]); }
+            if (_done) {
                 sc_trace(num, ctx, _pre3, ctx->gpr[4], ctx->gpr[5], ctx->gpr[6]);
                 return;
             }
