+/* cbFunc(handle, msgType, msgData, cbArg). A guest OPD, run on the decoder
+ * thread with no lock held. AUDONE's msgData is the AU info address, not a
+ * status: see RPCS3 Modules/cellAdec.cpp:1345. */
+static void adec_notify(AdecSlot* a, u32 msg_type, s32 msg_data)
+{
+    if (!a->cbFunc) return;
+    ps3_invoke_guest(a->cbFunc, (u64)ADEC_HANDLE_OF(a->slot), (u64)msg_type,
+                     (u64)(s64)msg_data, (u64)a->cbArg, 0, 0, 0, 0);
+}
+
+/* ---------------------------------------------------------------------------
+ * The decoder thread
+ * -----------------------------------------------------------------------*/
+
+/* The first AU of a sequence may carry the ATS header: 0x0FD0, then 3 bits of
+ * sample rate, 3 of channel config and 10 of (nbytes / 8) - 1. */
+static u32 adec_parse_ats(AdecSlot* a, u32 au)
+{
+    const u32 sync = vm_read16(au + 0), params = vm_read16(au + 2);
+    const u32 rate = params >> 13, ch = (params >> 10) & 7;
+    if (sync != ATX_ATS_SYNC || ch == 0 || ch > ATX_MAX_CHANNELS || (rate != 1 && rate != 2))
+        return ATX_ERROR_ATSHDR;
+    a->sampling = rate == 1 ? 44100u : 48000u;
+    a->nch = ch;
+    a->nbytes = ((params & 0x3FF) + 1) * 8;
+    return 0;
+}
+
+/* A PTS the demuxer did not give counts on from the previous one. */
+static void adec_correct_pts(AdecSlot* a, s32 h)
+{
+    const u32 pts_ea = a->mem + ADEC_AU_OFF(h) + 8;
+    u32 hi = vm_read32(pts_ea), lo = vm_read32(pts_ea + 4);
+    if (hi == TS_INVALID) {
+        if (a->prevPtsHi == TS_INVALID && a->prevPtsLo == TS_INVALID)
+            return;
+        hi = a->prevPtsHi;
+        lo = a->prevPtsLo + ATX_PTS_TICKS;
+        if (lo < a->prevPtsLo)
+            hi = (hi + 1) & 1;
+        vm_write32(pts_ea, hi);
+        vm_write32(pts_ea + 4, lo);
+    }
+    a->prevPtsHi = hi;
+    a->prevPtsLo = lo;
+}
+
+/* One AU: its AUDONE and PCMOUT always go out, even for a damaged frame. */
+static void adec_decode_au(AdecSlot* a, s32 h)
+{
+    const u32 au_ea = a->mem + ADEC_AU_OFF(h);
+    const u32 pcm = a->mem + ADEC_PCM_OFF;
+    u32 au = vm_read32(au_ea);
+    u32 error = 0, samples = 0;
+
+    if (a->firstDecode && a->atsHeader)
+        error = adec_parse_ats(a, au);
+    if (!error && !a->ff) {
+        a->ff = adec_ff_open(a->sampling, a->nch, a->nbytes);
+        if (!a->ff) error = ATX_ERROR_NON_FATAL;
+    }
+
+    if (!error) {
+        const float* const* planes = NULL;
+        int n = adec_ff_decode(a->ff, vm_ptr8(au + (a->atsHeader ? ATX_ATS_BYTES : 0)),
+                               a->nbytes, &planes);
+        if (n < 0 || (n != 0 && (u32)n != ATX_SAMPLES)) {
+            fprintf(stderr, "[cellAdec] frame did not decode (%d)\n", n);
+            error = ATX_ERROR_NON_FATAL;
+        } else if (a->skipNext) {
+            /* The first frame of a sequence, or after an error, is thrown away. */
+            a->skipNext = 0;
+            for (u32 o = 0; o < ATX_SAMPLES * 4u * a->nch; o += 4) vm_write32(pcm + o, 0);
+        } else {
+            /* Interleaved big-endian float, clipped to [-1, 1). */
+            samples = (u32)n;
+            u32 tmp[ATX_SAMPLES * ATX_MAX_CHANNELS];
+            for (u32 c = 0; c < a->nch; c++) {
+                const float* in = planes[c];
+                for (u32 i = 0; i < samples; i++) {
+                    union { float f; u32 u; } s;
+                    s.f = in[i];
+                    if (s.u < 0x80000000u) {
+                        if (s.u >= 0x3F7FFFFFu) s.u = 0x3F7FFFFFu;
+                    } else if (s.u >= 0xBF800000u) {
+                        s.u = 0xBF800000u;
+                    }
+                    if (adec_trace() >= 2) a->sumSq += (double)s.f * s.f;
+                    tmp[i * a->nch + c] = _byteswap_ulong(s.u);
+                }
+            }
+            vm_memcpy_to(pcm, tmp, samples * 4u * a->nch);
+        }
+        a->firstDecode = 0;
+    }
+
+    if (error) {
+        a->skipNext = 1;
+        a->nErrors++;
+        adec_notify(a, CELL_ADEC_MSG_TYPE_ERROR, (s32)error);
+    }
+
+    adec_notify(a, CELL_ADEC_MSG_TYPE_AUDONE, (s32)au_ea);
+
+    adec_correct_pts(a, h);
+    const u32 it = a->mem + ADEC_ITEM_OFF(h), bsi = a->mem + ADEC_BSI_OFF(h);
+    const u32 size = samples * 4u * a->nch;
+    vm_write32(it + PCMITEM_PCM_HANDLE, (u32)h);
+    vm_write32(it + PCMITEM_STATUS, CELL_OK);
+    vm_write32(it + PCMITEM_START_ADDR, pcm);
+    vm_write32(it + PCMITEM_SIZE, size);
+    vm_write32(it + PCMITEM_BSI_INFO, bsi);
+    vm_write32(bsi + 0, a->sampling);
+    vm_write32(bsi + 4, a->nch);
+    vm_write32(bsi + 8, a->nbytes);
+    for (u32 o = 0; o < AUINFO_BYTES; o += 4)
+        vm_write32(it + PCMITEM_AU_INFO + o, vm_read32(au_ea + o));
+    if (adec_trace() >= 2)
+        fprintf(stderr, "[adec] pcm h=%d size=0x%x pts=0x%x%08x\n", h, size,
