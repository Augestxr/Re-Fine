diff --git a/libs/codec/adec_ffmpeg.c b/libs/codec/adec_ffmpeg.c
new file mode 100644
index 00000000..ff2a4408
--- /dev/null
+++ b/libs/codec/adec_ffmpeg.c
@@ -0,0 +1,107 @@
+/*
+ * ps3recomp - cellAdec's decoder back end (see adec_ffmpeg.h)
+ */
+
+#include "adec_ffmpeg.h"
+#include "ffmpeg_runtime.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef PS3RECOMP_FFMPEG_RUNTIME
+
+struct AdecFf {
+    const PS3FFmpeg* ff;
+    AVCodecContext* ctx;
+    AVPacket* pkt;
+    AVFrame* frame;
+    u8* buf;          /* the frame plus FFmpeg's zeroed input padding */
+    u32 buf_cap;
+};
+
+int adec_ff_available(void)
+{
+    const PS3FFmpeg* ff = ps3_ffmpeg_get();
+    return ff && ff->avcodec_find_decoder(AV_CODEC_ID_ATRAC3P);
+}
+
+AdecFf* adec_ff_open(u32 sampling_freq, u32 channels, u32 nbytes)
+{
+    const PS3FFmpeg* ff = ps3_ffmpeg_get();
+    if (!ff) return NULL;
+    const AVCodec* codec = ff->avcodec_find_decoder(AV_CODEC_ID_ATRAC3P);
+    if (!codec) {
+        fprintf(stderr, "[cellAdec] libavcodec has no ATRAC3plus decoder\n");
+        return NULL;
+    }
+    AdecFf* d = (AdecFf*)calloc(1, sizeof(*d));
+    if (!d) return NULL;
+    d->ff = ff;
+    d->ctx = ff->avcodec_alloc_context3(codec);
+    d->pkt = ff->av_packet_alloc();
+    d->frame = ff->av_frame_alloc();
+    if (d->ctx) {
+        d->ctx->sample_rate = (int)sampling_freq;
+        d->ctx->ch_layout.nb_channels = (int)channels;
+        d->ctx->block_align = (int)nbytes;
+    }
+    if (!d->ctx || !d->pkt || !d->frame || ff->avcodec_open2(d->ctx, codec, NULL) < 0) {
+        fprintf(stderr, "[cellAdec] could not open the libavcodec decoder\n");
+        adec_ff_close(d);
+        return NULL;
+    }
+    return d;
+}
+
+void adec_ff_close(AdecFf* d)
+{
+    if (!d) return;
+    if (d->ctx) d->ff->avcodec_free_context(&d->ctx);
+    if (d->pkt) d->ff->av_packet_free(&d->pkt);
+    if (d->frame) d->ff->av_frame_free(&d->frame);
+    free(d->buf);
+    free(d);
+}
+
+void adec_ff_flush(AdecFf* d)
+{
+    d->ff->avcodec_flush_buffers(d->ctx);
+}
+
+int adec_ff_decode(AdecFf* d, const u8* frame, u32 nbytes, const float* const** planes)
+{
+    if (nbytes + AV_INPUT_BUFFER_PADDING_SIZE > d->buf_cap) {
+        u8* nb = (u8*)realloc(d->buf, nbytes + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!nb) return AVERROR(ENOMEM);
+        d->buf = nb;
+        d->buf_cap = nbytes + AV_INPUT_BUFFER_PADDING_SIZE;
+    }
+    memcpy(d->buf, frame, nbytes);
+    memset(d->buf + nbytes, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+
+    AVPacket* pkt = d->pkt;
+    pkt->data = d->buf;
+    pkt->size = (int)nbytes;
+    d->ff->av_frame_unref(d->frame);
+    int r = d->ff->avcodec_send_packet(d->ctx, pkt);
+    pkt->data = NULL;
+    pkt->size = 0;
+    if (r < 0) return r;
+    r = d->ff->avcodec_receive_frame(d->ctx, d->frame);
+    if (r < 0) return r;
+    *planes = (const float* const*)d->frame->extended_data;
+    return d->frame->nb_samples;
+}
+
+#else /* !PS3RECOMP_FFMPEG_RUNTIME */
+
+int     adec_ff_available(void) { return 0; }
+AdecFf* adec_ff_open(u32 sampling_freq, u32 channels, u32 nbytes)
+{ (void)sampling_freq; (void)channels; (void)nbytes; return NULL; }
+void    adec_ff_close(AdecFf* d) { (void)d; }
+void    adec_ff_flush(AdecFf* d) { (void)d; }
+int     adec_ff_decode(AdecFf* d, const u8* frame, u32 nbytes, const float* const** planes)
+{ (void)d; (void)frame; (void)nbytes; (void)planes; return -1; }
+
+#endif /* PS3RECOMP_FFMPEG_RUNTIME */
diff --git a/libs/codec/adec_ffmpeg.h b/libs/codec/adec_ffmpeg.h
new file mode 100644
index 00000000..9f6d8f36
--- /dev/null
+++ b/libs/codec/adec_ffmpeg.h
@@ -0,0 +1,34 @@
+/*
+ * ps3recomp - cellAdec's decoder back end
+ *
+ * ATRAC3plus through libavcodec, loaded at run time (ffmpeg_runtime.h).
+ * Without PS3RECOMP_FFMPEG_RUNTIME, or with no library, adec_ff_available()
+ * is 0 and cellAdecOpen fails.
+ */
+
+#ifndef PS3RECOMP_ADEC_FFMPEG_H
+#define PS3RECOMP_ADEC_FFMPEG_H
+
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct AdecFf AdecFf;
+
+int     adec_ff_available(void);
+AdecFf* adec_ff_open(u32 sampling_freq, u32 channels, u32 nbytes);
+void    adec_ff_close(AdecFf* d);
+void    adec_ff_flush(AdecFf* d);
+
+/* Decode one frame of nbytes. Returns the samples per channel, or a negative
+ * FFmpeg error for a damaged frame; the decoder stays usable. *planes gets one
+ * float pointer per channel, valid until the next call. */
+int     adec_ff_decode(AdecFf* d, const u8* frame, u32 nbytes, const float* const** planes);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_ADEC_FFMPEG_H */
