+static AdecSlot* adec_of(CellAdecHandle handle)
+{
+    u32 slot = ADEC_SLOT_OF(handle);
+    return slot < MAX_ADEC && s_adec[slot].in_use ? &s_adec[slot] : NULL;
+}
