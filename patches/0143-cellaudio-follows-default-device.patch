+/* Re:Fine patches/0110: start with AUDIO_QUEUE_TARGET frames queued. The mixing thread
+ * adds blocks at the rate the device takes them, so this is the cushion that
+ * outlasts the device's 10 ms period. */
+static void audio_device_start(AudioDevice* d)
+{
+    BYTE* pre = NULL;
+    const u64 end = s_hist_frames;
+    if (SUCCEEDED(d->render->lpVtbl->GetBuffer(d->render, AUDIO_QUEUE_TARGET, &pre))) {
+        const int have = end >= AUDIO_QUEUE_TARGET;
+        for (u32 i = 0; have && i < AUDIO_QUEUE_TARGET; i++) {
+            const u32 at = (u32)((end - AUDIO_QUEUE_TARGET + i) % AUDIO_HIST_FRAMES);
+            memcpy(pre + i * 2 * sizeof(float), &s_hist[at * 2], 2 * sizeof(float));
+        }
+        d->render->lpVtbl->ReleaseBuffer(d->render, AUDIO_QUEUE_TARGET,
+                                         have && !audio_muted() ? 0 : AUDCLNT_BUFFERFLAGS_SILENT);
+        d->hist_end = end;
     }
+    d->client->lpVtbl->Start(d->client);
+}
