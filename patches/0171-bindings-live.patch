+/* Re:Fine 0171: bindings from the port's menu (port_overlay.h), changed live. The menu thread
+ * publishes a whole new table and the poll reads one pointer, so a poll never sees half a
+ * change; an old table is never freed (a few hundred bytes per rebinding). NULL: the defaults,
+ * which are the layouts of 0142 (keyboard) and 0145 (controller). */
+static const u16 s_bind_btn[PORT_BIND_PAD_COUNT] = {
+    CELL_PAD_CTRL_CROSS, CELL_PAD_CTRL_CIRCLE, CELL_PAD_CTRL_SQUARE, CELL_PAD_CTRL_TRIANGLE,
+    CELL_PAD_CTRL_UP, CELL_PAD_CTRL_DOWN, CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_RIGHT,
+    CELL_PAD_CTRL_L1, CELL_PAD_CTRL_R1, CELL_PAD_CTRL_L2, CELL_PAD_CTRL_R2,
