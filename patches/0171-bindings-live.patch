+/* Re:Fine 0171. Bindings from the port's menu, live, for cellPad. An action is one of the 16 PS3
+ * buttons, or (keyboard only) the left or right stick pushed left or right. Keys are Windows virtual
+ * keys, two per action (0 = none). A controller source is an SDL_GamepadButton, or PORT_SRC_LT/RT
+ * for a trigger past the threshold; one per action (-1 = none). Each call replaces the whole table. */
+enum {
+    PORT_BIND_CROSS, PORT_BIND_CIRCLE, PORT_BIND_SQUARE, PORT_BIND_TRIANGLE,
+    PORT_BIND_UP, PORT_BIND_DOWN, PORT_BIND_LEFT, PORT_BIND_RIGHT,
+    PORT_BIND_L1, PORT_BIND_R1, PORT_BIND_L2, PORT_BIND_R2, PORT_BIND_L3, PORT_BIND_R3,
+    PORT_BIND_START, PORT_BIND_SELECT, PORT_BIND_PAD_COUNT,
+    PORT_BIND_LS_LEFT = PORT_BIND_PAD_COUNT, PORT_BIND_LS_RIGHT, PORT_BIND_RS_LEFT, PORT_BIND_RS_RIGHT,
+    PORT_BIND_COUNT
+};
+#define PORT_BIND_KEYS 2
+#define PORT_SRC_LT 26
+#define PORT_SRC_RT 27
+void pad_set_key_binds(const int vk[PORT_BIND_COUNT][PORT_BIND_KEYS]);
+void pad_set_pad_binds(const int src[PORT_BIND_PAD_COUNT]);
+/* Port 0's controller as pressed right now (bit n = source n), before any binding. */
+unsigned pad_raw_sources(void);
+
