+};
+typedef struct { int vk[PORT_BIND_COUNT][PORT_BIND_KEYS]; } PadKeyBinds;
+typedef struct { int src[PORT_BIND_PAD_COUNT]; } PadPadBinds;
+static PadKeyBinds* s_key_binds;
+static PadPadBinds* s_pad_binds;
+static volatile long s_raw_sources;   /* port 0's controller as pressed, before any binding */
+
+void pad_set_key_binds(const int vk[PORT_BIND_COUNT][PORT_BIND_KEYS])
+{
+    PadKeyBinds* t = (PadKeyBinds*)malloc(sizeof *t);
+    if (!t) return;
+    memcpy(t->vk, vk, sizeof t->vk);
+    __atomic_store_n(&s_key_binds, t, __ATOMIC_RELEASE);
+}
+void pad_set_pad_binds(const int src[PORT_BIND_PAD_COUNT])
+{
+    PadPadBinds* t = (PadPadBinds*)malloc(sizeof *t);
+    if (!t) return;
+    memcpy(t->src, src, sizeof t->src);
+    __atomic_store_n(&s_pad_binds, t, __ATOMIC_RELEASE);
+}
+unsigned pad_raw_sources(void) { return (unsigned)s_raw_sources; }
