+/* Re:Fine 6d.4: the same strip through the indexed run of upload_tris_vp_ix, same
+ * triangles in the same order. The expansion wrote 131000 vertices of 256 bytes per
+ * frame in a song, 33 MB into the upload heap, for 37000 distinct ones: ~4 ms of the
+ * drain. The 256-index batches of one strip (0119) join one record. *ok = 0 means "use
+ * the expansion", with nothing published; a batch can be valid and hold no triangle. */
+static u32 upload_strip_vp_ix(const rsx_state* state, u32 first, u32 count, int fan, int cont, int* ok)
+{
+    extern uint8_t* vm_base;
+    *ok = 0;
+    if (!state || !vm_base || !s_d3d.vp_vb_mapped || !s_d3d.vp_ib_mapped) return 0;
+    if (!state->vertex_attribs[0].enabled || !count) return 0;
+    if (s_d3d.vp_ib_offset + count * 3 > VP_MAX_INDICES) return 0;
+    if (!s_ix_stamp) {
+        s_ix_stamp = (u32*)calloc(1u << 20, sizeof(u32));
+        s_ix_slot  = (u32*)malloc((1u << 20) * sizeof(u32));
+        if (!s_ix_stamp || !s_ix_slot) return 0;
+    }
+    if (!cont) {
+        if (++s_ix_gen == 0) { memset(s_ix_stamp, 0, (1u << 20) * sizeof(u32)); s_ix_gen = 1; }
+        s_ix_vbase  = s_d3d.vp_vb_offset / VP_VERT_STRIDE;
+        s_ix_nverts = 0;
+    }
+    const struct { u32 epoch, next, n, odd, v[2]; int valid; } saved = { s_strip.epoch, s_strip.next, s_strip.n, s_strip.odd,
+                                                                         { s_strip.v[0], s_strip.v[1] }, s_strip.valid };
+    if (!s_strip.valid || s_strip.epoch != state->begin_epoch || s_strip.next != first) {
+        s_strip.n = 0; s_strip.odd = 0;
+    }
+    s_strip.valid = 1; s_strip.epoch = state->begin_epoch; s_strip.next = first + count;
+    const int sixteen = (((state->index_array_dma >> 4) & 0xF) == 1);
+    const int restart = state->restart_index_enable && (!sixteen || state->restart_index <= 0xFFFFu);
+    VPSlot* vb = (VPSlot*)((u8*)s_d3d.vp_vb_mapped + (u64)s_d3d.vp_parity * MAX_VERTICES * VP_VERT_STRIDE);
+    u32* ib = (u32*)s_d3d.vp_ib_mapped + (u64)s_d3d.vp_parity * VP_MAX_INDICES + s_d3d.vp_ib_offset;
+    u32 n = s_ix_nverts, o = 0;
+    for (u32 k = 0; k < count; k++) {
+        const u32 ix = read_guest_index(state, first + k);
+        if (restart && ix == state->restart_index) { s_strip.n = 0; s_strip.odd = 0; continue; }
+        if (ix >= (1u << 20) || s_ix_vbase + n + 3 > MAX_VERTICES) {
+            /* As in upload_tris_vp_ix: abandon the run, the expansion takes the draw. */
+            s_strip.epoch = saved.epoch; s_strip.next = saved.next; s_strip.n = saved.n;
+            s_strip.odd = saved.odd; s_strip.valid = saved.valid;
+            s_strip.v[0] = saved.v[0]; s_strip.v[1] = saved.v[1];
+            s_ix_run_valid = 0;
+            if (++s_ix_gen == 0) { memset(s_ix_stamp, 0, (1u << 20) * sizeof(u32)); s_ix_gen = 1; }
+            return 0;
+        }
+        if (s_strip.n < 2) { s_strip.v[s_strip.n++] = ix; continue; }
+        u32 tri[3] = { s_strip.v[0], s_strip.v[1], ix };
+        if (!fan && s_strip.odd) { tri[1] = ix; tri[2] = s_strip.v[1]; }
+        for (int t = 0; t < 3; t++) {
+            const u32 g = tri[t];
+            if (s_ix_stamp[g] != s_ix_gen) {
+                s_ix_stamp[g] = s_ix_gen;
+                s_ix_slot[g] = n;
+                read_vp_vertex(state, g, &vb[(u64)(s_ix_vbase + n) * 16]);
+                n++;
+            }
+            ib[o++] = s_ix_slot[g];
+        }
+        if (!fan) { s_strip.v[0] = s_strip.v[1]; s_strip.odd ^= 1u; }
+        s_strip.v[1] = ix;
+    }
+    s_d3d.vp_vb_offset += (n - s_ix_nverts) * VP_VERT_STRIDE;
+    s_ix_nverts = n;
+    s_d3d.vp_ib_offset += o;
+    s_ix_run_valid = 1;
+    *ok = 1;
+    return o;
+}
