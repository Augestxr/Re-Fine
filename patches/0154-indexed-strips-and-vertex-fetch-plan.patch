+/* Re:Fine 6d.4: the fetch of one draw, worked out once. 16 calls of rsx_fetch_attrib per
+ * vertex, each resolving its address, took ~5 ms of a 6 ms drain in a song, and they
+ * wrote float by float into the write-combined upload heap. Here the disabled attributes
+ * are one block copied whole, an enabled one is base + index * stride while it stays in
+ * its 1 MB IO page, and the vertex reaches the heap in one memcpy. Same bytes as
+ * rsx_fetch_attrib: VTX_PLAN_CHECK=1 compares every vertex, VTX_PLAN_OFF=1 goes back. */
+#include "rsx_vertex_formats.h"   /* here: its names clash with dxgiformat.h */
+typedef struct { const u8* base; u32 off, stride, room; u8 idx, type, n, local, slow; } FetchAttr;
+static struct { int valid, n; FetchAttr a[16]; VPSlot def[16]; } s_fetch;
+
+static void fetch_plan_build(const rsx_state* st)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int, u32);
+    memcpy(s_fetch.def, st->vertex_data4f, sizeof s_fetch.def);
+    s_fetch.n = 0;
+    for (int i = 0; i < 16; i++) {
+        const rsx_vertex_attrib* a = &st->vertex_attribs[i];
+        if (!a->enabled || a->stride == 0 || !vm_base) continue;
+        FetchAttr* f = &s_fetch.a[s_fetch.n++];
+        const u32 n = a->size ? a->size : 4;
+        f->idx = (u8)i; f->type = (u8)a->type; f->n = (u8)(n > 4 ? 4 : n);
+        f->stride = a->stride;
+        f->off = a->offset & 0x7FFFFFFFu;
+        f->local = (a->offset & 0x80000000u) ? 0 : 1;
+        f->room = 0x100000u - (f->off & 0xFFFFFu);
+        f->base = vm_base + cellGcmResolveLocated(f->local, f->off);
+        f->slow = !rsx_vertex_freq_plain(a->frequency, (st->frequency_divider_op >> i) & 1u) ||
+                  a->type < 1 || a->type > 7;
+    }
+    s_fetch.valid = 1;
+}
+
+static inline float fetch_bef(const u8* p)
+{
+    u32 w; memcpy(&w, p, 4);
+    w = _byteswap_ulong(w);
+    float f; memcpy(&f, &w, 4); return f;
+}
+
+static inline void fetch_attr(const rsx_state* state, const FetchAttr* f, u32 vi, float* out)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int, u32);
+    if (f->slow) { rsx_fetch_attrib(state, f->idx, vi, out); return; }
+    const u64 d = (u64)vi * f->stride;
+    const u8* p = d + 16 <= f->room ? f->base + d
+                                    : vm_base + cellGcmResolveLocated(f->local, f->off + (u32)d);
+    const u32 n = f->n;
+    switch (f->type) {
+    case 2: for (u32 k = 0; k < n; k++) out[k] = fetch_bef(p + k * 4); break;
+    case 3: for (u32 k = 0; k < n; k++) out[k] = rsx_rd_half_be(p + k * 2); break;
+    case 4: for (u32 k = 0; k < n; k++) out[k] = p[k] / 255.0f; break;
+    case 1: for (u32 k = 0; k < n; k++) {
+                s16 s = (s16)((p[k*2] << 8) | p[k*2+1]);
+                out[k] = (float)s / 32767.0f;
+            }
+            break;
+    case 5: for (u32 k = 0; k < n; k++) out[k] = (float)(s16)((p[k*2] << 8) | p[k*2+1]); break;
+    case 6: {
+        const u32 w = _byteswap_ulong(*(const u32*)p);
+        s32 x = (s32)(w & 0x7FF);         if (x & 0x400) x -= 0x800;
+        s32 y = (s32)((w >> 11) & 0x7FF); if (y & 0x400) y -= 0x800;
+        s32 z = (s32)((w >> 22) & 0x3FF); if (z & 0x200) z -= 0x400;
+        out[0] = (float)x / 1023.0f; out[1] = (float)y / 1023.0f; out[2] = (float)z / 511.0f; out[3] = 1.0f;
+        break; }
+    case 7: for (u32 k = 0; k < n; k++) out[k] = (float)p[k]; break;
+    }
+}
