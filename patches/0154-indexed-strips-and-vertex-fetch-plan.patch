+        }
+        return;
+    }
     for (int i = 0; i < 16; i++) {
         rsx_fetch_attrib(state, i, vi, out16[i].v);
         if (i == 0) {
@@ -8152,6 +8245,75 @@ static u32 upload_strip_vp_indexed(const rsx_state* state, u32 first, u32 count,
