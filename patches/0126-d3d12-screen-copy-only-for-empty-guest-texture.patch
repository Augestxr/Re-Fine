+/* Anything but zero in the first bytes of a texture's guest memory. The stride
+ * is odd, so alpha alone counts. */
+static int tex_has_guest_data(const D3D12DrawTex* t)
+{
+    extern uint8_t* vm_base;
+    if (!t->off || !vm_base) return 0;
+    const u32 sz = t->w * t->h * 4u;
+    for (u32 i = 0; i < sz && i < 0x20000u; i += 997)
+        if (vm_base[t->off + i]) return 1;
+    return 0;
+}
