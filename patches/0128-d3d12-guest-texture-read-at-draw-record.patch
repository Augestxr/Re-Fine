+/* Re:Fine 0128: a guest texture is read when the draw is recorded, as the RSX reads
+ * it when it reaches the draw. Uploads wait for the flip, ~25 ms later, and by
+ * then Project DIVA F is overwriting its movie texture with the next picture:
+ * nothing in the command stream orders the two (docs/STATUS.md, 4c.5). So the
+ * first draw of a batch to bind a texture takes its checksum, and if the bytes
+ * changed since the last batch that bound it, takes a copy, which the upload
+ * reads instead of guest memory. Static textures cost the checksum the upload
+ * no longer does. Not covered: cube maps, a texture's first batch (nothing to
+ * compare with), and a second version written between two draws of one batch,
+ * since a slot holds one version per batch. TEX_SNAP=0 turns it off. */
+#define TEX_REC_N 1024u
+#define TEX_REC_PROBE 8u
+typedef struct {
+    u32 key, w, h, fmt;
+    u32 nbytes;
+    u32 csum;        /* of the bytes at record time */
+    u32 stamp;       /* the batch that last bound it */
+    u32 snap_stamp;  /* the batch `snap` was taken for */
+    u8* snap;
+    u32 cap;
+} TexRec;
+static TexRec s_tex_rec[TEX_REC_N];
+static u32 s_tex_rec_batch = 1;   /* batch being recorded */
+static u32 s_tex_rec_render;      /* batch render_frame is uploading */
+static u32 s_tex_snap_n;
+static u64 s_tex_snap_bytes;
+static double s_tex_snap_ms;
+
+static int tex_snap_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("TEX_SNAP");
+                  on = (e && atoi(e) == 0) ? 0 : !getenv("TEX_OFF_BIAS") && !getenv("TEX_REMAP"); }
+    return on;
+}
+
+static TexRec* tex_rec_find(u32 key, u32 w, u32 h, u32 fmt, TexRec** victim)
+{
+    const u32 home = ((key >> 7) * 2654435761u) >> 22;
+    TexRec* old = NULL;
+    for (u32 i = 0; i < TEX_REC_PROBE; i++) {
+        TexRec* e = &s_tex_rec[(home + i) & (TEX_REC_N - 1u)];
+        if (e->key == key && e->w == w && e->h == h && e->fmt == fmt) return e;
+        if (!old || e->stamp < old->stamp) old = e;
+    }
+    if (victim) *victim = old;
+    return NULL;
+}
+
+static void tex_rec_capture(u32 key, u32 w, u32 h, u32 fmt)
+{
+    extern uint8_t* vm_base;
+    TexRec* v = NULL;
+    TexRec* e = tex_rec_find(key, w, h, fmt, &v);
+    if (e && e->stamp == s_tex_rec_batch) return;
+    if (!e) {
+        rsx_tex_layout tl;
+        rsx_texture_layout(fmt, w, h, &tl);
+        u8* snap = v->snap; const u32 cap = v->cap;
+        memset(v, 0, sizeof *v);
+        v->snap = snap; v->cap = cap;
+        v->key = key; v->w = w; v->h = h; v->fmt = fmt;
+        v->nbytes = tl.compressed ? tl.row_bytes * tl.rows : w * h * tl.bytes_per_texel;
+        v->csum = tex_csum(vm_base + key, v->nbytes);
+        v->stamp = s_tex_rec_batch;
+        return;
+    }
+    const u32 cs = tex_csum(vm_base + key, e->nbytes);
+    if (cs != e->csum) {
+        if (e->cap < e->nbytes) {
+            free(e->snap);
+            e->snap = (u8*)malloc(e->nbytes);
+            e->cap = e->snap ? e->nbytes : 0;
+        }
+        if (e->snap) {
+            static int stats = -1;
+            if (stats < 0) stats = getenv("TEX_SNAP_STATS") ? 1 : 0;
+            LARGE_INTEGER t0, t1, f;
+            if (stats) QueryPerformanceCounter(&t0);
+            memcpy(e->snap, vm_base + key, e->nbytes);
+            e->snap_stamp = s_tex_rec_batch;
+            if (stats) {
+                QueryPerformanceCounter(&t1); QueryPerformanceFrequency(&f);
+                s_tex_snap_ms += (t1.QuadPart - t0.QuadPart) * 1000.0 / f.QuadPart;
+                s_tex_snap_bytes += e->nbytes;
+                if (!(++s_tex_snap_n % 300u))
+                    fprintf(stderr, "[TEXSNAP] copies=%u MB=%.1f ms=%.1f last=0x%08X %ux%u%c",
+                            s_tex_snap_n, s_tex_snap_bytes / 1048576.0, s_tex_snap_ms,
+                            key, w, h, 10);
+            }
+        }
+    }
+    e->csum = cs;
+    e->stamp = s_tex_rec_batch;
+}
+
+/* What this batch recorded for a texture, or NULL: the upload then reads guest
+ * memory, as before. */
+static const TexRec* tex_rec_for_upload(u32 key, u32 w, u32 h, u32 fmt, int cube)
+{
+    if (cube || !tex_snap_on()) return NULL;
+    const TexRec* e = tex_rec_find(key, w, h, fmt, NULL);
+    return (e && e->stamp == s_tex_rec_render) ? e : NULL;
+}
