+/* Re:Fine 0191: a scripted press, queued where a real key's press is queued (src/evt.cpp, the route step
+ * "taps"). A scripted key is a time window that the per-frame poll may miss entirely when the window is
+ * shorter than a frame; a real key cannot be missed (GetAsyncKeyState keeps "pressed since the last call",
+ * 0185). So the speed test's own presses go in here: one press of each button of <letters>, timed now. */
+void cellPad_script_tap(const char* letters)
+{
+    static const struct { u16 btn; char letter; } tab[] = {
+        { CELL_PAD_CTRL_TRIANGLE, 'W' }, { CELL_PAD_CTRL_SQUARE, 'A' }, { CELL_PAD_CTRL_CROSS, 'S' },
+        { CELL_PAD_CTRL_CIRCLE, 'D' },   { CELL_PAD_CTRL_UP, 'I' },     { CELL_PAD_CTRL_LEFT, 'J' },
+        { CELL_PAD_CTRL_DOWN, 'K' },     { CELL_PAD_CTRL_RIGHT, 'L' },  { CELL_PAD_CTRL_UP, 'u' },
+        { CELL_PAD_CTRL_DOWN, 'd' },     { CELL_PAD_CTRL_LEFT, 'l' },   { CELL_PAD_CTRL_RIGHT, 'r' },
+        { CELL_PAD_CTRL_CROSS, 'n' },    { CELL_PAD_CTRL_CIRCLE, 'b' }, { CELL_PAD_CTRL_START, 's' },
+        { CELL_PAD_CTRL_START, 'e' },
+    };
+    u16 mask = 0;
+    for (const char* c = letters; *c; c++)
+        for (unsigned i = 0; i < sizeof tab / sizeof tab[0]; i++)
+            if (tab[i].letter == *c) mask |= tab[i].btn;
+    if (!mask) return;
+    const unsigned long long now = pad_now_ms();
+    pad_lock();
+    for (int b = 0; b < 16; b++) {
+        if (!(mask & (1u << b))) continue;
+        if (s_tap_n[0][b] >= PAD_TAPS) { s_tap_lost++; continue; }
+        s_tap_ms[0][b][s_tap_n[0][b]++] = now;
+        s_tap_q++;
+    }
+    pad_unlock();
+}
+
+/* Re:Fine 0191: what the queue has done so far, for tools\key_burst.ps1. */
+void cellPad_tap_stats(unsigned* queued, unsigned* given, unsigned* held, unsigned* dropped)
+{
+    if (queued) *queued = s_tap_q;
+    if (given) *given = s_tap_sent;
+    if (held) *held = s_tap_held;
+    if (dropped) *dropped = s_tap_lost;
+}
