 /* One pad into a state; the rest of the struct is a release. */
+/* Re:Fine 0176: a swipe on the touchpad of a PS4 or PS5 pad is a flick of the left stick that way, for as long
+ * as F needs to see one (F's stars are a flick of either stick, its Tutorial). One finger; a swipe is
+ * TOUCH_FLICK_DIST of the pad's width (the height counted in the same millimetres: the pad is about 52 x 23 mm),
+ * and the finger may go on: each further TOUCH_FLICK_DIST is another flick, after the stick was back in the
+ * centre for TOUCH_FLICK_GAP ms. */
+#define TOUCH_FLICK_DIST 0.09f
+#define TOUCH_FLICK_MS   50
+#define TOUCH_FLICK_GAP  40
+static void pad_touch_flick(SDL_Gamepad* gp, PadHostState* hs, int port)
+{
+    static struct { int down; float x0, y0, fx, fy; unsigned long long until, next; } t[PAD_MAX_HOST_PORTS];
+    if (!g_port_touch_stars || SDL_GetNumGamepadTouchpads(gp) < 1) { t[port].down = 0; t[port].until = 0; return; }
+    bool down = false; float x = 0, y = 0, pr = 0;
+    if (!SDL_GetGamepadTouchpadFinger(gp, 0, 0, &down, &x, &y, &pr)) down = false;
+    const unsigned long long now = pad_now_ms();
+    if (!down) t[port].down = 0;
+    else if (!t[port].down) { t[port].down = 1; t[port].x0 = x; t[port].y0 = y; }
+    else {
+        const float dx = x - t[port].x0, dy = (y - t[port].y0) * 0.45f;
+        const float d = sqrtf(dx * dx + dy * dy);
+        if (d >= TOUCH_FLICK_DIST && now >= t[port].next) {
+            t[port].fx = dx / d; t[port].fy = dy / d;
+            t[port].until = now + TOUCH_FLICK_MS; t[port].next = now + TOUCH_FLICK_MS + TOUCH_FLICK_GAP;
+            t[port].x0 = x; t[port].y0 = y;
+            { static int n; if (n++ < 8) fprintf(stderr, "[cellPad] touchpad swipe on port %d: flick (%.2f, %.2f)%c", port, t[port].fx, t[port].fy, 10); }
+        }
+    }
+    if (now < t[port].until) {
+        hs->analog_lx = (u8)(127.5f + t[port].fx * 127.5f);
+        hs->analog_ly = (u8)(127.5f + t[port].fy * 127.5f);
+    }
+}
