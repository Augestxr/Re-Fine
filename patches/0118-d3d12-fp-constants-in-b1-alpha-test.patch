+/* The RSX function a draw's alpha test uses; 0 with the test off. ALWAYS needs no
+ * code in the shader, so it keys like off. */
+static u32 dr_alpha_func(const D3D12DrawRecord* dr)
+{
+    const u32 f = 0x200u | ((dr->alpha_ctl >> 8) & 0xFFu);
+    return ((dr->alpha_ctl >> 16) & 1u) && f != 0x207u ? f : 0;
