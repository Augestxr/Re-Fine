+/* FP_CONST_STATS=<first>-<last> (draws by wall seconds of the run): per program,
+ * draws and distinct inline-constant sets, read when the draw is recorded (side
+ * 0) and when render_frame builds the pipeline key (side 1). A program is its
+ * code hash; the sets are hashed with the code. Printed at <last>. */
+static void fp_const_stats_note(u32 fp_addr, const u8* uc, int side)
+{
+    enum { PROGS = 512, SETS = 4096 };
+    static struct { u32 code, addr, draws[2], n[2]; u32 max_k; } p[PROGS];
+    static u32 sets[2][SETS]; static int np = 0, ns[2] = {0, 0}, on = -1, done = 0;
+    static double t0, from, to;
+    if (on < 0) { const char* e = getenv("FP_CONST_STATS"); on = e ? 1 : 0; t0 = perf_now();
+                  if (e) { from = atof(e); const char* d = strchr(e, '-'); to = d ? atof(d + 1) : from + 60; } }
+    if (!on || done) return;
+    const double now = perf_now() - t0;
+    if (now < from) return;
+    if (now > to) {
+        done = 1;
+        for (int i = 0; i < np; i++)
+            fprintf(stderr, "[FPCONST] code=%08X fp=%08X k=%u draws=%u sets_record=%u pso_calls=%u sets_pso=%u\n",
+                    p[i].code, p[i].addr, p[i].max_k, p[i].draws[0], p[i].n[0], p[i].draws[1], p[i].n[1]);
+        fprintf(stderr, "[FPCONST] programs=%d of %d, sets %d/%d of %d\n", np, PROGS, ns[0], ns[1], SETS);
+        fflush(stderr);
+        return;
+    }
+    const u32 code = rsx_fp_code_hash(uc, 4096);
+    int i = 0;
+    for (; i < np; i++) if (p[i].code == code) break;
+    if (i == np) { if (np == PROGS) return; np++; p[i].code = code; p[i].addr = fp_addr;
+                   float tmp[64 * 4]; p[i].max_k = (u32)rsx_fp_extract_consts(uc, 4096, tmp, 64); }
+    p[i].draws[side]++;
+    u32 usz = rsx_fp_program_size(uc, 4096), h = 2166136261u;
+    if (usz == 0) usz = 64;
+    for (u32 b = 0; b < usz; b++) { h ^= uc[b]; h *= 16777619u; }
+    for (int s = 0; s < ns[side]; s++) if (sets[side][s] == h) return;
+    if (ns[side] < SETS) { sets[side][ns[side]++] = h; p[i].n[side]++; }
+}
