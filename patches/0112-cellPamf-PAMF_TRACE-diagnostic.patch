+
+/* ---------------------------------------------------------------------------
+ * PAMF_TRACE=1: one stderr line per guest call of the functions F uses, with
+ * arguments, return code and what was written to guest memory. Off by default.
+ * -----------------------------------------------------------------------*/
+static int pamf_trace_on(void)
+{
+    static int on = -1;
+    if (on < 0)
+        on = getenv("PAMF_TRACE") != NULL;
+    return on;
+}
+
+s32 cellPamfGetStreamOffsetAndSize(const void* pAddr, u64 fileSize, u64* pOffset, u64* pSize)
+{
+    const s32 rc = pamf_impl_GetStreamOffsetAndSize(pAddr, fileSize, pOffset, pSize);
+    if (pamf_trace_on())
+        fprintf(stderr, "[pamf] GetStreamOffsetAndSize(pAddr=0x%08X, fileSize=0x%llX, pOffset=0x%08X, pSize=0x%08X) -> 0x%08X offset=0x%llX size=0x%llX\n",
+                ea_of(pAddr), (unsigned long long)fileSize, ea_of(pOffset), ea_of(pSize), (u32)rc,
+                pOffset ? (unsigned long long)vm_read64(ea_of(pOffset)) : 0ull,
+                pSize ? (unsigned long long)vm_read64(ea_of(pSize)) : 0ull);
+    return rc;
+}
+
+s32 cellPamfGetHeaderSize2(const void* pAddr, u64 fileSize, u32 attribute, u64* pSize)
+{
+    const s32 rc = pamf_impl_GetHeaderSize2(pAddr, fileSize, attribute, pSize);
+    if (pamf_trace_on())
+        fprintf(stderr, "[pamf] GetHeaderSize2(pAddr=0x%08X, fileSize=0x%llX, attribute=0x%X, pSize=0x%08X) -> 0x%08X size=0x%llX\n",
+                ea_of(pAddr), (unsigned long long)fileSize, attribute, ea_of(pSize), (u32)rc,
+                pSize ? (unsigned long long)vm_read64(ea_of(pSize)) : 0ull);
+    return rc;
+}
+
+s32 cellPamfReaderInitialize(CellPamfReader* reader, const void* pamfAddr,
+                             u64 fileSize, u32 attribute)
+{
+    const s32 rc = pamf_impl_ReaderInitialize(reader, pamfAddr, fileSize, attribute);
+    if (pamf_trace_on())
+        fprintf(stderr, "[pamf] ReaderInitialize(pSelf=0x%08X, pAddr=0x%08X, fileSize=0x%llX, attribute=0x%X) -> 0x%08X\n",
+                ea_of(reader), ea_of(pamfAddr), (unsigned long long)fileSize, attribute, (u32)rc);
+    return rc;
+}
+
+s32 cellPamfReaderSetStreamWithIndex(CellPamfReader* reader, u8 streamIndex)
+{
+    const s32 rc = pamf_impl_ReaderSetStreamWithIndex(reader, streamIndex);
+    if (pamf_trace_on())
+        fprintf(stderr, "[pamf] ReaderSetStreamWithIndex(pSelf=0x%08X, streamIndex=%u) -> 0x%08X\n",
+                ea_of(reader), streamIndex, (u32)rc);
+    return rc;
+}
+
+s32 cellPamfReaderSetStreamWithTypeAndIndex(CellPamfReader* reader, u8 streamType, u8 streamIndex)
+{
+    const s32 rc = pamf_impl_ReaderSetStreamWithTypeAndIndex(reader, streamType, streamIndex);
+    if (pamf_trace_on())
+        fprintf(stderr, "[pamf] ReaderSetStreamWithTypeAndIndex(pSelf=0x%08X, streamType=%u, streamIndex=%u) -> 0x%08X\n",
+                ea_of(reader), streamType, streamIndex, (u32)rc);
+    return rc;
+}
+
+s32 cellPamfReaderGetStreamTypeAndChannel(CellPamfReader* reader, u8* pType, u8* pCh)
+{
+    const s32 rc = pamf_impl_ReaderGetStreamTypeAndChannel(reader, pType, pCh);
+    if (pamf_trace_on())
+        fprintf(stderr, "[pamf] ReaderGetStreamTypeAndChannel(pSelf=0x%08X, pType=0x%08X, pCh=0x%08X) -> 0x%08X type=%u ch=%u\n",
+                ea_of(reader), ea_of(pType), ea_of(pCh), (u32)rc,
+                pType ? vm_read8(ea_of(pType)) : 0u, pCh ? vm_read8(ea_of(pCh)) : 0u);
+    return rc;
+}
+
+s32 cellPamfStreamTypeToEsFilterId(u8 streamType, u8 ch, CellCodecEsFilterId* pEsFilterId)
+{
+    const s32 rc = pamf_impl_StreamTypeToEsFilterId(streamType, ch, pEsFilterId);
+    if (pamf_trace_on() && pEsFilterId) {
+        const u32 e = ea_of(pEsFilterId);
+        fprintf(stderr, "[pamf] StreamTypeToEsFilterId(type=%u, ch=%u, pEsFilterId=0x%08X) -> 0x%08X id=%02X/%02X/%X/%X\n",
+                streamType, ch, e, (u32)rc, vm_read32(e), vm_read32(e + 4), vm_read32(e + 8), vm_read32(e + 12));
+    }
+    return rc;
+}
+
+s32 cellPamfReaderGetStreamInfo(CellPamfReader* reader, void* info, u32 infoSize)
+{
+    const s32 rc = pamf_impl_ReaderGetStreamInfo(reader, info, infoSize);
+    if (pamf_trace_on() && info) {
+        char hex[0x20 * 2 + 1];
+        const u32 n = infoSize < 0x20 ? infoSize : 0x20;
+        for (u32 i = 0; i < n; i++)
+            snprintf(hex + i * 2, 3, "%02X", vm_read8(ea_of(info) + i));
+        hex[n * 2] = '\0';
+        fprintf(stderr, "[pamf] ReaderGetStreamInfo(pSelf=0x%08X, pInfo=0x%08X, size=%u) -> 0x%08X info=%s\n",
+                ea_of(reader), ea_of(info), infoSize, (u32)rc, hex);
+    }
+    return rc;
+}
