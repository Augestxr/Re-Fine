--- /dev/null
+++ b/libs/video/rsx_vk_exec.h
@@ -0,0 +1,36 @@
+/*
+ * Re:Fine N1 (docs/plan_nativo.md): the Vulkan executor's interface to the D3D12 backend's recording.
+ * See rsx_vk_win.c. Only with REFINE_VULKAN on Windows.
+ */
+#ifndef RSX_VK_EXEC_H
+#define RSX_VK_EXEC_H
+
+#include "rsx_commands.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The upload buffers the backend records into, in this order. */
+enum { RSX_VK_VB = 0, RSX_VK_VP_VB, RSX_VK_VP_IB, RSX_VK_VP_CB, RSX_VK_VP_FPCB, RSX_VK_NBUF };
+
+typedef struct rsx_vk_frame {
+    u32 draws;          /* draw records of this batch */
+    u32 vp_vb_bytes;    /* VP vertex bytes written (vp_vb_offset) */
+    u32 vp_indices;     /* indices written (vp_ib_offset) */
+    u32 parity;         /* the half of each buffer this batch used */
+    int present;        /* this batch ends in a present */
+    float clear[4];     /* the backbuffer's clear colour */
+} rsx_vk_frame;
+
+/* 0, or -1 when there is no usable Vulkan (the caller then fails like a D3D12 init would). */
+int  rsx_vk_exec_init(void* hwnd, u32 w, u32 h, const u64 sizes[RSX_VK_NBUF], void* maps[RSX_VK_NBUF]);
+int  rsx_vk_exec_vs(u32 hash, const char* hlsl);
+void rsx_vk_exec_wait(void);
+void rsx_vk_exec_frame(const rsx_vk_frame* f);
+void rsx_vk_exec_resize(u32 w, u32 h);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
