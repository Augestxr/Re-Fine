 #pragma comment(lib, "dxgi.lib")
 #pragma comment(lib, "d3dcompiler.lib")
 
+/* Re:Fine 0123: every shader goes through the disk cache in rsx_shader_cache.h, so
+ * a second run compiles nothing. The bytecode comes from the game's microcode:
+ * it lives outside the repo, in %LOCALAPPDATA%\ReFine\shadercache, and is rebuilt
+ * from the game at will. REFINE_SHADER_CACHE=<dir> moves it, =off disables it.
+ * Only a pipeline-cache miss comes here: no cost on the draw path. */
+#include "rsx_shader_cache.h"
+#include <bcrypt.h>
+#pragma comment(lib, "bcrypt.lib")
+
+static wchar_t s_sc_dir[MAX_PATH];
+static uint64_t s_sc_compiler;
+static volatile LONG s_sc_hits, s_sc_compiles, s_sc_rejects;
+static double sc_now(void)
+{
+    LARGE_INTEGER f, c; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&c);
+    return (double)c.QuadPart / (double)f.QuadPart;
+}
+
+static BOOL CALLBACK sc_init(PINIT_ONCE once, PVOID arg, PVOID* ctx)
+{
+    (void)once; (void)arg; (void)ctx;
+    wchar_t env[MAX_PATH];
+    const DWORD n = GetEnvironmentVariableW(L"REFINE_SHADER_CACHE", env, MAX_PATH);
+    if (n && n < MAX_PATH) {
+        if (_wcsicmp(env, L"off") == 0) return TRUE;
+        wcscpy(s_sc_dir, env);
+        CreateDirectoryW(s_sc_dir, NULL);
+    } else {
+        const DWORD m = GetEnvironmentVariableW(L"LOCALAPPDATA", env, MAX_PATH);
+        if (!m || m >= MAX_PATH - 32) return TRUE;
+        swprintf(s_sc_dir, MAX_PATH, L"%ls\\ReFine", env);
+        CreateDirectoryW(s_sc_dir, NULL);
+        wcscat(s_sc_dir, L"\\shadercache");
+        CreateDirectoryW(s_sc_dir, NULL);
+    }
+    /* The compiler's build: a new d3dcompiler_47.dll must not reuse old output. */
+    const HMODULE dll = GetModuleHandleW(L"d3dcompiler_47.dll");
+    if (dll) {
+        const IMAGE_DOS_HEADER* dos = (const IMAGE_DOS_HEADER*)dll;
+        const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)((const u8*)dll + dos->e_lfanew);
+        s_sc_compiler = ((uint64_t)nt->FileHeader.TimeDateStamp << 32) | nt->OptionalHeader.SizeOfImage;
+    }
+    if (!s_sc_compiler) s_sc_dir[0] = 0;
+    return TRUE;
+}
+
+static int sc_key(const void* src, size_t len, const char* entry, const char* target,
+                  u32 flags1, u32 flags2, u8 key[32])
+{
+    BCRYPT_ALG_HANDLE alg = NULL; BCRYPT_HASH_HANDLE h = NULL; int ok = 0;
+    if (BCryptOpenAlgorithmProvider(&alg, BCRYPT_SHA256_ALGORITHM, NULL, 0) != 0) return 0;
+    if (BCryptCreateHash(alg, &h, NULL, 0, NULL, 0, 0) == 0) {
+        const u32 sizes[4] = { (u32)len, (u32)strlen(entry), flags1, flags2 };
+        ok = BCryptHashData(h, (PUCHAR)sizes, sizeof sizes, 0) == 0 &&
+             BCryptHashData(h, (PUCHAR)&s_sc_compiler, sizeof s_sc_compiler, 0) == 0 &&
+             BCryptHashData(h, (PUCHAR)entry, (ULONG)strlen(entry), 0) == 0 &&
+             BCryptHashData(h, (PUCHAR)target, (ULONG)strlen(target) + 1, 0) == 0 &&
+             BCryptHashData(h, (PUCHAR)src, (ULONG)len, 0) == 0 &&
+             BCryptFinishHash(h, key, 32, 0) == 0;
+        BCryptDestroyHash(h);
+    }
+    BCryptCloseAlgorithmProvider(alg, 0);
+    return ok;
+}
+
+/* D3DCompile's signature, without its macros and include handler (no call passes any). */
+static HRESULT sc_compile(const void* src, SIZE_T len, const char* name, const void* defs,
+                          void* incl, const char* entry, const char* target, UINT f1, UINT f2,
+                          ID3DBlob** code, ID3DBlob** err)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+    InitOnceExecuteOnce(&once, sc_init, NULL, NULL);
+    static int en = -1; if (en < 0) en = getenv("PSO_TIME") ? 1 : 0;
+    const double t0 = sc_now();
+    wchar_t path[MAX_PATH + 72]; u8 key[32];
+    const int cached = s_sc_dir[0] && sc_key(src, len, entry, target, f1, f2, key);
+    if (cached) {
+        wchar_t* w = path + swprintf(path, MAX_PATH, L"%ls\\", s_sc_dir);
+        for (int i = 0; i < 32; i++) w += swprintf(w, 3, L"%02x", key[i]);
+        wcscpy(w, L".dxbc");
+        void* data = NULL; u32 size = 0;
+        const int rc = rsx_sc_load(path, key, s_sc_compiler, &data, &size);
+        if (rc == RSX_SC_HIT) {
+            const HRESULT hr = D3DCreateBlob(size, code);
+            if (SUCCEEDED(hr)) memcpy((*code)->lpVtbl->GetBufferPointer(*code), data, size);
+            free(data);
+            if (SUCCEEDED(hr)) {
+                InterlockedIncrement(&s_sc_hits);
+                if (en) { fprintf(stderr, "[SHC] hit %s %s ms=%.2f%c", name, target, (sc_now() - t0) * 1000.0, 10); fflush(stderr); }
+                return S_OK;
+            }
+        } else if (rc == RSX_SC_REJECTED) {
+            InterlockedIncrement(&s_sc_rejects);
+            fprintf(stderr, "[SHC] rejected %s %s: compiling again%c", name, target, 10);
+        }
+    }
+    const HRESULT hr = D3DCompile(src, len, name, (const D3D_SHADER_MACRO*)defs, (ID3DInclude*)incl,
+                                  entry, target, f1, f2, code, err);
+    InterlockedIncrement(&s_sc_compiles);
+    if (cached && SUCCEEDED(hr) && *code &&
+        !rsx_sc_store(path, key, s_sc_compiler, (*code)->lpVtbl->GetBufferPointer(*code),
+                      (u32)(*code)->lpVtbl->GetBufferSize(*code))) {
+        static int told;
+        if (!told) { told = 1; fprintf(stderr, "[SHC] could not write the cache%c", 10); }
+    }
+    if (en) { fprintf(stderr, "[SHC] compile %s %s ms=%.2f%c", name, target, (sc_now() - t0) * 1000.0, 10); fflush(stderr); }
+    return hr;
+}
+
