diff --git a/libs/video/rsx_shader_cache.h b/libs/video/rsx_shader_cache.h
new file mode 100644
index 00000000..a9448fe3
--- /dev/null
+++ b/libs/video/rsx_shader_cache.h
@@ -0,0 +1,98 @@
+/*
+ * ps3recomp - on-disk cache of compiled shader bytecode (Re:Fine patches/0123)
+ *
+ * One file per shader, named by the hex of its key. The key covers everything
+ * the output depends on (source, entry, target, flags, compiler build), so a
+ * new compiler or a new generator simply misses.
+ *
+ * A file is only trusted if its header and its checksum hold. Anything else --
+ * short, corrupt, another format, another compiler -- is "rejected": the caller
+ * compiles and stores over it. Nothing here can fail the draw.
+ *
+ * Header-only, without D3D, so libs/video/tests can test it alone.
+ */
+#ifndef RSX_SHADER_CACHE_H
+#define RSX_SHADER_CACHE_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <windows.h>
+
+#define RSX_SC_FORMAT 1u
+#define RSX_SC_MAX_SIZE (16u * 1024u * 1024u)
+
+enum { RSX_SC_HIT = 0, RSX_SC_MISSING = -1, RSX_SC_REJECTED = -2 };
+
+typedef struct {
+    char     magic[4];       /* "OFSC" */
+    uint32_t format;
+    uint64_t compiler_id;
+    uint64_t checksum;       /* FNV-1a 64 of the bytecode */
+    uint32_t size;
+    uint32_t reserved;
+    uint8_t  key[32];
+} RsxScHeader;
+
+static uint64_t rsx_sc_fnv64(const void* data, size_t n)
+{
+    const uint8_t* p = (const uint8_t*)data;
+    uint64_t h = 14695981039346656037ull;
+    for (size_t i = 0; i < n; i++) { h ^= p[i]; h *= 1099511628211ull; }
+    return h;
+}
+
+/* The bytecode in a malloc'd buffer, or why not. */
+static int rsx_sc_load(const wchar_t* path, const uint8_t key[32], uint64_t compiler_id,
+                       void** out, uint32_t* out_size)
+{
+    FILE* f = _wfopen(path, L"rb");
+    if (!f) return RSX_SC_MISSING;
+    RsxScHeader h;
+    int rc = RSX_SC_REJECTED;
+    if (fread(&h, 1, sizeof h, f) == sizeof h && memcmp(h.magic, "OFSC", 4) == 0 &&
+        h.format == RSX_SC_FORMAT && h.compiler_id == compiler_id &&
+        memcmp(h.key, key, 32) == 0 && h.size > 0 && h.size <= RSX_SC_MAX_SIZE) {
+        void* data = malloc(h.size);
+        if (data) {
+            if (fread(data, 1, h.size, f) == h.size && fgetc(f) == EOF &&
+                rsx_sc_fnv64(data, h.size) == h.checksum) {
+                *out = data; *out_size = h.size; rc = RSX_SC_HIT;
+            } else {
+                free(data);
+            }
+        }
+    }
+    fclose(f);
+    return rc;
+}
+
+/* Written beside the target and moved over it, so a crash or a second process
+ * leaves the old file or the new one, never half of one. 1 = stored. */
+static int rsx_sc_store(const wchar_t* path, const uint8_t key[32], uint64_t compiler_id,
+                        const void* data, uint32_t size)
+{
+    static volatile LONG seq;
+    wchar_t tmp[MAX_PATH + 32];
+    swprintf(tmp, sizeof tmp / sizeof tmp[0], L"%ls.%lu.%ld.tmp", path,
+             (unsigned long)GetCurrentProcessId(), InterlockedIncrement(&seq));
+    FILE* f = _wfopen(tmp, L"wb");
+    if (!f) return 0;
+    RsxScHeader h;
+    memset(&h, 0, sizeof h);
+    memcpy(h.magic, "OFSC", 4);
+    h.format = RSX_SC_FORMAT;
+    h.compiler_id = compiler_id;
+    h.checksum = rsx_sc_fnv64(data, size);
+    h.size = size;
+    memcpy(h.key, key, 32);
+    const int ok = fwrite(&h, 1, sizeof h, f) == sizeof h && fwrite(data, 1, size, f) == size;
+    if (fclose(f) != 0 || !ok || !MoveFileExW(tmp, path, MOVEFILE_REPLACE_EXISTING)) {
+        DeleteFileW(tmp);
+        return 0;
+    }
+    return 1;
+}
+
+#endif /* RSX_SHADER_CACHE_H */
diff --git a/libs/video/tests/test_shader_cache.c b/libs/video/tests/test_shader_cache.c
new file mode 100644
index 00000000..2169f38a
--- /dev/null
+++ b/libs/video/tests/test_shader_cache.c
@@ -0,0 +1,76 @@
+/*
+ * test_shader_cache - rsx_shader_cache.h: what comes back is what went in, and a
+ * damaged or foreign file is refused, never trusted and never fatal.
+ *
+ * clang-cl -I libs/video libs/video/tests/test_shader_cache.c -Fe:test_shader_cache.exe
+ */
+#include "rsx_shader_cache.h"
+
+static const wchar_t* PATH = L"test_shader_cache.bin";
+static int fails;
+
+#define CHECK(c) do { if (!(c)) { printf("FALLO linea %d: %s\n", __LINE__, #c); fails++; } } while (0)
+
+static void poke(long off, int whence, unsigned char v)
+{
+    FILE* f = _wfopen(PATH, L"r+b");
+    fseek(f, off, whence); fputc(v, f); fclose(f);
+}
+
+static void truncate_to(long n)
+{
+    HANDLE h = CreateFileW(PATH, GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL);
+    SetFilePointer(h, n, NULL, FILE_BEGIN); SetEndOfFile(h); CloseHandle(h);
+}
+
+int main(void)
+{
+    uint8_t key[32], other[32], data[4096];
+    for (int i = 0; i < 32; i++) { key[i] = (uint8_t)i; other[i] = (uint8_t)(i + 1); }
+    for (int i = 0; i < 4096; i++) data[i] = (uint8_t)(i * 7);
+    void* out = NULL; uint32_t n = 0;
+    const uint64_t id = 0x1122334455667788ull;
+
+    DeleteFileW(PATH);
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_MISSING);
+
+    CHECK(rsx_sc_store(PATH, key, id, data, sizeof data) == 1);
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_HIT);
+    CHECK(n == sizeof data && memcmp(out, data, n) == 0);
+    free(out);
+
+    /* otro compilador, otra clave */
+    CHECK(rsx_sc_load(PATH, key, id + 1, &out, &n) == RSX_SC_REJECTED);
+    CHECK(rsx_sc_load(PATH, other, id, &out, &n) == RSX_SC_REJECTED);
+
+    /* un byte del bytecode, del formato, de la cabecera */
+    poke(-1, SEEK_END, 0x5A);
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_REJECTED);
+    CHECK(rsx_sc_store(PATH, key, id, data, sizeof data) == 1);
+    poke(4, SEEK_SET, 0x7F);
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_REJECTED);
+    CHECK(rsx_sc_store(PATH, key, id, data, sizeof data) == 1);
+    poke(0, SEEK_SET, 'X');
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_REJECTED);
+
+    /* cortado por la mitad, por la cabecera, vacio; con bytes de mas */
+    CHECK(rsx_sc_store(PATH, key, id, data, sizeof data) == 1);
+    truncate_to(2000);
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_REJECTED);
+    truncate_to(10);
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_REJECTED);
+    truncate_to(0);
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_REJECTED);
+    CHECK(rsx_sc_store(PATH, key, id, data, sizeof data) == 1);
+    { FILE* f = _wfopen(PATH, L"ab"); fputc(1, f); fclose(f); }
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_REJECTED);
+
+    /* reescribir encima lo arregla */
+    CHECK(rsx_sc_store(PATH, key, id, data, sizeof data) == 1);
+    CHECK(rsx_sc_load(PATH, key, id, &out, &n) == RSX_SC_HIT);
+    free(out);
+
+    DeleteFileW(PATH);
+    printf("test_shader_cache: %s\n", fails ? "FALLO" : "OK");
+    return fails != 0;
+}
