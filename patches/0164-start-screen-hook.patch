 }
 
 
+/* Re:Fine 0164: one frame of the start screen. The title has not drawn anything yet (this runs on its
+ * thread, inside cellGcmInit), so the GPU is idle, nothing else records on the list, and the swap
+ * buffer is where the swap chain leaves it. */
+void (*g_port_launcher)(void);
+void rsx_d3d12_launcher_frame(void)
+{
+    if (!s_d3d.swap_chain) return;
+    wait_for_gpu();
+    swap_chain_resize();
+    const u32 fi = s_d3d.frame_index;
+    s_d3d.cmd_allocators[fi]->lpVtbl->Reset(s_d3d.cmd_allocators[fi]);
+    s_d3d.cmd_list->lpVtbl->Reset(s_d3d.cmd_list, s_d3d.cmd_allocators[fi], NULL);
+    ID3D12GraphicsCommandList* cl = s_d3d.cmd_list;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.pResource   = s_d3d.swap_buffers[fi];
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+    b.Transition.StateAfter  = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv;
+    s_d3d.swap_rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_d3d.swap_rtv_heap, &rtv);
+    rtv.ptr += fi * s_d3d.rtv_descriptor_size;
+    cl->lpVtbl->OMSetRenderTargets(cl, 1, &rtv, FALSE, NULL);
+    static const float dark[4] = {0.043f, 0.047f, 0.063f, 1.0f};
+    cl->lpVtbl->ClearRenderTargetView(cl, rtv, dark, 0, NULL);
+    D3D12_VIEWPORT vp = {0.0f, 0.0f, (float)s_d3d.win_w, (float)s_d3d.win_h, 0.0f, 1.0f};
+    D3D12_RECT sc = {0, 0, (LONG)s_d3d.win_w, (LONG)s_d3d.win_h};
+    cl->lpVtbl->RSSetViewports(cl, 1, &vp);
+    cl->lpVtbl->RSSetScissorRects(cl, 1, &sc);
+    if (g_port_overlay_active && g_port_overlay_draw) {
+        port_overlay_frame of = { s_d3d.device, cl, (uint64_t)rtv.ptr, s_d3d.win_w, s_d3d.win_h,
+                                  fi, FRAME_COUNT, (uint32_t)DXGI_FORMAT_R8G8B8A8_UNORM };
+        g_port_overlay_draw(&of);
+    }
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter  = D3D12_RESOURCE_STATE_PRESENT;
+    cl->lpVtbl->ResourceBarrier(cl, 1, &b);
+    cl->lpVtbl->Close(cl);
+    ID3D12CommandList* lists[] = {(ID3D12CommandList*)cl};
+    s_d3d.cmd_queue->lpVtbl->ExecuteCommandLists(s_d3d.cmd_queue, 1, lists);
+    s_d3d.swap_chain->lpVtbl->Present(s_d3d.swap_chain, 1, 0);
+    move_to_next_frame();
+}
+
 /* Re:Fine 0150, diagnostic only: FRAME_PROF. Running totals in seconds of the phases of
  * render_frame, read by src/main.cpp on this same thread. gpu is the time between
  * two timestamps at the ends of the command list. */
@@ -9226,6 +9271,7 @@ int rsx_d3d12_backend_init(u32 width, u32 height, const char* title)
     s_d3d.last_fps_time = GetTickCount64();
 
     printf("[D3D12] Backend ready: %ux%u\n", width, height);
+    if (g_port_launcher) g_port_launcher();   /* Re:Fine 0164 */
     return 0;
 }
 
