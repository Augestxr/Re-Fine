diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index cc23d4ed..02d86888 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -3139,6 +3139,99 @@ static u32 rsx_remap_to_d3d(u32 c1, u32 basef)
  * NV40 layout (matches RPCS3 convert_linear_swizzle). POT dims only, which is
  * what the hardware requires for swizzled textures. */
 
+/* Re:Fine 0127, diagnostic only: TEX_RACE=<file>[,<hex ea>] (default ea 0xC713EC00)
+ * timestamps what touches one texture: `put`, the first and last row of the
+ * guest's copy (seen by a spinning watcher thread), the draw that records it,
+ * labels, flips, and the upload, with a signature per row of what was read. It
+ * answers whether an upload saw one picture whole. Off unless the variable is
+ * set; the spin is the diagnostic's own and never runs otherwise. Binary records:
+ * i64 qpc, u32 type, a, b, nsig, then nsig u32. tools/tex_race.py reads them. */
+enum { TR_PUT = 1, TR_TOP, TR_BOT, TR_REC, TR_LABEL, TR_FLIP, TR_UP, TR_PIC, TR_DRAIN,
+       TR_DRAIN_END, TR_UP_SRC };
+#define TR_W 1280u
+#define TR_H 720u
+#define TR_NSIG (TR_H / 4u)
+static FILE*   s_tr_f;
+static u32     s_tr_ea;
+static SRWLOCK s_tr_lock = SRWLOCK_INIT;
+
+void tex_race_event(u32 type, u32 a, u32 b, const u32* sig, u32 nsig)
+{
+    if (!s_tr_f) return;
+    struct { long long t; u32 type, a, b, n; } r;
+    LARGE_INTEGER q; QueryPerformanceCounter(&q);
+    r.t = q.QuadPart; r.type = type; r.a = a; r.b = b; r.n = sig ? nsig : 0;
+    AcquireSRWLockExclusive(&s_tr_lock);
+    fwrite(&r, sizeof r, 1, s_tr_f);
+    if (sig) fwrite(sig, 4, nsig, s_tr_f);
+    ReleaseSRWLockExclusive(&s_tr_lock);
+}
+
+/* One hash per fourth row. The bytes of a pixel are summed, so the guest's
+ * order and the decoded one give the same signature. */
+static void tex_race_sig(const u8* p, u32 pitch, u32* out)
+{
+    for (u32 y = 0; y < TR_NSIG; y++) {
+        const u8* r = p + (u64)y * 4u * pitch;
+        u32 h = 2166136261u;
+        for (u32 x = 0; x < TR_W; x++, r += 4)
+            h = (h ^ (u32)(r[0] + r[1] + r[2] + r[3])) * 16777619u;
+        out[y] = h;
+    }
+}
+
+void tex_race_pic(const u8* p, u32 n)
+{
+    if (!s_tr_f) return;
+    static u32 sig[TR_NSIG];
+    tex_race_sig(p, TR_W * 4u, sig);
+    tex_race_event(TR_PIC, n, 0, sig, TR_NSIG);
+}
+
+static DWORD WINAPI tex_race_watch(LPVOID base)
+{
+    const u8* top = (const u8*)base + TR_W * 4u * 2u;
+    const u8* bot = (const u8*)base + TR_W * 4u * (TR_H - 2u);
+    extern u32 vm_read32(u32);
+    extern u32 tex_race_put_ea(void);
+    extern void ppu_report_guest_lrs(void);
+    const u32 pa = tex_race_put_ea();
+    u64 lt = 0, lb = 0; u32 lp = 0; int said = 0;
+    for (;;) {
+        u64 t = 0, b = 0;
+        for (u32 i = 0; i < 1024u; i += 8u) {
+            t = t * 31u + *(const volatile u64*)(top + i * 4u);
+            b = b * 31u + *(const volatile u64*)(bot + i * 4u);
+        }
+        const u32 put = vm_read32(pa);
+        if (put != lp) { lp = put; tex_race_event(TR_PUT, put, 0, NULL, 0); }
+        if (t != lt) { lt = t; tex_race_event(TR_TOP, 0, 0, NULL, 0);
+                       if (said++ < 40 && said > 20) ppu_report_guest_lrs(); }
+        if (b != lb) { lb = b; tex_race_event(TR_BOT, 0, 0, NULL, 0); }
+    }
+}
+
+static void tex_race_init(void)
+{
+    static int done;
+    if (done) return;
+    done = 1;
+    const char* e = getenv("TEX_RACE");
+    if (!e) return;
+    char path[512]; strncpy(path, e, sizeof path - 1); path[sizeof path - 1] = 0;
+    s_tr_ea = 0xC713EC00u;
+    char* c = strrchr(path, ',');
+    if (c) { *c = 0; s_tr_ea = (u32)strtoul(c + 1, NULL, 16); }
+    s_tr_f = fopen(path, "wb");
+    if (!s_tr_f) return;
+    setvbuf(s_tr_f, NULL, _IOFBF, 1 << 20);
+    { LARGE_INTEGER f; QueryPerformanceFrequency(&f);
+      struct { long long t; u32 type, a, b, n; } r = { f.QuadPart, 0, s_tr_ea, 0, 0 };
+      fwrite(&r, sizeof r, 1, s_tr_f); }
+    extern uint8_t* vm_base;
+    CreateThread(NULL, 64u * 1024, tex_race_watch, vm_base + s_tr_ea, 0, NULL);
+}
+
