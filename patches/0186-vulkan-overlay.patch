+    const void* grad;                /* NULL, or the 352 bytes of the gradient block (b1) */
+} rsx_vk_ui_cmd;
+u32  rsx_vk_ui_texture(const unsigned char* rgba, u32 w, u32 h);
+void rsx_vk_ui_texture_free(u32 id);
+void rsx_vk_ui_draw(const rsx_vk_ui_cmd* c);
+extern void (*g_rsx_vk_ui)(u32 w, u32 h);
