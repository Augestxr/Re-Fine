diff --git a/libs/codec/tests/test_cellDmux.c b/libs/codec/tests/test_cellDmux.c
new file mode 100644
index 00000000..68c21a7b
--- /dev/null
+++ b/libs/codec/tests/test_cellDmux.c
@@ -0,0 +1,690 @@
+/*
+ * ps3recomp -- cellDmux against synthetic MPEG-PS packs
+ *
+ * Builds packs in the on-disc layout in a fake guest memory and drives the guest
+ * API from the main thread while dmux_pamf calls back: a start code split between
+ * packs, an AU split between PES packets, ATRAC3plus framing, a queue forced to
+ * two AUs with a slow consumer (no AU lost, in order, DEMUX_DONE after the last),
+ * the ring wrapping with AUs staying contiguous, flush, reset, discontinuity and
+ * closing with dmux_pamf asleep on a full queue.
+ *
+ * With a file argument it instead demuxes that .pam in 0x80000-byte sections, as
+ * F does, and prints what it finds (no game data ships with the repo). A second
+ * argument names a file to get one "size pts" line per audio AU.
+ *
+ * Build (from the repo root; no runtime lib needed):
+ *   clang-cl /O2 -w /Iinclude libs/codec/tests/test_cellDmux.c
+ *   test_cellDmux.exe [file.pam [audio.txt]]
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint8_t* vm_base;
+#ifndef DMUX_AU_QUEUE_MAX
+#define DMUX_AU_QUEUE_MAX 2u
+#endif
+#include "../cellDmux.c"
+
+/* The guest-memory accessors' hooks into the PPU/SPU runtime; inert here. */
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+void spu_lockline_lock_ea(uint32_t ea, uint32_t len) { (void)ea; (void)len; }
+void spu_lockline_unlock_ea(uint32_t ea, uint32_t len) { (void)ea; (void)len; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+
+#define CHECK(c) do { if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); exit(1); } } while (0)
+#define CHECK_RC(e, want) do { s32 _r = (s32)(e); if (_r != (s32)(want)) { \
+    printf("FAIL %s:%d: %s = 0x%08X, want 0x%08X\n", __FILE__, __LINE__, #e, (u32)_r, (u32)(want)); \
+    exit(1); } } while (0)
+
+enum {
+    MEM = 64u << 20,
+    G_TYPE = 0x1000, G_RES = 0x1010, G_CB = 0x1030, G_OUT = 0x1040, G_ID = 0x1050, G_SPEC = 0x1070,
+    G_ESRES = 0x1080, G_ESCB = 0x1090, G_ATTR = 0x10A0, G_AUP = 0x10B0, G_SPP = 0x10B8,
+    G_DMUXMEM = 0x2000,
+    G_VIDEO = 0x10000, G_AUDIO = 0x800000,
+    G_STREAM = 0x1000000,
+    OPD_DMUX = 0x100, OPD_V = 0x110, OPD_A = 0x120,
+};
+
+#define GP(ea) ((void*)(uintptr_t)(ea))
+
+/* ---------------------------------------------------------------------------
+ * Events from dmux_pamf
+ * -----------------------------------------------------------------------*/
+
+enum { EV_DONE, EV_FATAL, EV_PROGEND, EV_AU_V, EV_AU_A, EV_FLUSH_V, EV_FLUSH_A };
+
+static volatile LONG ev_n;
+static u8 ev_log[1 << 20];
+static volatile LONG ev_count[8];
+static u64 last_user_data;
+
+static void caller(uint32_t opd, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3,
+                   uint64_t a4, uint64_t a5, uint64_t a6, uint64_t a7)
+{
+    int ev;
+    if (opd == OPD_DMUX) {
+        const u32 t = vm_read32((u32)a1);
+        last_user_data = vm_read64((u32)a1 + 8);
+        CHECK(a2 == 0xD0D0);
+        ev = t == CELL_DMUX_MSG_TYPE_DEMUX_DONE ? EV_DONE
+           : t == CELL_DMUX_MSG_TYPE_FATAL_ERR ? EV_FATAL : EV_PROGEND;
+    } else {
+        const u32 t = vm_read32((u32)a2);
+        CHECK(a3 == (opd == OPD_V ? 0xAAAAu : 0xBBBBu));
+        ev = t == CELL_DMUX_ES_MSG_TYPE_AU_FOUND ? (opd == OPD_V ? EV_AU_V : EV_AU_A)
+                                                 : (opd == OPD_V ? EV_FLUSH_V : EV_FLUSH_A);
+    }
+    ev_log[ev_n] = (u8)ev;
+    InterlockedIncrement(&ev_count[ev]);
+    InterlockedIncrement(&ev_n);
+}
+
+static void reset_events(void)
+{
+    ev_n = 0;
+    memset((void*)ev_count, 0, sizeof ev_count);
+}
+
+#define WAIT_FOR(cond) do { DWORD _t = GetTickCount(); while (!(cond)) { \
+    if (GetTickCount() - _t > 10000) { printf("TIMEOUT %s:%d: %s\n", __FILE__, __LINE__, #cond); exit(1); } \
+    Sleep(1); } } while (0)
+
+/* ---------------------------------------------------------------------------
+ * Building streams
+ * -----------------------------------------------------------------------*/
+
+static u32 s_wp;   /* write position in G_STREAM */
+
+static void put_ts(u8* p, u32 flag, u32 ts)
+{
+    p[0] = (u8)(flag << 4 | ((ts >> 30) & 3u) << 1 | 1u);
+    p[1] = (u8)(ts >> 22);
+    p[2] = (u8)((ts >> 14) | 1u);
+    p[3] = (u8)(ts >> 7);
+    p[4] = (u8)((ts << 1) | 1u);
+}
+
+/* One pack of 0x800 bytes with one PES. pts < 0: no PTS. `sub` < 0: video. */
+static void emit_pes(int sub, const u8* data, u32 len, int64_t pts, int rap)
+{
+    u8* p = vm_base + G_STREAM + s_wp;
+    memset(p, 0xFF, PACK_SIZE);
+    p[0] = 0; p[1] = 0; p[2] = 1; p[3] = 0xBA;
+    p[0xD] = 0xF8;
+    u32 off = 0xE;
+    if (rap) {
+        static const u8 sys[6 + 6] = { 0,0,1,0xBB, 0,6, 1,2,3,4,5,6 };
+        memcpy(p + off, sys, sizeof sys);
+        off += sizeof sys;
+        static const u8 ps2[6 + 2] = { 0,0,1,0xBF, 0,2, 0xE0,0x00 };
+        memcpy(p + off, ps2, sizeof ps2);
+        off += sizeof ps2;
+    }
+    const u32 hdr = pts >= 0 ? 5u : 0u;
+    const u32 extra = sub >= 0 ? AUDIO_PES_HEADER : 0u;
+    CHECK(off + 9u + hdr + extra + len <= PACK_SIZE);
+    u8* pes = p + off;
+    pes[0] = 0; pes[1] = 0; pes[2] = 1; pes[3] = sub >= 0 ? 0xBD : 0xE0;
+    const u32 pes_len = 3u + hdr + extra + len;
+    pes[4] = (u8)(pes_len >> 8); pes[5] = (u8)pes_len;
+    pes[6] = 0x81; pes[7] = pts >= 0 ? 0x80 : 0; pes[8] = (u8)hdr;
+    if (pts >= 0)
+        put_ts(pes + 9, 2, (u32)pts);
+    u8* d = pes + 9 + hdr;
+    if (sub >= 0) {
+        d[0] = (u8)sub; d[1] = 0; d[2] = 0; d[3] = 0;
+        d += AUDIO_PES_HEADER;
+    }
+    memcpy(d, data, len);
+    s_wp += PACK_SIZE;
+}
+
+/* Payload bytes that hold no start code and no ATRAC3plus sync word. */
+static void fill(u8* p, u32 n, u32 seed)
+{
+    for (u32 i = 0; i < n; i++)
+        p[i] = (u8)(0x80u | ((i + seed * 7u) & 0x3Fu));
+}
+
+/* Video bytes -> packs, `chunk` bytes per pack, PTS on the first of each. */
+static void emit_video(const u8* data, u32 len, u32 chunk, int64_t pts)
+{
+    for (u32 i = 0; i < len; i += chunk) {
+        emit_pes(-1, data + i, len - i < chunk ? len - i : chunk, i == 0 ? pts : -1, 0);
+        pts = -1;
+    }
+}
+
+/* A picture: start code + `body` bytes. */
+static u32 make_pic(u8* out, u32 body, u32 seed)
+{
+    out[0] = 0; out[1] = 0; out[2] = 1; out[3] = 0;
+    fill(out + 4, body, seed);
+    return 4 + body;
+}
+
+static u32 make_at3p(u8* out, u32 size, u32 seed)
+{
+    const u32 h = (size - 8) / 8 - 1;
+    out[0] = AT3P_SYNC_HI; out[1] = AT3P_SYNC_LO;
+    out[2] = (u8)(h >> 8); out[3] = (u8)h;
+    fill(out + 4, size - 4, seed);
+    return size;
+}
+
+/* ---------------------------------------------------------------------------
+ * Driving the API
+ * -----------------------------------------------------------------------*/
+
+static u32 h_dmux, h_v, h_a;
+
+static void open_dmux(int profile)
+{
+    vm_write32(G_TYPE, CELL_DMUX_STREAM_TYPE_PAMF);
+    CHECK_RC(cellDmuxQueryAttr(GP(G_TYPE), GP(G_ATTR)), CELL_OK);
+    CHECK(vm_read32(G_ATTR + 4) == 0x260000u && vm_read32(G_ATTR + 8) == 0x280000u);
+    vm_write32(G_RES, G_DMUXMEM);
+    vm_write32(G_RES + 4, vm_read32(G_ATTR));
+    vm_write32(G_CB, OPD_DMUX);
+    vm_write32(G_CB + 4, 0xD0D0);
+    CHECK_RC(cellDmuxOpen(GP(G_TYPE), GP(G_RES), GP(G_CB), GP(G_OUT)), CELL_OK);
+    h_dmux = vm_read32(G_OUT);
+    CHECK(h_dmux);
+
+    vm_write32(G_ID, 0xE0); vm_write32(G_ID + 4, 0); vm_write32(G_ID + 8, 0); vm_write32(G_ID + 12, 0);
+    vm_write32(G_SPEC, (u32)profile);
+    CHECK_RC(cellDmuxQueryEsAttr(GP(G_TYPE), GP(G_ID), GP(G_SPEC), GP(G_ATTR)), CELL_OK);
+    CHECK(vm_read32(G_ATTR) >= (profile > 1 ? 0x255000u : 0x70000u) + (DMUX_AU_QUEUE_MAX + 1) * 0x28);
+    vm_write32(G_ESRES, G_VIDEO);
+    vm_write32(G_ESRES + 4, vm_read32(G_ATTR));
+    vm_write32(G_ESCB, OPD_V);
+    vm_write32(G_ESCB + 4, 0xAAAA);
+    CHECK_RC(cellDmuxEnableEs(h_dmux, GP(G_ID), GP(G_ESRES), GP(G_ESCB), GP(G_SPEC), GP(G_OUT)), CELL_OK);
+    h_v = vm_read32(G_OUT);
+
+    /* The same ES twice is refused. */
+    CHECK_RC(cellDmuxEnableEs(h_dmux, GP(G_ID), GP(G_ESRES), GP(G_ESCB), GP(G_SPEC), GP(G_OUT)),
+             CELL_DMUX_ERROR_ARG);
+
+    vm_write32(G_ID, 0xBD);
+    CHECK_RC(cellDmuxQueryEsAttr(GP(G_TYPE), GP(G_ID), 0, GP(G_ATTR)), CELL_OK);
+    CHECK(vm_read32(G_ATTR) >= 0x6400u);
+    vm_write32(G_ESRES, G_AUDIO);
+    vm_write32(G_ESRES + 4, vm_read32(G_ATTR));
+    vm_write32(G_ESCB, OPD_A);
+    vm_write32(G_ESCB + 4, 0xBBBB);
+    CHECK_RC(cellDmuxEnableEs(h_dmux, GP(G_ID), GP(G_ESRES), GP(G_ESCB), 0, GP(G_OUT)), CELL_OK);
+    h_a = vm_read32(G_OUT);
+
+    reset_events();
+    s_wp = 0;
+}
+
+static void close_dmux(void)
+{
+    CHECK_RC(cellDmuxDisableEs(h_a), CELL_OK);
+    CHECK_RC(cellDmuxDisableEs(h_v), CELL_OK);
+    CHECK_RC(cellDmuxDisableEs(h_v), CELL_DMUX_ERROR_ARG);
+    CHECK_RC(cellDmuxClose(h_dmux), CELL_OK);
+    CHECK_RC(cellDmuxClose(h_dmux), CELL_DMUX_ERROR_ARG);
+}
+
+static void feed(int discontinuity, u64 user)
+{
+    CHECK_RC(cellDmuxSetStream(h_dmux, G_STREAM, s_wp, (u32)discontinuity, user), CELL_OK);
+}
+
+typedef struct { u32 addr, size, rap; u64 pts, dts, user; } Au;
+
+/* cellDmuxGetAuEx, read back through what the title reads. */
+static s32 get_au(u32 es, Au* au)
+{
+    const s32 r = cellDmuxGetAuEx(es, GP(G_AUP), GP(G_SPP));
+    if (r != CELL_OK)
+        return r;
+    const u32 i = vm_read32(G_AUP);
+    CHECK(vm_read32(G_SPP) != 0);
+    au->addr = vm_read32(i + 0x00);
+    au->size = vm_read32(i + 0x04);
+    CHECK(vm_read32(i + 0x08) == 0);       /* auMaxSize */
+    au->rap  = vm_read8(i + 0x0C);
+    au->user = vm_read64(i + 0x10);
+    au->pts  = vm_read64(i + 0x18);
+    au->dts  = vm_read64(i + 0x20);
+    return r;
+}
+
+static void expect_au(u32 es, const u8* want, u32 size, u64 pts, int rap)
+{
+    Au au;
+    WAIT_FOR(get_au(es, &au) == CELL_OK);
+    CHECK(au.size == size);
+    CHECK(au.pts == pts);
+    CHECK((int)au.rap == rap);
+    CHECK(memcmp(vm_base + au.addr, want, size) == 0);
+    CHECK_RC(cellDmuxReleaseAu(es), CELL_OK);
+}
+
+/* ---------------------------------------------------------------------------
+ * The cases
+ * -----------------------------------------------------------------------*/
+
+static u8 a1[0x4000], a2[0x4000], a3[0x4000], joined[0x20000];
+
+/* AU split between PES packets, and the delimiter split between packs in every
+ * possible place. PTS goes with the PES where the AU is discovered. */
+static void test_split(void)
+{
+    for (u32 cut = 1; cut <= 3; cut++) {
+        open_dmux(3);
+        const u32 s1 = make_pic(a1, 0x900, 1), s2 = make_pic(a2, 0x900, 2), s3 = make_pic(a3, 0x10, 3);
+        memcpy(joined, a1, s1);
+        memcpy(joined + s1, a2, s2);
+        memcpy(joined + s1 + s2, a3, s3);
+
+        /* First pack ends `cut` bytes into the start code of the second picture. */
+        emit_pes(-1, joined, 0x7C0, 0x1000, 1);
+        emit_pes(-1, joined + 0x7C0, s1 + cut - 0x7C0, -1, 0);
+        emit_pes(-1, joined + s1 + cut, 0x7C0, 0x2000, 0);
+        emit_pes(-1, joined + s1 + cut + 0x7C0, s2 + s3 - cut - 0x7C0, 0x3000, 0);
+        CHECK(s_wp == 4 * PACK_SIZE);
+        feed(1, 0x77);
+        WAIT_FOR(ev_count[EV_DONE] == 1);
+        CHECK(last_user_data == 0x77);
+        CHECK(ev_count[EV_AU_V] == 2);
+
+        /* The second picture's start was discovered in the third pack. */
+        expect_au(h_v, a1, s1, 0x1000, 1);
+        expect_au(h_v, a2, s2, 0x2000, 0);
+        Au au;
+        CHECK_RC(get_au(h_v, &au), CELL_DMUX_ERROR_EMPTY);
+        CHECK_RC(cellDmuxReleaseAu(h_v), CELL_DMUX_ERROR_SEQ);
+
+        /* The last picture has no delimiter behind it: flush hands it over. */
+        CHECK_RC(cellDmuxFlushEs(h_v), CELL_OK);
+        WAIT_FOR(ev_count[EV_FLUSH_V] == 1);
+        CHECK(ev_count[EV_AU_V] == 3);
+        expect_au(h_v, a3, s3, 0x3000, 0);
+        /* A second flush has nothing to hand over but is still answered. */
+        CHECK_RC(cellDmuxFlushEs(h_v), CELL_OK);
+        WAIT_FOR(ev_count[EV_FLUSH_V] == 2);
+        CHECK(ev_count[EV_AU_V] == 3);
+        close_dmux();
+    }
+}
+
+/* A sequence header stays with the picture after it; a sequence end stays with
+ * the picture before it. */
+static void test_sequence(void)
+{
+    open_dmux(3);
+    u32 n = 0;
+    const u8 seq[8] = { 0,0,1,0xB3, 0x50,0x02,0xD0,0x13 };
+    memcpy(joined, seq, 8); n = 8;
+    n += make_pic(joined + n, 0x20, 1);
+    const u32 first = n;
+    n += make_pic(joined + n, 0x30, 2);
+    const u8 end[4] = { 0,0,1,0xB7 };
+    memcpy(joined + n, end, 4); n += 4;
+    const u32 second = n - first;
+    emit_pes(-1, joined, n, 0x5000, 0);
+    /* Something after the end, or the last 3 bytes never get searched. */
+    const u8 tail[8] = { 0x80,0x81,0x82,0x83,0x84,0x85,0x86,0x87 };
+    emit_pes(-1, tail, 8, -1, 0);
+    feed(1, 1);
+    WAIT_FOR(ev_count[EV_DONE] == 1);
+    CHECK(ev_count[EV_AU_V] == 2);
+    expect_au(h_v, joined, first, 0x5000, 0);
+    expect_au(h_v, joined + first, second, DMUX_TS_INVALID, 0);
+    close_dmux();
+}
+
+static void test_audio(void)
+{
+    open_dmux(3);
+    enum { N = 40, SZ = 0x2B8 };
+    static u8 s[N * SZ];
+    u32 n = 0;
+    for (u32 i = 0; i < N; i++)
+        n += make_at3p(s + n, SZ, i);
+    /* Frames cross the PES boundaries. Each PES has a PTS. */
+    u32 chunk = 0x7D0 - 0x40;
+    for (u32 i = 0, k = 0; i < n; i += chunk, k++)
+        emit_pes(0, s + i, n - i < chunk ? n - i : chunk, 0x14DDE + k * 0x1000, 0);
+    feed(1, 2);
+    WAIT_FOR(ev_count[EV_DONE] == 1 || ev_count[EV_AU_A] >= (LONG)DMUX_AU_QUEUE_MAX);
+    for (u32 i = 0; i + 1 < N; i++) {
+        Au au;
+        WAIT_FOR(get_au(h_a, &au) == CELL_OK);
+        CHECK(au.size == SZ);
+        CHECK(memcmp(vm_base + au.addr, s + i * SZ, SZ) == 0);
+        if (i == 0)
+            CHECK(au.pts == 0x14DDE);
+        CHECK_RC(cellDmuxReleaseAu(h_a), CELL_OK);
+    }
+    WAIT_FOR(ev_count[EV_DONE] == 1);
+    CHECK_RC(cellDmuxFlushEs(h_a), CELL_OK);
+    WAIT_FOR(ev_count[EV_FLUSH_A] == 1);
+    Au au;
+    WAIT_FOR(get_au(h_a, &au) == CELL_OK);
+    CHECK(au.size == SZ);
+    CHECK(memcmp(vm_base + au.addr, s + (N - 1) * SZ, SZ) == 0);
+    CHECK_RC(cellDmuxReleaseAu(h_a), CELL_OK);
+
+    /* A frame whose size is wrong is not a frame: it is dropped and the search
+     * goes on. */
+    s_wp = 0;
+    reset_events();
+    u32 m = 0;
+    for (u32 i = 0; i < 12; i++)
+        m += make_at3p(s + m, 0x40, i);
+    s[2] = 0; s[3] = 0x20;               /* says 0x110, and at 0x110 there is no sync */
+    emit_pes(0, s, m, 0x100, 0);
+    const u8 tail[8] = { 0x80,0x81,0x82,0x83,0x84,0x85,0x86,0x87 };
+    emit_pes(0, tail, 8, -1, 0);
+    feed(0, 3);
+    u32 cut = 0;
+    while (ev_count[EV_DONE] < 1 || get_au(h_a, &au) == CELL_OK) {
+        if (get_au(h_a, &au) != CELL_OK)
+            continue;
+        CHECK(au.size == 0x40);
+        cut++;
+        CHECK_RC(cellDmuxReleaseAu(h_a), CELL_OK);
+    }
+    CHECK(ev_count[EV_FATAL] == 0);
+    CHECK(cut >= 9);                     /* every frame but the bad one and the open one */
+    close_dmux();
+}
+
+/* The queue holds DMUX_AU_QUEUE_MAX AUs. dmux_pamf has to sleep; nothing is lost
+ * and DEMUX_DONE comes after the last AU. */
+static void test_queue_full(void)
+{
+    enum { N = 25 };
+    open_dmux(3);
+    static u32 size[N];
+    static u32 at[N];
+    u32 n = 0;
+    for (u32 i = 0; i < N; i++) {
+        at[i] = n;
+        size[i] = make_pic(joined + n, 0x100 + i * 3, i);
+        n += size[i];
+    }
+    n += make_pic(joined + n, 0x10, 99);   /* closes the last one */
+    emit_video(joined, n, 0x7C0, 0x9000);
+    const u32 section = s_wp;
+    feed(1, 4);
+
+    WAIT_FOR(ev_count[EV_AU_V] == (LONG)DMUX_AU_QUEUE_MAX);
+    Sleep(50);
+    CHECK(ev_count[EV_AU_V] == (LONG)DMUX_AU_QUEUE_MAX);   /* asleep, not dropping */
+    CHECK(ev_count[EV_DONE] == 0);
+    CHECK_RC(cellDmuxSetStream(h_dmux, G_STREAM, section, 0, 5), CELL_DMUX_ERROR_BUSY);
+    CHECK_RC(cellDmuxFlushEs(h_v), CELL_DMUX_ERROR_SEQ);
+
+    for (u32 i = 0; i < N; i++) {
+        if (i == 7)
+            Sleep(20);
+        Au au;
+        WAIT_FOR(get_au(h_v, &au) == CELL_OK);
+        CHECK(au.size == size[i]);
+        CHECK(memcmp(vm_base + au.addr, joined + at[i], au.size) == 0);
+        CHECK_RC(cellDmuxReleaseAu(h_v), CELL_OK);
+    }
+    WAIT_FOR(ev_count[EV_DONE] == 1);
+    CHECK(ev_n == N + 1);
+    CHECK(ev_log[N] == EV_DONE);           /* after the last AU */
+    close_dmux();
+}
+
+/* Peek does not take the AU; release can take one that was not popped. */
+static void test_peek(void)
+{
+    open_dmux(3);
+    const u32 s1 = make_pic(a1, 0x20, 1), s2 = make_pic(a2, 0x20, 2);
+    u32 n = s1;
+    memcpy(joined, a1, s1);
+    memcpy(joined + n, a2, s2); n += s2;
+    n += make_pic(joined + n, 0x20, 3);
+    emit_pes(-1, joined, n, 0x10, 0);
+    feed(1, 6);
+    WAIT_FOR(ev_count[EV_DONE] == 1);
+    CHECK_RC(cellDmuxPeekAuEx(h_v, GP(G_AUP), GP(G_SPP)), CELL_OK);
+    const u32 i1 = vm_read32(G_AUP);
+    CHECK_RC(cellDmuxPeekAu(h_v, GP(G_AUP), GP(G_SPP)), CELL_OK);
+    CHECK(vm_read32(G_AUP) == i1);
+    CHECK_RC(cellDmuxReleaseAu(h_v), CELL_OK);   /* never popped */
+    CHECK_RC(cellDmuxGetAu(h_v, GP(G_AUP), GP(G_SPP)), CELL_OK);
+    CHECK(vm_read32(G_AUP) != i1);
+    CHECK_RC(cellDmuxReleaseAu(h_v), CELL_OK);
+    close_dmux();
+}
+
+/* Many AUs through the 0x70000 ring of a Main Profile @ Main Level stream: the
+ * ring wraps, every AU stays contiguous and keeps its bytes. */
+static void test_wrap(void)
+{
+    enum { N = 24, BODY = 0x8000 };
+    open_dmux(1);
+    static u8 big[(N + 1) * (BODY + 4)];
+    u32 n = 0;
+    for (u32 i = 0; i <= N; i++)
+        n += make_pic(big + n, BODY, i * 13 + 1);
+    u32 sections = 0, wraps = 0, last_addr = 0;
+    u32 done = 0, sent = 0;
+    while (done < N) {
+        if (sent < n && ev_count[EV_DONE] == (LONG)sections) {
+            const u32 chunk = n - sent < 0x7F00 ? n - sent : 0x7F00;
+            s_wp = 0;
+            emit_video(big + sent, chunk, 0x7C0, -1);
+            sent += chunk;
+            feed(sections == 0, sections);
+            sections++;
+        }
+        Au au;
+        if (get_au(h_v, &au) == CELL_OK) {
+            CHECK(au.size == BODY + 4);
+            CHECK(au.addr + au.size <= G_VIDEO + 0x71000u);
+            CHECK(memcmp(vm_base + au.addr, big + done * (BODY + 4), au.size) == 0);
+            wraps += au.addr < last_addr;
+            last_addr = au.addr;
+            done++;
+            CHECK_RC(cellDmuxReleaseAu(h_v), CELL_OK);
+        }
+    }
+    CHECK(wraps >= 2);
+    close_dmux();
+}
+
+/* An AU cut short by a discontinuity is gone; a reset wakes dmux_pamf from a
+ * full queue and still ends in DEMUX_DONE. */
+static void test_discontinuity_and_reset(void)
+{
+    open_dmux(3);
+    u32 n = make_pic(joined, 0x100, 1);
+    emit_pes(-1, joined, n, 0x10, 0);
+    feed(1, 7);
+    WAIT_FOR(ev_count[EV_DONE] == 1);
+    CHECK(ev_count[EV_AU_V] == 0);
+
+    s_wp = 0;
+    const u32 s1 = make_pic(a1, 0x40, 2);
+    n = s1;
+    memcpy(joined, a1, s1);
+    n += make_pic(joined + n, 0x40, 3);
+    emit_pes(-1, joined, n, 0x20, 0);
+    feed(1, 8);
+    WAIT_FOR(ev_count[EV_DONE] == 2);
+    CHECK(ev_count[EV_AU_V] == 1);
+    expect_au(h_v, a1, s1, 0x20, 0);
+    close_dmux();
+
+    enum { N = 12 };
+    open_dmux(3);
+    n = 0;
+    for (u32 i = 0; i <= N; i++)
+        n += make_pic(joined + n, 0x80, i);
+    emit_video(joined, n, 0x7C0, 0x30);
+    CHECK_RC(cellDmuxResetStream(h_dmux), CELL_DMUX_ERROR_SEQ);
+    feed(1, 9);
+    WAIT_FOR(ev_count[EV_AU_V] == (LONG)DMUX_AU_QUEUE_MAX);
+    Sleep(20);
+    CHECK_RC(cellDmuxResetStream(h_dmux), CELL_OK);
+    WAIT_FOR(ev_count[EV_DONE] == 1);
+    CHECK_RC(cellDmuxResetStreamAndWaitDone(h_dmux), CELL_OK);
+    close_dmux();
+}
+
+/* Closing with dmux_pamf asleep on a full queue must not hang. */
+static void test_close_while_full(void)
+{
+    enum { N = 12 };
+    open_dmux(3);
+    u32 n = 0;
+    for (u32 i = 0; i <= N; i++)
+        n += make_pic(joined + n, 0x80, i);
+    emit_video(joined, n, 0x7C0, 0x30);
+    feed(1, 10);
+    WAIT_FOR(ev_count[EV_AU_V] == (LONG)DMUX_AU_QUEUE_MAX);
+    Sleep(20);
+    CHECK_RC(cellDmuxDisableEs(h_v), CELL_OK);
+    CHECK_RC(cellDmuxClose(h_dmux), CELL_OK);
+}
+
+static void test_args(void)
+{
+    vm_write32(G_TYPE, 0);
+    CHECK_RC(cellDmuxQueryAttr(GP(G_TYPE), GP(G_ATTR)), CELL_DMUX_ERROR_ARG);
+    CHECK_RC(cellDmuxQueryAttr(0, GP(G_ATTR)), CELL_DMUX_ERROR_ARG);
+    vm_write32(G_TYPE, CELL_DMUX_STREAM_TYPE_PAMF);
+    vm_write32(G_ID, 0xBD); vm_write32(G_ID + 4, 0x40);
+    CHECK_RC(cellDmuxQueryEsAttr(GP(G_TYPE), GP(G_ID), 0, GP(G_ATTR)), CELL_DMUX_ERROR_FATAL);
+    CHECK_RC(cellDmuxSetStream(0x1234, G_STREAM, 0x800, 0, 0), CELL_DMUX_ERROR_ARG);
+    CHECK_RC(cellDmuxGetAuEx(0x1234, GP(G_AUP), GP(G_SPP)), CELL_DMUX_ERROR_ARG);
+    CHECK_RC(cellDmuxReleaseAu(0x1234), CELL_DMUX_ERROR_ARG);
+    CHECK_RC(cellDmuxFlushEs(0x1234), CELL_DMUX_ERROR_ARG);
+    open_dmux(3);
+    CHECK_RC(cellDmuxSetStream(h_dmux, G_STREAM, 0, 0, 0), CELL_DMUX_ERROR_ARG);
+    CHECK_RC(cellDmuxSetStream(h_dmux, G_STREAM, 0xFFFFFFFFu, 0, 0), CELL_DMUX_ERROR_ARG);
+    /* A broken stream is reported, not walked over. */
+    u8* p = vm_base + G_STREAM;
+    memset(p, 0, PACK_SIZE);
+    p[2] = 1; p[3] = 0xBA;
+    s_wp = PACK_SIZE;
+    feed(1, 11);
+    WAIT_FOR(ev_count[EV_FATAL] == 1 && ev_count[EV_DONE] == 1);
+    /* The program end code gets its message. */
+    p[3] = 0xB9;
+    reset_events();
+    feed(0, 12);
+    WAIT_FOR(ev_count[EV_DONE] == 1);
+    CHECK(ev_count[EV_PROGEND] == 1);
+    close_dmux();
+}
+
+/* ---------------------------------------------------------------------------
+ * A real file
+ * -----------------------------------------------------------------------*/
+
+enum { SECTION = 0x80000 };
+
+static int run_file(const char* path, const char* audio_path)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) {
+        printf("cannot open %s\n", path);
+        return 1;
+    }
+    FILE* out = audio_path ? fopen(audio_path, "w") : NULL;
+    u8 hdr[0x800];
+    fread(hdr, 1, sizeof hdr, f);
+    open_dmux(3);
+
+    u32 vn = 0, an = 0, sections = 0, inv_a = 0, rap = 0, maxv = 0;
+    u32 first_a_size = 0;
+    u64 first_a_pts = 0, first_v_pts = 0, last_v_pts = 0;
+    int eof = 0;
+    LONG done = 0;
+    for (;;) {
+        Au au;
+        int got = 0;
+        while (get_au(h_v, &au) == CELL_OK) {
+            if (!vn) first_v_pts = au.pts;
+            if (au.pts != DMUX_TS_INVALID) last_v_pts = au.pts;
+            if (au.size > maxv) maxv = au.size;
+            rap += au.rap;
+            vn++; got = 1;
+            CHECK_RC(cellDmuxReleaseAu(h_v), CELL_OK);
+        }
+        while (get_au(h_a, &au) == CELL_OK) {
+            if (!an) { first_a_size = au.size; first_a_pts = au.pts; }
+            if (au.pts == DMUX_TS_INVALID) inv_a++;
+            if (out) fprintf(out, "%x %llx\n", au.size, (unsigned long long)au.pts);
+            an++; got = 1;
+            CHECK_RC(cellDmuxReleaseAu(h_a), CELL_OK);
+        }
+        if (eof == 2 && ev_count[EV_FLUSH_V] == 1 && ev_count[EV_FLUSH_A] == 1 && !got)
+            break;
+        if (eof == 0 && ev_count[EV_DONE] == done) {
+            const size_t n = fread(vm_base + G_STREAM, 1, SECTION, f);
+            if (!n) {
+                eof = 1;
+            } else {
+                done++;
+                sections++;
+                CHECK_RC(cellDmuxSetStream(h_dmux, G_STREAM, (u32)n, sections == 1, sections), CELL_OK);
+            }
+        }
+        if (eof == 1) {
+            CHECK_RC(cellDmuxFlushEs(h_v), CELL_OK);
+            CHECK_RC(cellDmuxFlushEs(h_a), CELL_OK);
+            eof = 2;
+        }
+        if (!got)
+            Sleep(0);
+    }
+    CHECK(ev_count[EV_FATAL] == 0);
+    printf("%s: sections %u (DEMUX_DONE %ld), AU video %u, AU audio %u\n", path, sections,
+           (long)ev_count[EV_DONE], vn, an);
+    printf("  first audio AU: size 0x%X pts 0x%llx; audio AUs without pts: %u\n", first_a_size,
+           (unsigned long long)first_a_pts, inv_a);
+    printf("  video pts 0x%llx..0x%llx, largest AU 0x%X, random access points %u\n",
+           (unsigned long long)first_v_pts, (unsigned long long)last_v_pts, maxv, rap);
+    printf("  queue waits %ld, ring waits %ld\n", s_n_queue_waits, s_n_ring_waits);
+    close_dmux();
+    fclose(f);
+    if (out) fclose(out);
+    return 0;
+}
+
+int main(int argc, char** argv)
+{
+    vm_base = (uint8_t*)calloc(1, MEM);
+    CHECK(vm_base);
+    g_ps3_guest_caller = caller;
+    if (argc > 1)
+        return run_file(argv[1], argc > 2 ? argv[2] : NULL);
+
+    test_args();
+    test_split();
+    test_sequence();
+    test_audio();
+    test_queue_full();
+    test_peek();
+    test_wrap();
+    test_discontinuity_and_reset();
+    test_close_while_full();
+    printf("test_cellDmux: ok (queue %u)\n", (unsigned)DMUX_AU_QUEUE_MAX);
+    return 0;
+}
+
+ps3_guest_caller_fn g_ps3_guest_caller;
