+s32 cellDmuxOpen(const void* demuxerType, const void* demuxerResource,
+                 const void* demuxerCb, void* demuxerHandle)
+{
+    const u32 type = GUEST_EA(demuxerType), res = GUEST_EA(demuxerResource);
+    const u32 cb = GUEST_EA(demuxerCb), out = GUEST_EA(demuxerHandle);
+    if (!type || !res || !cb || !out || vm_read32(type) != CELL_DMUX_STREAM_TYPE_PAMF)
+        return (s32)CELL_DMUX_ERROR_ARG;
+    const u32 mem = vm_read32(res + 0), mem_size = vm_read32(res + 4), cb_func = vm_read32(cb + 0);
+    if (!mem || mem_size < DMUX_MEM_SIZE || !cb_func)
+        return (s32)CELL_DMUX_ERROR_ARG;
+
+    for (int i = 0; i < CELL_DMUX_MAX_HANDLES; i++) {
+        DmuxSlot* d = &s_dmux[i];
+        if (InterlockedCompareExchange(&d->in_use, 2, 0) != 0)
+            continue;
+        memset((u8*)d + sizeof(d->in_use), 0, sizeof(*d) - sizeof(d->in_use));
+        InitializeSRWLock(&d->lock);
+        InitializeConditionVariable(&d->wake);
+        InitializeConditionVariable(&d->idle);
+        d->handle = align16(mem);
+        d->cb_func = cb_func;
+        d->cb_arg = vm_read32(cb + 4);
+        d->thread = CreateThread(NULL, 1u << 20, dmux_thread, d, 0, &d->thread_id);
+        if (!d->thread) {
+            d->in_use = 0;
+            return (s32)CELL_DMUX_ERROR_FATAL;
+        }
+        d->in_use = 1;
+        vm_write32(out, d->handle);
+        if (dmux_trace())
+            fprintf(stderr, "[dmux] open: handle=0x%08X cb=0x%08X arg=0x%08X\n", d->handle, cb_func, d->cb_arg);
+        return CELL_OK;
+    }
+    return (s32)CELL_DMUX_ERROR_BUSY;
+}
+
+s32 cellDmuxClose(CellDmuxHandle handle)
+{
+    DmuxSlot* d = find_dmux(handle);
