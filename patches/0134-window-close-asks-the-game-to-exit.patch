diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index b4b1f03..ce9c7c6 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -796,17 +796,16 @@ static LRESULT CALLBACK d3d12_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 {
     switch (msg) {
     case WM_CLOSE:
+        /* Re:Fine: a request, not the end. The title still has to finish its save and
+         * needs the RSX for that; the window goes with the process. */
         s_d3d.window_closed = 1;
-        DestroyWindow(hwnd);
         return 0;
     case WM_DESTROY:
         PostQuitMessage(0);
         return 0;
     case WM_KEYDOWN:
-        if (wp == VK_ESCAPE) {
+        if (wp == VK_ESCAPE)
             s_d3d.window_closed = 1;
-            DestroyWindow(hwnd);
-        }
         return 0;
     }
     return DefWindowProcA(hwnd, msg, wp, lp);
