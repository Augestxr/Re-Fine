diff --git a/libs/hardware/cellUsbd.c b/libs/hardware/cellUsbd.c
--- a/libs/hardware/cellUsbd.c
+++ b/libs/hardware/cellUsbd.c
@@ -7,6 +7,8 @@
  */
 
 #include "cellUsbd.h"
+#include "../../runtime/ppu/ppu_context.h"
+#include <stdint.h>
 #include <stdio.h>
 #include <string.h>
 #include "../../runtime/ppu/ppu_memory.h"   /* GUEST_PTR, vm_read/vm_write: guest EA -> host */
@@ -104,3 +106,41 @@ s32 cellUsbdControlTransfer(CellUsbdPipeId pipeId, u8 requestType,
     (void)value; (void)index; (void)data; (void)length; (void)transferred;
     return (s32)CELL_USBD_ERROR_PIPE_NOT_FOUND;
 }
+
+/* Re:Fine 0149. An extra LDD is an LDD with a vendor and product of its own, in the same
+ * table as cellUsbdRegisterLdd. F registers "HORI DIVA-F LARGE" (0x0F0D:0x0048) and
+ * ignores both returns (0x39DFC, 0x399C8). No device is ever enumerated, so attach never
+ * runs: the same as RPCS3 without that controller, whose libusbd only reaches
+ * sys_usbd_register_extra_ldd and sys_usbd_unregister_extra_ldd. */
+s32 cellUsbdRegisterExtraLdd(const CellUsbdLddOps* ops, u16 vendorId, u16 productId)
+{
+    printf("[cellUsbd] RegisterExtraLdd(vendor=0x%04X, product=0x%04X)\n", vendorId, productId);
+    return cellUsbdRegisterLdd(ops);
+}
+
+s32 cellUsbdUnregisterExtraLdd(const CellUsbdLddOps* ops)
+{
+    printf("[cellUsbd] UnregisterExtraLdd()\n");
+    return cellUsbdUnregisterLdd(ops);
+}
+
+/* Not in the generated NID table: ctx handlers, so it does not have to be regenerated. */
+extern void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*));
+
+static void hle_cellUsbdRegisterExtraLdd(ppu_context* ctx)
+{
+    ctx->gpr[3] = (u64)(s64)cellUsbdRegisterExtraLdd(
+        (const CellUsbdLddOps*)(uintptr_t)(u32)ctx->gpr[3], (u16)ctx->gpr[4], (u16)ctx->gpr[5]);
+}
+
+static void hle_cellUsbdUnregisterExtraLdd(ppu_context* ctx)
+{
+    ctx->gpr[3] = (u64)(s64)cellUsbdUnregisterExtraLdd(
+        (const CellUsbdLddOps*)(uintptr_t)(u32)ctx->gpr[3]);
+}
+
+void cellUsbd_register_ctx_handlers(void)
+{
+    ps3_hle_register_ctx(0x7FE92C54u, "cellUsbdRegisterExtraLdd", hle_cellUsbdRegisterExtraLdd);
+    ps3_hle_register_ctx(0x90460081u, "cellUsbdUnregisterExtraLdd", hle_cellUsbdUnregisterExtraLdd);
+}
