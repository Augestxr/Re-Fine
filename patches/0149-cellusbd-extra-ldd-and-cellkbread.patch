diff --git a/libs/input/cellKb.c b/libs/input/cellKb.c
--- a/libs/input/cellKb.c
+++ b/libs/input/cellKb.c
@@ -9,6 +9,7 @@
  */
 
 #include "cellKb.h"
+#include "../../runtime/ppu/ppu_context.h"
 #include <stdio.h>
 #include <string.h>
 #include <stdint.h>
@@ -134,8 +135,9 @@ s32 cellKbInit(u32 max_connect)
     s_kb_max_connect = max_connect;
     memset(s_kb_ports, 0, sizeof(s_kb_ports));
 
-    /* Assume keyboard 0 is always connected on the host */
-    s_kb_ports[0].connected = 1;
+    /* Re:Fine 0149: no keyboard until cellKb_keyEvent reports one. The PC keyboard
+     * goes to cellPad (patches/0142), and RPCS3 with Keyboard: Null reports none
+     * either, so F never calls cellKbRead there. */
     s_kb_ports[0].rmode = CELL_KB_RMODE_INPUTCHAR;
     s_kb_ports[0].codetype = CELL_KB_CODETYPE_ASCII;
 
@@ -206,6 +208,22 @@ s32 cellKbGetData(u32 port_no, CellKbData* data)
     return CELL_OK;
 }
 
+/* cellKbRead, the name the import really has; behaviour of RPCS3 1f59f0f2, no code
+ * copied: a port without a keyboard gives NO_DEVICE and leaves the buffer alone. */
+s32 cellKbRead(u32 port_no, CellKbData* data)
+{
+    if (!s_kb_initialized)
+        return CELL_KB_ERROR_UNINITIALIZED;
+
+    if (port_no >= CELL_KB_MAX_KEYBOARDS || !data)
+        return CELL_KB_ERROR_INVALID_PARAMETER;
+
+    if (!s_kb_ports[port_no].connected)
+        return CELL_KB_ERROR_NO_DEVICE;
+
+    return cellKbGetData(port_no, data);
+}
+
 /* Guest CellKbInfo layout (big-endian): +0x00 max_connect u32, +0x04
  * now_connect u32, +0x08 info u32, +0x0C status[] u8 PER KEYBOARD (bytes,
  * not u32s -- SDK/RPCS3 layout). */
@@ -279,3 +297,16 @@ s32 cellKbClearBuf(u32 port_no)
     s_kb_ports[port_no].event_count = 0;
     return CELL_OK;
 }
+
+/* Not in the generated NID table: a ctx handler, so it does not have to be regenerated. */
+extern void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*));
+
+static void hle_cellKbRead(ppu_context* ctx)
+{
+    ctx->gpr[3] = (u64)(s64)cellKbRead((u32)ctx->gpr[3], (CellKbData*)(uintptr_t)(u32)ctx->gpr[4]);
+}
+
+void cellKb_register_ctx_handlers(void)
+{
+    ps3_hle_register_ctx(0xFF0A21B7u, "cellKbRead", hle_cellKbRead);
+}
