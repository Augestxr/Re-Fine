diff --git a/libs/input/tests/test_cellKb.c b/libs/input/tests/test_cellKb.c
new file mode 100644
--- /dev/null
+++ b/libs/input/tests/test_cellKb.c
@@ -0,0 +1,56 @@
+/* clang-cl /O1 -w -Iinclude -Ilibs/input libs/input/tests/test_cellKb.c libs/input/cellKb.c \
+ *     /link /force:unresolved /out:test_cellKb.exe
+ *
+ * cellKbRead with RPCS3's return codes and order; the guest is a plain array. */
+#include "../cellKb.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static uint8_t guest[0x1000];
+static int failed;
+
+void vm_write8(unsigned long long a, unsigned char v) { guest[a] = v; }
+void vm_write16(unsigned long long a, unsigned short v) { guest[a] = v >> 8; guest[a + 1] = (uint8_t)v; }
+void vm_write32(unsigned long long a, unsigned int v)
+{
+    vm_write16(a, (unsigned short)(v >> 16));
+    vm_write16(a + 2, (unsigned short)v);
+}
+static u32 rd32(u32 a) { return (u32)guest[a] << 24 | guest[a + 1] << 16 | guest[a + 2] << 8 | guest[a + 3]; }
+
+#define CHECK(c) do { if (!(c)) { printf("[cellKb] FAILED line %d: %s\n", __LINE__, #c); failed++; } } while (0)
+#define INFO ((CellKbInfo*)(uintptr_t)0x100)
+#define DATA ((CellKbData*)(uintptr_t)0x200)
+
+int main(void)
+{
+    CHECK(cellKbRead(0, DATA) == CELL_KB_ERROR_UNINITIALIZED);
+    CHECK(cellKbInit(1) == CELL_OK);
+
+    /* No keyboard, as RPCS3 with Keyboard: Null: F sees status 0 and never reads. */
+    CHECK(cellKbGetInfo(INFO) == CELL_OK);
+    CHECK(rd32(0x100) == 1);
+    CHECK(rd32(0x104) == 0);
+    CHECK(guest[0x10C] == 0);
+
+    memset(guest + 0x200, 0xAB, 16);
+    CHECK(cellKbRead(0, DATA) == CELL_KB_ERROR_NO_DEVICE);
+    CHECK(guest[0x200] == 0xAB);
+    CHECK(cellKbRead(1, DATA) == CELL_KB_ERROR_NO_DEVICE);
+    CHECK(cellKbRead(CELL_KB_MAX_KEYBOARDS, DATA) == CELL_KB_ERROR_INVALID_PARAMETER);
+    CHECK(cellKbRead(0, NULL) == CELL_KB_ERROR_INVALID_PARAMETER);
+
+    /* A key from the host connects the port. */
+    cellKb_keyEvent(0, CELL_KEYC_A, 1);
+    CHECK(cellKbGetInfo(INFO) == CELL_OK);
+    CHECK(rd32(0x104) == 1);
+    CHECK(guest[0x10C] == CELL_KB_STATUS_CONNECTED);
+    CHECK(cellKbRead(0, DATA) == CELL_OK);
+    CHECK(rd32(0x208) == 1);
+    CHECK(guest[0x20C] == 0 && guest[0x20D] == 'a');
+
+    CHECK(cellKbEnd() == CELL_OK);
+    printf("[cellKb] %s (%d failed)\n", failed ? "FAILED" : "PASS", failed);
+    return failed != 0;
+}
