+/* Re:Fine 0151: the swap chain to the window's size. Called with the GPU idle. */
+static void swap_chain_resize(void)
+{
+    const u32 w = s_d3d.want_w, h = s_d3d.want_h;
+    if (!w || (w == s_d3d.win_w && h == s_d3d.win_h)) return;
+    for (u32 i = 0; i < FRAME_COUNT; i++) {
+        s_d3d.swap_buffers[i]->lpVtbl->Release(s_d3d.swap_buffers[i]);
+        s_d3d.swap_buffers[i] = NULL;
+    }
+    const HRESULT hr = s_d3d.swap_chain->lpVtbl->ResizeBuffers(s_d3d.swap_chain, FRAME_COUNT, w, h,
+        DXGI_FORMAT_UNKNOWN, s_d3d.tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0);
+    if (SUCCEEDED(hr)) { s_d3d.win_w = w; s_d3d.win_h = h; }
+    else fprintf(stderr, "[D3D12] ERROR: ResizeBuffers %ux%u failed (0x%08lX)%c", w, h, (long)hr, 10);
+    if (swap_buffers_get() != 0)
+        fprintf(stderr, "[D3D12] ERROR: swap chain buffers lost after a resize%c", 10);
+    const u64 done = s_d3d.fence_values[s_d3d.frame_index];
+    s_d3d.frame_index = s_d3d.swap_chain->lpVtbl->GetCurrentBackBufferIndex(s_d3d.swap_chain);
+    s_d3d.fence_values[s_d3d.frame_index] = done;
+}
