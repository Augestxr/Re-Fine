+/* Re:Fine 0151: the finished frame on the swap chain, bilinear, 16:9 and centred, with
+ * black bands in what is left. The swap chain is the size of the window, whatever
+ * the mode of it (R14), and nothing else touches it. Same size is a plain copy:
+ * every texel centre lands on a pixel centre. */
+static struct {
+    ID3D12RootSignature*  rs;
+    ID3D12PipelineState*  pso;
+    ID3D12DescriptorHeap* heap;
+} s_blit;
+
+static int present_blit_init(void)
+{
+    if (s_blit.pso) return 1;
+    static int failed;
+    if (failed) return 0;
+    failed = 1;
+    static const char vs[] =
+        "struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; };\n"
+        "O main(uint id : SV_VertexID) {\n"
+        "    O o;\n"
+        "    o.uv = float2((id << 1) & 2, id & 2);\n"
+        "    o.p = float4(o.uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+        "    return o;\n"
+        "}\n";
+    static const char ps[] =
+        "Texture2D<float4> t : register(t0);\n"
+        "SamplerState s : register(s0);\n"
+        "float4 main(float4 p : SV_Position, float2 uv : TEXCOORD0) : SV_Target {\n"
+        "    return t.SampleLevel(s, uv, 0);\n"
+        "}\n";
+    ID3DBlob *vb = NULL, *pb = NULL, *err = NULL, *sig = NULL;
+    if (FAILED(sc_compile(vs, sizeof vs - 1, "blit_vs", NULL, NULL, "main", "vs_5_0", 0, 0, &vb, &err)) ||
+        FAILED(sc_compile(ps, sizeof ps - 1, "blit_ps", NULL, NULL, "main", "ps_5_0", 0, 0, &pb, &err))) {
+        printf("[D3D12] present shader: %s%c", err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?", 10);
+        return 0;
+    }
+    D3D12_DESCRIPTOR_RANGE rg = {0};
+    rg.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    rg.NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER rp = {0};
+    rp.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp.DescriptorTable.NumDescriptorRanges = 1;
+    rp.DescriptorTable.pDescriptorRanges = &rg;
+    rp.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_STATIC_SAMPLER_DESC ss = {0};
+    ss.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    ss.AddressU = ss.AddressV = ss.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    ss.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rd = {0};
+    rd.NumParameters = 1; rd.pParameters = &rp;
+    rd.NumStaticSamplers = 1; rd.pStaticSamplers = &ss;
+    ID3D12Device* dev = s_d3d.device;
