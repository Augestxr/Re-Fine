+/* List callback. The directory list is marshalled into the title's own
+ * CellSaveDataSetBuf (SDK: "dirList uses CellSaveDataSetBuf *buf"), and what the
+ * title wants shown is read back out of the GUEST CellSaveDataListSet.
+ *
+ * Guest layouts (sysutil_savedata.h, 32-bit pointers):
+ *   ListGet  { dirNum +0; dirListNum +4; dirList* +8; reserved[64] }
+ *   ListSet  { focusPosition +0; focusDirName* +4; fixedListNum +8;
+ *              fixedList* +12; newData* +16; reserved* +20 }
+ *   NewData  { iconPosition +0; dirName* +4; icon* +8; reserved* +12 }
+ *   Icon     { title* +0; iconBufSize +4; iconBuf* +8; reserved* +12 }
+ *   DirList  { dirName[32]; listParam[8]; reserved[8] }  (48 bytes)
+ *   SetBuf   { dirListMax +0; fileListMax +4; reserved[6]; bufSize +32; buf* +36 } */
+#define SAVEDATA_LISTSET_SIZE 24u
+
+typedef struct SaveListSet {
+    u32  focus_pos;
+    char focus_dir[CELL_SAVEDATA_DIRNAME_SIZE];
+    u32  fixed_num;
+    char (*fixed)[CELL_SAVEDATA_DIRNAME_SIZE];
+    int  has_new;
+    u32  new_pos;
+    char new_dir[CELL_SAVEDATA_DIRNAME_SIZE];
+    char new_title[128];
+} SaveListSet;
+
+static void guest_copy_str(char* out, size_t n, uint32_t ea)
+{
+    size_t i = 0;
+    for (; ea && i + 1 < n; i++) {
+        out[i] = (char)vm_read8(ea + (uint32_t)i);
+        if (!out[i]) return;
+    }
+    out[i] = '\0';
+}
+
+/* Wipe the title's dirList buffer, as the system does around funcList. */
+static void setbuf_clear(uint32_t setBuf_ea)
+{
+    uint32_t buf = vm_read32(setBuf_ea + 36), size = vm_read32(setBuf_ea + 32);
+    if (!buf || !size) return;
+    vm_commit(buf, size);
+    memset(vm_base + buf, 0, size);
+}
+
+static s32 dispatch_func_list(uint32_t func_opd, const CellSaveDataDirList* dirList,
+                              uint32_t dirNum, uint32_t listed, uint32_t setBuf_ea,
+                              uint32_t* userdata_ea, SaveListSet* out)
+{
+    memset(out, 0, sizeof *out);
+    if (!g_ps3_guest_caller) return CELL_SAVEDATA_CBRESULT_ERR_FAILURE;
+
+    scratch_reset();
+    uint32_t cb_ea  = scratch_alloc(SAVEDATA_CBRESULT_SIZE);
+    uint32_t get_ea = scratch_alloc(SAVEDATA_STATGET_SIZE);
+    uint32_t set_ea = scratch_alloc(SAVEDATA_LISTSET_SIZE);
+    if (!cb_ea || !get_ea || !set_ea) return CELL_SAVEDATA_CBRESULT_ERR_FAILURE;
+
+    uint32_t buf_ea = vm_read32(setBuf_ea + 36);
+    if (dirNum) setbuf_clear(setBuf_ea);
+    for (uint32_t i = 0; i < listed; i++)
+        for (uint32_t k = 0; k < 48; k++)
+            vm_write8(buf_ea + i * 48 + k, (uint8_t)((const char*)&dirList[i])[k]);
+
+    marshal_cbresult_init(cb_ea, CELL_SAVEDATA_CBRESULT_OK_NEXT, *userdata_ea);
+    vm_write32(get_ea + 0, dirNum);
+    vm_write32(get_ea + 4, listed);
+    vm_write32(get_ea + 8, buf_ea);
+    vm_write32(set_ea + 0, CELL_SAVEDATA_FOCUSPOS_LISTHEAD);
+
+    printf("[cellSaveData] dispatching funcList OPD=0x%08X (dirNum=%u listed=%u)%c",
+           func_opd, dirNum, listed, 10);
+    g_ps3_guest_caller(func_opd, cb_ea, get_ea, set_ea, 0, 0, 0, 0, 0);
+
+    *userdata_ea = vm_read32(cb_ea + 16);
+    s32 result = marshal_cbresult_read_result(cb_ea);
+
+    out->focus_pos = vm_read32(set_ea + 0);
+    guest_copy_str(out->focus_dir, sizeof out->focus_dir, vm_read32(set_ea + 4));
+    uint32_t fixed = vm_read32(set_ea + 12), newd = vm_read32(set_ea + 16);
+    out->fixed_num = fixed ? vm_read32(set_ea + 8) : 0;
+    if (out->fixed_num > CELL_SAVEDATA_LISTITEM_MAX) out->fixed_num = CELL_SAVEDATA_LISTITEM_MAX;
+    if (out->fixed_num) {
+        out->fixed = calloc(out->fixed_num, sizeof *out->fixed);
+        if (!out->fixed) return CELL_SAVEDATA_CBRESULT_ERR_FAILURE;
+        for (uint32_t i = 0; i < out->fixed_num; i++)
+            guest_copy_str(out->fixed[i], sizeof out->fixed[i], fixed + i * 48);
+    }
+    if (newd) {
+        out->has_new = 1;
+        out->new_pos = vm_read32(newd);
+        guest_copy_str(out->new_dir, sizeof out->new_dir, vm_read32(newd + 4));
+        uint32_t icon = vm_read32(newd + 8);
+        if (icon) guest_copy_str(out->new_title, sizeof out->new_title, vm_read32(icon));
+    }
+    printf("[cellSaveData] funcList returned cbResult.result=%d fixed=%u newData='%s' focus=%u%c",
+           result, out->fixed_num, out->new_dir, out->focus_pos, 10);
+    return result;
+}
