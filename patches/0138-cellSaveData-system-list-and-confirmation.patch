+static s32 savedata_list(int is_save, CellSaveDataSetList* setList, CellSaveDataSetBuf* setBuf,
+                         CellSaveDataListCallback funcList, CellSaveDataStatCallback funcStat,
+                         CellSaveDataFileCallback funcFile, void* userdata)
+{
+    if (!setList || !setBuf || !funcList || !funcStat)
+        return CELL_SAVEDATA_ERROR_PARAM;
+
+    /* CellSaveDataSetList is { u32 sortType; u32 sortOrder; char* dirNamePrefix; }
+     * and CellSaveDataSetBuf starts with u32 dirListMax -- guest layout. */
+    const u32 list_ea = (u32)(uintptr_t)setList, buf_ea = (u32)(uintptr_t)setBuf;
+    const u32 prefix_ea = vm_read32(list_ea + 8);
+    const u32 dir_max = vm_read32(buf_ea + 0);
+
+    u32 dir_num, count;
+    SaveEntry* entries = save_entries_read(prefix_ea ? (const char*)vm_base + prefix_ea : "",
+                                           dir_max ? dir_max : CELL_SAVEDATA_DIRLIST_MAX,
+                                           vm_read32(list_ea + 0), vm_read32(list_ea + 4),
+                                           &dir_num, &count);
+    if (!entries) return CELL_SAVEDATA_ERROR_INTERNAL;
+
+    CellSaveDataDirList* dirs = calloc(count ? count : 1, sizeof *dirs);
+    if (!dirs) { free(entries); return CELL_SAVEDATA_ERROR_INTERNAL; }
+    for (u32 i = 0; i < count; i++) {
+        memcpy(dirs[i].dirName, entries[i].dir, sizeof dirs[i].dirName);
+        memcpy(dirs[i].listParam, entries[i].list_param, sizeof dirs[i].listParam);
+    }
+
+    u32 cb_userdata = (u32)(uintptr_t)userdata;
+    SaveListSet ls;
+    const s32 result = dispatch_func_list((u32)(uintptr_t)funcList, dirs, dir_num, count, buf_ea,
+                                          &cb_userdata, &ls);
+    free(dirs);
+
+    s_err_dialog = CELL_SAVEDATA_ERRDIALOG_ALWAYS;
+    s32 rc = CELL_OK;
+    char selected[CELL_SAVEDATA_DIRNAME_SIZE] = "";
+
+    if (result != CELL_SAVEDATA_CBRESULT_OK_NEXT) {
+        if (result != CELL_SAVEDATA_CBRESULT_OK_LAST &&
+            result != CELL_SAVEDATA_CBRESULT_OK_LAST_NOCONFIRM) {
+            savedata_error_dialog(result);
+            rc = CELL_SAVEDATA_ERROR_CBRESULT;
+        }
+        goto done;
+    }
+
+    /* Only what the title named stays, with no fixedList that is nothing: this
+     * is how F's ListSave2 ends up with just the new data row (con_datos_1). */
+    { u32 kept = 0;
+      for (u32 i = 0; i < count; i++) {
+          int wanted = 0;
+          for (u32 k = 0; k < ls.fixed_num; k++)
+              if (!strcmp(entries[i].dir, ls.fixed[k])) { wanted = 1; break; }
+          if (wanted) { if (kept != i) memcpy(&entries[kept], &entries[i], sizeof *entries); kept++; }
+      }
+      count = kept; }
+
+    SysuiListItem* items = calloc(count ? count : 1, sizeof *items);
+    if (!items) { rc = CELL_SAVEDATA_ERROR_INTERNAL; goto done; }
+    for (u32 i = 0; i < count; i++) items[i] = entries[i].item;
+
+    SysuiList list;
+    memset(&list, 0, sizeof list);
+    list.header = is_save ? "Save" : "Load Save";   /* "Save": ASSUMPTION, no shot of it */
+    list.items = items;
+    list.count = (int)count;
+    list.has_new = ls.has_new;
+    list.new_at_tail = ls.new_pos == CELL_SAVEDATA_ICONPOS_TAIL;
+    list.new_title = ls.new_title[0] ? ls.new_title : NULL;
+    list.focus = list_focus(&ls, entries, count);
+
+    for (;;) {
+        const int sel = sysui_save_list(&list);
+        if (sel == SYSUI_SEL_BACK) { rc = CELL_CANCEL; break; }
+
+        char msg[SYSUI_MSG_MAX + 1];
+        if (sel == SYSUI_SEL_NEW) {
+            snprintf(msg, sizeof msg, "Do you want to save this data?");
+            snprintf(selected, sizeof selected, "%s", ls.new_dir);
+        } else {
+            confirm_text(msg, sizeof msg, is_save, &entries[sel]);
+            snprintf(selected, sizeof selected, "%s", entries[sel].dir);
+        }
+        const int answer = sysui_msg(CELL_MSGDIALOG_TYPE_SE_TYPE_NORMAL | CELL_MSGDIALOG_TYPE_BUTTON_TYPE_YESNO, msg);
+        if (answer == CELL_MSGDIALOG_BUTTON_YES) break;
+        if (ps3_host_quitting()) { rc = CELL_CANCEL; break; }
+        if (sel >= 0)
+            list.focus = sel + (ls.has_new && !list.new_at_tail ? 1 : 0);
+        selected[0] = '\0';
+    }
+    free(items);
+
+    if (rc == CELL_OK && selected[0]) {
+        if (dir_num) setbuf_clear(buf_ea);
+        rc = savedata_execute(selected, is_save, setBuf, funcStat, funcFile,
+                              (void*)(uintptr_t)cb_userdata);
+    }
+
+done:
+    s_err_dialog = CELL_SAVEDATA_ERRDIALOG_NONE;
+    free(ls.fixed);
+    free(entries);
+    return rc;
+}
