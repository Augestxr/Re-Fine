+/* The system's own error screen for a callback error. Texts: ASSUMPTION, F does
+ * not reach it in any trace, and RPCS3's strings live outside cellSaveData.cpp. */
+static void savedata_error_dialog(s32 result)
+{
+    const char* msg = NULL;
+    switch (result) {
+    case CELL_SAVEDATA_CBRESULT_ERR_NOSPACE: msg = "There is not enough free space."; break;
+    case CELL_SAVEDATA_CBRESULT_ERR_FAILURE: msg = "The operation failed."; break;
+    case CELL_SAVEDATA_CBRESULT_ERR_BROKEN:  msg = "The saved data is corrupted."; break;
+    case CELL_SAVEDATA_CBRESULT_ERR_NODATA:  msg = "There is no saved data."; break;
+    case CELL_SAVEDATA_CBRESULT_ERR_INVALID: msg = "The data is invalid."; break;
+    default: return;
+    }
+    const s32 last = s_cb_error_shown;
+    s_cb_error_shown = result;
+    if (s_err_dialog == CELL_SAVEDATA_ERRDIALOG_NONE ||
+        (s_err_dialog == CELL_SAVEDATA_ERRDIALOG_NOREPEAT && result == last)) return;
+    sysui_msg(CELL_MSGDIALOG_TYPE_SE_TYPE_NORMAL | CELL_MSGDIALOG_TYPE_BUTTON_TYPE_OK, msg);
+}
 
