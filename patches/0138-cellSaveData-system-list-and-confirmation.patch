+/* --- List operations: the system's list, then its confirmation, then the work ---
+ * Order and results as RPCS3's savedata_op for SAVEDATA_OP_LIST_SAVE/LOAD. */
+
+typedef struct SaveEntry {
+    SysuiListItem item;
+    char dir[CELL_SAVEDATA_DIRNAME_SIZE];
+    char list_param[CELL_SAVEDATA_SYSP_LPARAM_SIZE];
+    char detail[CELL_SAVEDATA_SYSP_DETAIL_SIZE];
+    s64  mtime;
+} SaveEntry;
+
+static void save_entry_fill(SaveEntry* e, const char* dirName, const char* save_path)
+{
+    CellSaveDataSystemFileParam* param = calloc(1, sizeof *param);
+    if (param) {
+        read_param_sfo(save_path, param);
+        snprintf(e->item.title, sizeof e->item.title, "%s", param->title);
+        snprintf(e->item.subtitle, sizeof e->item.subtitle, "%s", param->subTitle);
+        snprintf(e->detail, sizeof e->detail, "%s", param->detail);
+        memcpy(e->list_param, param->listParam, sizeof e->list_param);
+        free(param);
+    }
+    snprintf(e->dir, sizeof e->dir, "%s", dirName);
+
+    HOST_STAT_T st;
+    if (HOST_STAT(save_path, &st) == 0) {
+#if defined(__APPLE__)
+        e->mtime = (s64)st.st_mtimespec.tv_sec;
+#elif defined(_WIN32)
+        e->mtime = (s64)st.st_mtime;
+#else
+        e->mtime = (s64)st.st_mtim.tv_sec;
+#endif
+    }
+    time_t t = (time_t)e->mtime;
+    const struct tm* tm = localtime(&t);
+    if (tm) strftime(e->item.date, sizeof e->item.date, "%a %b %d %H:%M:%S %Y", tm);
+
+    u64 size = 0;
+#ifdef _WIN32
+    char search[1100];
+    snprintf(search, sizeof search, "%s\\*", save_path);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(search, &fd);
+    if (h != INVALID_HANDLE_VALUE) {
+        do {
+            if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+                size += ((u64)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+        } while (FindNextFileA(h, &fd));
+        FindClose(h);
+    }
+#endif
+    /* Rounded up: 1.2 MB shows as 2 MB in RPCS3 (cancion_1). */
+    const u64 kb = (size + 1023) / 1024;
+    if (kb < 1024) snprintf(e->item.size, sizeof e->item.size, "%u KB", (unsigned)kb);
+    else           snprintf(e->item.size, sizeof e->item.size, "%u MB", (unsigned)((kb + 1023) / 1024));
+
+    snprintf(e->item.icon_path, sizeof e->item.icon_path, "%s/ICON0.PNG", save_path);
+    HOST_STAT_T ist;
+    if (HOST_STAT(e->item.icon_path, &ist) != 0) e->item.icon_path[0] = '\0';
+}
+
+static int s_sort_subtitle;
+
+static int save_entry_cmp(const void* pa, const void* pb)
+{
+    const SaveEntry* a = pa; const SaveEntry* b = pb;
+    const int by_time = a->mtime < b->mtime ? -1 : a->mtime > b->mtime ? 1 : 0;
+    const int by_sub = strcmp(a->item.subtitle, b->item.subtitle);
+    return s_sort_subtitle ? (by_sub ? by_sub : by_time) : (by_time ? by_time : by_sub);
+}
+
+/* Saves matching the prefix, up to `max`, sorted. A directory without a usable
+ * PARAM.SFO still counts in *dir_num, as the system counts it, and is not listed. */
+static SaveEntry* save_entries_read(const char* prefix, u32 max, u32 sort_type, u32 sort_order,
+                                    u32* dir_num, u32* count)
+{
+    *dir_num = *count = 0;
+    CellSaveDataDirList* dirs = calloc(max ? max : 1, sizeof *dirs);
+    SaveEntry* e = calloc(max ? max : 1, sizeof *e);
+    if (!dirs || !e) { free(dirs); free(e); return NULL; }
+    *dir_num = enumerate_save_dirs(prefix, dirs, max);
+    const u32 seen = *dir_num < max ? *dir_num : max;
+    for (u32 i = 0; i < seen; i++) {
+        char path[1024];
+        build_save_path(path, sizeof path, dirs[i].dirName);
+        if (!dir_has_save(path)) continue;
+        save_entry_fill(&e[*count], dirs[i].dirName, path);
+        (*count)++;
+    }
+    free(dirs);
+    s_sort_subtitle = sort_type == CELL_SAVEDATA_SORTTYPE_SUBTITLE;
+    qsort(e, *count, sizeof *e, save_entry_cmp);
+    if (sort_order != CELL_SAVEDATA_SORTORDER_ASCENT)
+        for (u32 i = 0, j = *count; i + 1 < j; i++) {
+            j--;
+            SaveEntry* t = malloc(sizeof *t);
+            if (!t) break;
+            memcpy(t, &e[i], sizeof *t); memcpy(&e[i], &e[j], sizeof *t); memcpy(&e[j], t, sizeof *t);
+            free(t);
+        }
+    return e;
+}
+
+/* The row the list opens on, as an index into the rows the user sees. */
+static int list_focus(const SaveListSet* ls, const SaveEntry* e, u32 count)
+{
+    int focus = count ? 0 : -1;
+    switch (ls->focus_pos) {
+    case CELL_SAVEDATA_FOCUSPOS_DIRNAME:
+        focus = -1;
+        for (u32 i = 0; i < count; i++)
+            if (!strcmp(e[i].dir, ls->focus_dir)) { focus = (int)i; break; }
+        break;
+    case CELL_SAVEDATA_FOCUSPOS_LISTTAIL:
+        focus = (int)count - 1;
+        break;
+    case CELL_SAVEDATA_FOCUSPOS_LATEST:
+    case CELL_SAVEDATA_FOCUSPOS_OLDEST:
+        focus = -1;
+        for (u32 i = 0; i < count; i++)
+            if (focus < 0 || (ls->focus_pos == CELL_SAVEDATA_FOCUSPOS_LATEST
+                              ? e[i].mtime > e[focus].mtime : e[i].mtime < e[focus].mtime))
+                focus = (int)i;
+        break;
+    case CELL_SAVEDATA_FOCUSPOS_NEWDATA:
+        return ls->new_pos == CELL_SAVEDATA_ICONPOS_TAIL ? (int)count : 0;
+    default:
+        break;
+    }
+    /* The new data row, when at the head, moves everything else down one. */
+    if (ls->has_new && ls->new_pos == CELL_SAVEDATA_ICONPOS_HEAD && focus >= 0) focus++;
+    return focus;
+}
