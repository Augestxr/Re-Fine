+static void confirm_text(char* out, size_t n, int is_save, const SaveEntry* e)
+{
+    /* "Load this data?" and the layout: cancion_1. The overwrite question is
+     * ASSUMPTION: no trace reaches it. */
+    snprintf(out, n, "%s\n\n%s\n%s\n%s\n%s\n\n%s",
+             is_save ? "Do you want to overwrite this data?" : "Load this data?",
+             e->item.title, e->item.subtitle, e->item.date, e->item.size, e->detail);
+}
