+/* Re:Fine 0121: SHADER_DUMP=<dir> writes every generated shader as it is compiled,
+ * to look at it and to time it again outside the game. */
+static void shader_dump(const char* kind, u32 id, const char* hlsl)
+{
+    static const char* dir = (const char*)1; static u32 n;
+    if (dir == (const char*)1) dir = getenv("SHADER_DUMP");
+    if (!dir) return;
+    char path[512]; snprintf(path, sizeof path, "%s/%s_%03u_%08X.hlsl", dir, kind, n++, id);
+    FILE* f = fopen(path, "wb");
+    if (f) { fwrite(hlsl, 1, strlen(hlsl), f); fclose(f); }
+}
