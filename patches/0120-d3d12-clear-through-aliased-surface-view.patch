+/* Re:Fine 0120: a clear through another view of the same bytes. F clears its
+ * bloom scratch 0x1F80000 as 512x144 A8R8G8B8 and draws it as 256x144 F16: 2048
+ * bytes a row both ways, one surface in guest memory. Taken for a new size, the
+ * resource went away six times a frame (PV600: 40719 times in 235 s, 21 s in
+ * all). A zero clear reads the same in either format, so it stays on the
+ * resource. Any other value is not the same bytes, and goes the usual way. */
+static u32 dxgi_bytes(u32 f)
+{
+    return f == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : f == DXGI_FORMAT_R32G32B32A32_FLOAT ? 16u : 4u;
+}
+
+static int off_rt_clear_view(const D3D12DrawRecord* dr)
+{
+    if (!dr->is_clear || dr->cc[0] || dr->cc[1] || dr->cc[2] || dr->cc[3]) return 0;
+    const int slot = off_rt_find(dr->rt_off);
+    if (slot < 0) return 0;
+    OffRT* r = &s_d3d.off_rt[slot];
+    const u32 want = (u32)rsx_surface_dxgi(dr->rt_fmt);
+    if (r->h != dr->rt_h || (r->w == dr->rt_w && r->dxgi == want) ||
+        r->w * dxgi_bytes(r->dxgi) != dr->rt_w * dxgi_bytes(want)) return 0;
+    r->used = 1;
+    return 1;
+}
+
