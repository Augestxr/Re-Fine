+static int  s_check_exists = 0;
+static int  s_check_created = 0;
 
 static void ensure_dirs(const char* path)
 {
@@ -378,52 +384,48 @@ s32 cellGameBootCheck(u32* type, u32* attributes, CellGameContentSize* size,
