--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -4291,15 +4291,42 @@ static struct {
     struct { long seq, ticks; float alpha; u8 tick; } ring[IX_RING];
     float lag;               /* frames between a guest frame and its draws here, measured at each new state */
     int *g_tab, *g_first, *g_list, *g_gid, *g_seen, *g_bg, *g_br, *g_cnt, *g_nxt, *g_ctab; u8* used; u32 g_cap, g_tab_n;   /* pairing scratch */
+    int only_dump;           /* 0197: this batch is kept for REFINE_DRAW_DUMP, not blended */
     int trk, traced;         /* REFINE_INTERP_LOG=2: one moving draw (its index in b) followed frame by frame */
     /* REFINE_INTERP_LOG, per second */
     double t0, cost, part[6]; u32 frames, states, batches, draws, found, moving, blended, paired, jumped, big, untimed;
     u32 slot[16], creg_draws, fp_draws;
 } s_ix;
 
+/* Re:Fine 0197, diagnostic only: REFINE_DRAW_DUMP=<file>:<from s>-<to s> (seconds since the process started)
+ * writes, for every draw of every batch in that window, what it moves: its vertex-program constants and up to six
+ * of its vertices. tools/draw_census.py finds in it what only moves on the 30 Hz ticks. */
+static struct { int state; FILE* f; double from, to, t0; } s_dd;
+static int dd_want(void)
+{
+    if (s_dd.state == 0) {
+        const char* e = getenv("REFINE_DRAW_DUMP");
+        const char* c = e ? strrchr(e, ':') : NULL;
+        s_dd.state = -1;
+        if (c && sscanf(c + 1, "%lf-%lf", &s_dd.from, &s_dd.to) == 2) {
+            char path[512];
+            snprintf(path, sizeof path, "%.*s", (int)(c - e), e);
+            s_dd.f = fopen(path, "wb");
+            s_dd.t0 = (double)GetTickCount64() * 1e-3;
+            if (s_dd.f) { setvbuf(s_dd.f, NULL, _IOFBF, 64u << 20); s_dd.state = 1; }
+        }
+    }
+    if (s_dd.state < 1) return 0;
+    const double t = (double)GetTickCount64() * 1e-3 - s_dd.t0;
+    if (t > s_dd.to) { fclose(s_dd.f); s_dd.state = -1; fprintf(stderr, "[draw-dump] done%c", 10); return 0; }
+    return t >= s_dd.from;
+}
