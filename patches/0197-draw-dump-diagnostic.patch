+    s_ix.only_dump = !menus;
     if (want && !s_ix.w_vb) {
         const char* e = getenv("REFINE_INTERP_LOG");
         s_ix.log = e ? (*e == '2' ? 2 : 1) : -1; s_ix.trk = -1; s_ix.lag = 1.0f;
@@ -4941,10 +4968,52 @@ static void ix_apply_body(void)
     if (s_ix.log > 0) { s_ix.draws += n; s_ix.found += found; s_ix.moving += moving; s_ix.blended += blended; }
 }
 
+static void dd_batch(void)
+{
+    const u32 n = s_d3d.draw_count < MAX_DRAWS ? s_d3d.draw_count : MAX_DRAWS;
+    const u32 vbytes = s_d3d.vp_vb_offset;
+    LARGE_INTEGER c, q; QueryPerformanceCounter(&c); QueryPerformanceFrequency(&q);
+    struct { u32 magic, n, nblk, present; long seq, tick; float alpha; u32 pad; double t; } h =
+        { 0x46444444u, 0, s_ix.nblk, (u32)s_present_this_frame, g_port_draw_seq, g_port_draw_tick, g_port_draw_alpha, 0,
+          (double)c.QuadPart / (double)q.QuadPart };
+    static IxSig sig;
+    for (u32 d = 0; d < n; d++) if (s_d3d.draws[d].is_vp && !s_d3d.draws[d].is_clear) h.n++;
+    fwrite(&h, sizeof h, 1, s_dd.f);
+    for (u32 b = 0; b < s_ix.nblk; b++) {              /* each block: the registers that differ from the one before */
+        const float* x = s_ix.w_cb + (u64)b * IX_CBF;
+        u32 m = 0; static u16 idx[RSX_MAX_VERTEX_CONSTANTS];
+        for (u32 r = 0; r < RSX_MAX_VERTEX_CONSTANTS; r++)
+            if (!b || memcmp(x + r * 4, x - IX_CBF + r * 4, 16)) idx[m++] = (u16)r;
+        fwrite(&m, 4, 1, s_dd.f); fwrite(idx, 2, m, s_dd.f);
+        for (u32 k = 0; k < m; k++) fwrite(x + (u32)idx[k] * 4, 16, 1, s_dd.f);
+    }
+    for (u32 d = 0; d < n; d++) {
+        const D3D12DrawRecord* dr = &s_d3d.draws[d];
+        if (!dr->is_vp || dr->is_clear) continue;
+        ix_sig(dr, d, vbytes, &sig);
+        struct { u64 call; u32 fp, vs, nv, tex, rt, blk; u16 am, vpw; u32 blend; float v[6][8]; } o;
+        memset(&o, 0, sizeof o);
+        o.call = s_ix.w_call[d]; o.fp = dr->fp_addr; o.vs = (u32)dr->vs_idx; o.nv = dr->vertex_count;
+        o.tex = dr->tex_mask & 1u ? dr->tex[0].raw : 0; o.rt = dr->rt_off; o.blk = s_ix.w_cbk[d];
+        o.am = s_ix.w_am[d]; o.vpw = (u16)dr->vp_w; o.blend = dr->blend & 1u;
+        if (sig.vn) for (u32 k = 0; k < 6 && dr->vertex_count; k++) {
+            const u8* p = s_ix.w_vb + sig.vo + (u64)(dr->vertex_count - 1) * k / 5 * IX_VSTRIDE;
+            memcpy(o.v[k], p, 16); memcpy(o.v[k] + 4, p + 8 * 16, 16);
+        }
+        fwrite(&o, sizeof o, 1, s_dd.f);
+    }
+}
+
 static void ix_apply(void)
 {
     if (!s_ix.on) return;
     s_ix.on = 0;
+    if (dd_want()) dd_batch();
+    if (s_ix.only_dump) {
+        memcpy((u8*)s_d3d.vp_vb_mapped + (u64)s_d3d.vp_parity * MAX_VERTICES * IX_VSTRIDE, s_ix.w_vb, s_d3d.vp_vb_offset);
+        s_ix.nblk = 0;
+        return;
+    }
     if (s_ix.log <= 0) { ix_apply_body(); s_ix.nblk = 0; return; }
     LARGE_INTEGER a, b, f; QueryPerformanceCounter(&a);
     ix_apply_body();
