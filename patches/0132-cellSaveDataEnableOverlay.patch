+ * operation of its reads it back; here there is no system overlay to turn on or off either. */
+static int s_savedata_overlay;
+
+static void hle_cellSaveDataEnableOverlay(ppu_context* ctx)
+{
+    s_savedata_overlay = (s32)ctx->gpr[3] != 0;
+}
