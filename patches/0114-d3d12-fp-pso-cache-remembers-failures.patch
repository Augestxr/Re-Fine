+/* Re:Fine 0114: a program that cannot become a pipeline is reported once, by its
+ * microcode hash, with the stage and the HRESULT. Its failure stays in the
+ * cache below, so nothing here runs per draw. */
+static void vp_fp_fail_once(u32 fp_addr, u32 uhash, const char* stage, HRESULT hr, const char* detail)
+{
+    static u32 seen[VP_FP_CACHE];
+    static int n = 0, full = 0;
+    for (int i = 0; i < n; i++) if (seen[i] == uhash) return;
+    if (n == VP_FP_CACHE) {
+        if (!full) { full = 1; fprintf(stderr, "[FP] FAIL log full: later programs not named\n"); fflush(stderr); }
+        return;
+    }
+    seen[n++] = uhash;
+    fprintf(stderr, "[FP] FAIL %s fp=0x%08X ucode=0x%08X hr=0x%08lX%s%s\n", stage, fp_addr, uhash,
+            (unsigned long)hr, detail ? " " : "", detail ? detail : "");
+    fflush(stderr);
+}
