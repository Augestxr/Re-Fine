diff --git a/libs/video/rsx_fp_fail_table.h b/libs/video/rsx_fp_fail_table.h
new file mode 100644
index 00000000..e999e93a
--- /dev/null
+++ b/libs/video/rsx_fp_fail_table.h
@@ -0,0 +1,61 @@
+#ifndef PS3RECOMP_RSX_FP_FAIL_TABLE_H
+#define PS3RECOMP_RSX_FP_FAIL_TABLE_H
+
+/* Re:Fine 0116: pipelines that could not be built, kept apart from the PSO cache.
+ * That cache is a FIFO of 256 and its key carries vp_gen, so a failure stored
+ * there can be forgotten and compiled again. Here nothing is ever evicted and
+ * the key has no generation. A full table says so in dropped; what it holds
+ * stays. Open addressing, touched only after a PSO cache miss. */
+
+#include <stdint.h>
+#include <string.h>
+
+typedef struct {
+    uint32_t ucode_hash, vs_hash, blend, nrt, rtfmt, ctrl, cmask, cull, cube_mask;
+    uint32_t pad;   /* compared with memcmp: stays 0 */
+    uint64_t zs;
+} rsx_fp_fail_key;
+
+#define RSX_FP_FAIL_SLOTS 4096u  /* power of two */
+
+typedef struct {
+    rsx_fp_fail_key key[RSX_FP_FAIL_SLOTS];
+    uint8_t         used[RSX_FP_FAIL_SLOTS];
+    uint32_t        count;    /* distinct failures held */
+    uint32_t        dropped;  /* failures that did not fit */
+    uint64_t        hits;     /* compiles avoided */
+} rsx_fp_fail_table;
+
+static inline uint32_t rsx_fp_fail_slot(const rsx_fp_fail_key* k)
+{
+    const uint8_t* p = (const uint8_t*)k;
+    uint32_t h = 2166136261u;
+    for (size_t i = 0; i < sizeof *k; i++) { h ^= p[i]; h *= 16777619u; }
+    return h & (RSX_FP_FAIL_SLOTS - 1u);
+}
+
+static inline int rsx_fp_fail_find(const rsx_fp_fail_table* t, const rsx_fp_fail_key* k)
+{
+    if (!t->count) return 0;
+    for (uint32_t i = rsx_fp_fail_slot(k), n = 0; n < RSX_FP_FAIL_SLOTS;
+         i = (i + 1u) & (RSX_FP_FAIL_SLOTS - 1u), n++) {
+        if (!t->used[i]) return 0;
+        if (!memcmp(&t->key[i], k, sizeof *k)) return 1;
+    }
+    return 0;
+}
+
+/* 1 = added, 0 = already there, -1 = no room (counted in dropped). */
+static inline int rsx_fp_fail_add(rsx_fp_fail_table* t, const rsx_fp_fail_key* k)
+{
+    if (rsx_fp_fail_find(t, k)) return 0;
+    if (t->count == RSX_FP_FAIL_SLOTS) { t->dropped++; return -1; }
+    uint32_t i = rsx_fp_fail_slot(k);
+    while (t->used[i]) i = (i + 1u) & (RSX_FP_FAIL_SLOTS - 1u);
+    t->used[i] = 1;
+    t->key[i] = *k;
+    t->count++;
+    return 1;
+}
+
+#endif
diff --git a/libs/video/tests/test_fp_fail_table.c b/libs/video/tests/test_fp_fail_table.c
new file mode 100644
index 00000000..b128c1b2
--- /dev/null
+++ b/libs/video/tests/test_fp_fail_table.c
@@ -0,0 +1,36 @@
+/* Re:Fine 0116: a failed pipeline is not forgotten, whatever else goes through. */
+#include <stdio.h>
+#include "../rsx_fp_fail_table.h"
+
+static rsx_fp_fail_table t;
+
+static rsx_fp_fail_key key(uint32_t n)
+{
+    rsx_fp_fail_key k;
+    memset(&k, 0, sizeof k);
+    k.ucode_hash = n * 2654435761u;
+    k.blend = n;
+    k.zs = (uint64_t)n << 32;
+    return k;
+}
+
+#define CHECK(c) do { if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); return 1; } } while (0)
+
+int main(void)
+{
+    /* The five programs of the PV600 fail first. */
+    for (uint32_t i = 1; i <= 5; i++) { rsx_fp_fail_key k = key(i); CHECK(rsx_fp_fail_add(&t, &k) == 1); }
+    /* Asking again adds nothing. */
+    { rsx_fp_fail_key k = key(3); CHECK(rsx_fp_fail_add(&t, &k) == 0); CHECK(t.count == 5); }
+    /* Far more than the 256 entries of the PSO cache come after them. */
+    for (uint32_t i = 1000; i < 1000 + 3000; i++) { rsx_fp_fail_key k = key(i); CHECK(rsx_fp_fail_add(&t, &k) == 1); }
+    for (uint32_t i = 1; i <= 5; i++) { rsx_fp_fail_key k = key(i); CHECK(rsx_fp_fail_find(&t, &k)); }
+    /* A key field that differs is another pipeline. */
+    { rsx_fp_fail_key k = key(1); k.cmask = 7; CHECK(!rsx_fp_fail_find(&t, &k)); }
+    /* Filling the table loses nothing that it held and says what did not fit. */
+    for (uint32_t i = 100000; t.count < RSX_FP_FAIL_SLOTS; i++) { rsx_fp_fail_key k = key(i); CHECK(rsx_fp_fail_add(&t, &k) == 1); }
+    { rsx_fp_fail_key k = key(9000000); CHECK(rsx_fp_fail_add(&t, &k) == -1); CHECK(t.dropped == 1); CHECK(!rsx_fp_fail_find(&t, &k)); }
+    for (uint32_t i = 1; i <= 5; i++) { rsx_fp_fail_key k = key(i); CHECK(rsx_fp_fail_find(&t, &k)); }
+    printf("test_fp_fail_table: OK (%u entries, %u dropped)\n", t.count, t.dropped);
+    return 0;
+}
