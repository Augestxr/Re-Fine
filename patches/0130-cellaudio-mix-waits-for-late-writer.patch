+/* Re:Fine 0130: a block is marked when it is consumed, so the mixer can tell a block
+ * the title has not reached from one it filled with silence. Same idea as RPCS3's
+ * port tags (cellAudio.cpp, behaviour only): negative zero in a few samples of the
+ * front channels, inaudible, and gone once the title writes the block. */
+#define AUDIO_TAG_BE 0x00000080u      /* -0.0f as big-endian bytes, read as LE */
+#define AUDIO_TAGS 4u
+
+static u32 audio_tag_pos(u32 i, u32 nch)
+{
+    return (i * CELL_AUDIO_BLOCK_SAMPLES / AUDIO_TAGS + CELL_AUDIO_BLOCK_SAMPLES / 8u) * nch;
+}
+
+/* Running ports, and how many have every tag of their next block in place
+ * (untouched) or only some (the title is writing it right now). */
+static int audio_ports_next_block(int* untouched, int* partial)
+{
+    int active = 0;
+    *untouched = *partial = 0;
+    mutex_lock(&s_audio_mutex);
+    for (int p = 0; p < CELL_AUDIO_PORT_MAX; p++) {
+        const AudioPortSlot* port = &s_ports[p];
+        if (!port->in_use || !port->running || !port->buffer || !port->tagged) continue;
+        const u32 nch = (u32)port->param.nChannel;
+        const u32 at = (u32)(port->read_index % (u32)port->param.nBlock) * CELL_AUDIO_BLOCK_SAMPLES * nch;
+        const u32* w = (const u32*)(port->buffer + at);
+        u32 left = 0;
+        for (u32 i = 0; i < AUDIO_TAGS; i++) left += w[audio_tag_pos(i, nch)] == AUDIO_TAG_BE;
+        active++;
+        if (left == AUDIO_TAGS) ++*untouched;
+        else if (left) ++*partial;
+    }
+    mutex_unlock(&s_audio_mutex);
+    return active;
+}
